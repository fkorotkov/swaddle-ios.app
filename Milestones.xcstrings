    "cdc-15-tries_say": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحاولون قول كلمة أو كلمتين بخلاف “ماما” أو “بابا”، مثل “كو” عندما يريدون قول “كرة” أو “كا” عندما يريدون قول “كلب”."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tries to say one or two words besides “mama” or “dada,” like “ba” for ball or “da” for dog"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trata de decir una o dos palabras, además de “mamá” o “papá”, como “ota” (por “pelota”) o “ito” (por “perrito”)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش برای ادا کردن یک تا دو کلمه علاوه بر \"ماما\" یا \"بابا\"، مانند \"به به\" برای غذا یا \"دا\" برای داداش"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusubukang sabihin ang isa o dalawang salita bukod sa \"mama\" o “dada,” tulad ng “ba” para sa ball o “da” para sa dog (aso)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaye de dire un ou deux mots en plus de « maman » ou « papa », comme « ba » pour « balle » ou « ch » pour chien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"मम्मा\" या \"बब्बा\" के अलावा एक या दो शब्द कहने की कोशिश करता है, जैसे गेंद के लिए \"बो\" या कुत्ते के लिए \"डो\""
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseye di youn oubyen de mo apa “mama” oswa “papa,” tankou “ba” pou ball (boul) oswa “da” pou dog (chyen)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공의 \"고\" 또는 멍멍이의 “멍”과 같이 “마마”나 “빠빠” 이외의 한두 단어 말하기를 시도한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta dizer uma ou duas palavras além de “mama” ou “dada”, como “ba” para bola ou “ca” para cachorro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пытается произнести одно-два слова, кроме «мама» и «папа», например «мя» вместо «мяч» или «со» вместо «собака»"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu isku dayaa inuu yiraahdo hal ama laba kelmadood oo aan ka ahayn \"hooyo\" ama \"aabe,\" sida \"ba\" oo ah kubbad ama \"da\" oo ah eey"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cố nói một hoặc hai từ ngoài “mama” hoặc “dada”, như “ba” để chỉ “bóng” (ball) hay “da” để chỉ “chó” (dog)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除了“妈妈”或“爸爸”之外，还尝试说一两个词，比如说 “抱抱”或“狗狗”"
          }
        }
      }
    },
    "cdc-15-tries_use": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحاول استخدام الأشياء بالطريقة الصحيحة، كالهاتف أو الكوب أو الكتاب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tries to use things the right way, like a phone, cup, or book"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trata de usar las cosas de la manera correcta, como un teléfono, una taza o un libro"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش برای استفاده درست از اشیا، مانند تلفن، فنجان، یا کتاب"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusubukang gamitin ang mga bagay sa tamang paraan, tulad ng telepono, tasa, o libro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie d’utiliser les choses de la bonne manière, comme un téléphone, une tasse ou un livre"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चीजों को सही तरीके से इस्तेमाल करने की कोशिश करता है, जैसे फोन, कप या किताब"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseye sèvi ak bagay nan bon fason an, tankou yon telefòn, goblè, oswa liv"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화, 컵 또는 책 등의 물건을 올바른 방식으로 사용하려고 노력한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta usar as coisas da maneira certa, como um telefone, um copo ou um livro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пытается использовать предметы по назначению, например телефон, чашку или книгу"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu isku dayaa inuu wax u isticmaalo sida saxda ah, sida takalefoon, koobka, ama buuga"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cố sử dụng mọi thứ đúng cách, như điện thoại, cốc hoặc sách"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试以正确的方式使用东西，如电话、杯子或书"
          }
        }
      }
    },
    "cdc-15-uses_fingers": {
