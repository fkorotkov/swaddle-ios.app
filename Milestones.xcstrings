{
  "sourceLanguage": "en",
  "strings": {
    "cdc-12-bye_bye": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلوح بيده مودعا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waves “bye-bye”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice “adiós” con la mano"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تکان دادن دست به نشانه \"بای-بای\""
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumakaway ng \"bye-bye\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites « au revoir » de la main"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथ हिलाकर \"बाय-बाय\" करता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Voye men pou fè “babay”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"안녕\"하며 손을 흔든다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz “tchau tchau” com as mãos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машет рукой на прощание"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu ku gacan haadiyaa \"macsalaamo-macsalaamo\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫy tay chào tạm biệt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挥手“拜拜”"
          }
        }
      }
    },
    "cdc-12-calls_parent": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعو أحد والديه “ماما” أو “بابا” أو غير ذلك من الأسماء الخاصة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls a parent “mama” or “dada” or another special name"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llama a sus padres “mamá” o “papá”, o con algún otro nombre especial"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\"مامان\" یا \"بابا\" گفتن به والدین یا دادن نامهای خاص دیگر به آنها"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinatawag ang magulang na “mama” o “dada” o iba pang espesyal na pangalan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appelle un parent « maman » ou « papa », ou par tout autre nom particulier"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माता-पिता को \"मम्मा\" या \"बब्बा\" या किसी अन्य विशेष नाम से पुकारता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Rele yon paran “mama” oswa “papa” oswa yon lòt non espesyal"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부모를 “마마” 또는 “빠빠” 또는 다른 특별한 이름으로 부른다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chama os pais de “mama” ou “papa” ou outro nome especial"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Называет родителя «мама», «папа» или другим особым словом"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu ugu yeeraa waalidka \"hooyo\" ama \"aabe\" ama magac kale oo gaar ah"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gọi mẹ hoặc bố là “mama” hoặc “dada” hoặc một tên gọi đặc biệt khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叫“妈妈”或“爸爸”或其他称呼"
          }
        }
      }
    },
    "cdc-12-drinks_cup": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشرب من كوب تحمليه له من دون غطاء"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drinks from a cup without a lid, as you hold it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe de una taza sin tapa, mientras usted la sujeta"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوشیدن مایعات از فنجان بدون درپوش، در حالی که شما آن را نگه داشته اید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Umiinom mula sa isang tasa na walang takip, habang hawak mo ito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boit dans une tasse sans couvercle, pendant que vous la tenez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके हाथ से पकड़े हुए बिना ढक्कन वाले प्याले से पीता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Bwè nan yon goblè san kouvèti, pandan ou kenbe goblè a"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컵을 잡아 주면 뚜껑이 없는 컵에 있는물을 마신다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe de um copo sem tampa, enquanto você o segura"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пьёт из чашки без крышки, которую вы держите"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu wax ku cabaa koob aan dabool lahayn, markaad u qabato"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống từ cốc không có nắp do quý vị cầm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用没有盖子的杯子喝水（由您拿着杯子）"
          }
        }
      }
    },
    "cdc-12-looks_things": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث عن الأشياء التي يراك تخبئيها، كاللعبة التي تخبئيها تحت لحاف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks for things he sees you hide, like a toy under a blanket"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca las cosas cuando ve que usted las esconde (como un juguete debajo de una manta)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جستجو برای یافتن چیزهایی که شما پنهان می کنید، مانند اسباب بازی زیر پتو"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "mga bagay na nakita niyang itinago mo, gaya ng laruan sa ilalim ng kumot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche des choses qu’il vous voit cacher, comme un jouet sous une couverture"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन चीजों की तलाश करता है जिन्हें वह आपको छिपाता हुआ देखता है, जैसे कि आप कंबल के नीचे एक खिलौने को छिपाते हैं"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Chèche bagay li te wè ou kache, pa egzanp yon jwèt anba yon dra"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "담요 밑의 장난감을 찾듯이 귀하가 숨기는 것을 찾는다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura coisas que ele vê você esconder, como um brinquedo debaixo de um cobertor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет вещи, которые вы спрятали у него на глазах, например игрушку под одеялом"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu raadiyaa waxyaabo uu ku arko adigoo qarinaya, sida boombalada buste hoostiisa galisay"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm thứ mà bé thấy quý vị giấu đi, như đồ chơi bên dưới chăn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "寻找他看到您藏起来的东西，比如毯子下面的玩具"
          }
        }
      }
    },
    "cdc-12-picks_things": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسك الأشياء بين الإبهام والسبابة مثل قطع الطعام الصغيرة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks things up between thumb and pointer finger, like small bits of food"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta cosas entre el dedo índice y el pulgar, como trozos pequeños de comida"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نگه داشتن چیزهایی مانند مواد غذایی بین انگشتان شست و اشاره"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinupulot ang mga bagay sa pagitan ng hinlalaki at hintuturo, tulad ng maliliit na piraso ng pagkain"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramasse des objets entre le pouce et l’index, comme de petits morceaux de nourriture"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंगूठे और तर्जनी के बीच चीजों को उठाता है, जैसे भोजन के छोटे टुकड़े"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranmase bagay ant gwo pous ak dwèt endèks, tankou ti moso manje"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 음식 조각 같은 물건을 엄지와 검지를 써서 집는다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega coisas entre o polegar e o dedo indicador, como pequenos pedaços de comida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Берёт предметы большим и указательным пальцами, например маленькие кусочки еды"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay shayaalka ku soo qaadaa suulka iyo farta tilmaanta dhexdooda, sida cuntooyin yaryar ee jabka ah"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng ngón cái và ngón trỏ nhặt đồ vật lên, như một mẩu thức ăn nhỏ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用拇指和食指捡起东西，如小块的食物"
          }
        }
      }
    },
    "cdc-12-plays_games": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلعب معك ألعابا مثل التصفيق معا على ألحان أغنية"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays games with you, like pat-a-cake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega con usted, como a dar palmaditas con las manos (“pat-a-cake”)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازی کردن با شما، مانند دالی موشک"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakikipaglaro sa iyo, tulad ng pat-a-cake"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue à des jeux avec vous, comme Savez-vous planter les choux"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके साथ गेम खेलता है, जैसे गाने की धुन पर आपस में ताली बजाना या घुघुआ मन्ना जैसे खेल"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Jwe jwèt avèk ou, tankou pat-a-cake (fè bat men ak chante timoun)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짝짜꿍과 같은 게임을 함께 한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz brincadeiras com você, como bater palminhas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играет с вами, например в ладушки"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu kula ciyaaraa ciyaaraha, sida pat-a-cake"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi trò chơi với quý vị, như trò đập tay (pat-a-cake)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和您一起玩游戏，比如拍手游戏"
          }
        }
      }
    },
    "cdc-12-pulls_up": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتشبث بسطح مرتفع ويجذب نفسه للنهوض"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulls up to stand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jala algo para ponerse de pie"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش برای ایستادن"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humihila pataas para tumayo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se redresse pour se tenir debout"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खड़े होने के लिए खुद को ऊपर की ओर खींचता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Rale monte pou l kanpe"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물건을 잡고 일어선다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxa para ficar de pé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встаёт, подтягиваясь за опору"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wax ayuu soo jiidaa si uu u istaago"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để đứng lên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扶东西站起来"
          }
        }
      }
    },
    "cdc-12-puts_something": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع الأشياء في وعاء، كوضع مكعب في كوب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts something in a container, like a block in a cup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone algo en un recipiente, como un bloque de juguete dentro de una taza"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گذاشتن اشیا درون ظرف (مثلا بلوک اسباب بازی درون فنجان)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maglagay ng isang bagay sa isang lalagyan, tulad ng isang bloke sa isang tasa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met quelque chose dans un récipient, comme un cube dans une tasse"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंटेनर में कुछ डालता है, जैसे एक कप में एक ब्लॉक"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Mete yon bagay nan yon veso, pa egzanp yon blòk nan yon goblè"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컵 안에 블록을 넣듯이 용기에 무엇인가를 넣는다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca algo em um recipiente, como um bloco em um copo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладёт предмет в ёмкость, например кубик в чашку"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu wax ku ridaa weel, sida bulkeeti yar inuu koob ku rido"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho thứ gì đó vào đồ đựng, như cho một khối lắp ghép vào trong cốc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将东西放在容器里，比如将积木放入杯子"
          }
        }
      }
    },
    "cdc-12-understands_no": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفهم كلمة “لا” (يتوقف لوهلة قصيرة أو يتوقف عما يفعله عندما تقوليها)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understands “no” (pauses briefly or stops when you say it)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiende la palabra “no” (hace una pausa breve o se detiene cuando usted la dice)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهمیدن مفهوم \"نه\" (پس از شنیدن آن، کمی درنگ یا توقف می کند)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauunawaan ang \"hindi\" (humihinto o saglit na paghinto kapag sinabi mo ito)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprend « non » (s’arrête brièvement ou s’arrête lorsque vous le dites)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ना\" को समझता है (आपके कहने पर थोड़ा रुकता है या बिलकुल रुक जाता है)"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Konprann “non” (fè yon poze kout oswa sispann lè ou di sa)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"안돼\"를 이해한다(안된다고 말하면 잠시 멈추거나 중단함)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entende “não” (pausa brevemente ou para quando você diz isso)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понимает «нет»: ненадолго замирает или останавливается, когда вы это говорите"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu fahmaya \"maya\" (si kooban ayuu u hakadaa ama wuu joogsada markaad tiraahdo)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiểu khi bị từ chối (tạm dừng hoặc dừng lại khi quý vị nói “không”)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "理解“不可以”（您说不的时候应短暂停顿或停下）"
          }
        }
      }
    },
    "cdc-12-walks_holding": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمشي مستندا إلى الأثاث"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walks, holding on to furniture"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camina apoyándose en los muebles"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راه رفتن، با کمک گرفتن از وسایل منزل"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naglalakad, habang humahawak sa mga kasangkapan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marche en se tenant aux meubles"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फर्नीचर को पकड़े हुए चलता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache, pandan li kenbe mèb"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가구를 잡고 걷는다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda, segurando nos móveis"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходит, держась за мебель"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu ku socdaa, qabsadaa alaabta guriga"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bám vào đồ đạc để đi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扶着家具走路"
          }
        }
      }
    },
    "cdc-15-claps_excited": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصفقون عندما يشعرون بالحماس"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claps when excited"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplaude cuando se emociona"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کف زدن هنگام هیجان‌زده شدن"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumapalakpak kapag nasasabik"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applaudit quand il est enthousiasmé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्साहित होने पर ताली बजाता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Bat bravo lè li kontan anpil"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신날 때 손뼉을 친다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bate palmas quando está excitado"
          }
