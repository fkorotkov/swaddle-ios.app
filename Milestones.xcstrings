    "cdc-24-holds_something": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسك غرضا بإحدى يديه وهو يستخدم يده الأخرى، مثل إمساك وعاء وفك غطائها"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds something in one hand while using the other hand; for example, holding a container and taking the lid off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostiene algo en una mano mientras usa la otra; por ejemplo, sostiene un recipiente mientras le quita la tapa"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نگه داشتن شیئی در یک دست و استفاده همزمان از دست دیگر؛ مثلا، نگه داشتن یک ظرف و برداشتن درپوش آن"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humahawak ng isang bagay sa isang kamay habang ginagamit ang kabilang kamay; halimbawa, may hawak na lalagyan at tinatanggal ang takip"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tient quelque chose d’une main tout en se servant de l’autre, par exemple, tenir un contenant et enlever le couvercle"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे हाथ का उपयोग करते समय एक हाथ में कुछ पकड़ता है; उदाहरण के लिए, कंटेनर को पकड़कर ढक्कन खोलना"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenbe yon bagay nan yon men pandan l ap itilize lòt men an; pa egzanp, kenbe yon veso epi retire kouvèti a"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손을 사용하는 동안 다른 한 손으로 무엇인가를 잡는다. 예: 용기를 잡고 뚜껑 열기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segura algo em uma mão enquanto usa a outra; por exemplo, segurando um recipiente e tirando a tampa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держит предмет одной рукой и действует другой: например, держит ёмкость и снимает с неё крышку"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxa uu ku hayaa gacanta hal gacan isagoo isticmaalaya gacanta kale; tusaale ahaan, haynta weel oo furka ka qaad"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ thứ gì đó bằng một tay trong khi dùng tay còn lại; ví dụ: giữ đồ đựng và mở nắp ra"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一只手拿东西的同时用另一只手；比如，一只手拿着一个容器，另一只手把盖子打开"
          }
        }
      }
    },
