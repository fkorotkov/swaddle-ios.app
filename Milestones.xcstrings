            "value": "Empile au moins deux petits objets, comme des cubes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम दो छोटी वस्तुओं को एक के ऊपर एक रखता है, जैसे कि ब्लॉक"
          }
        },
        "ht": {
