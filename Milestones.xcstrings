    "cdc-9-smiles_laughs": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبتسم أو يضحك عندما تلعبين الغميضة معه"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smiles or laughs when you play peek-a-boo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonríe o se ríe cuando usted juega a “¿Dónde está el bebé? ¡Aquí está!” (peek-a-boo)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لبخند زدن یا خندیدن هنگام بازی دالی موشک"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngumingiti o tumatawa kapag naglalaro kayo ng peek-a-boo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sourit ou rit lorsque vous jouez à cache-cache"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप छिपकर उसकी ओर देखने का खेल खेलते हैं तो मुस्कुराता या हंसता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Souri oswa ri lè ou jwe peek-a-boo (kache figi, epi dekouvri figi)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "까꿍놀이를 할 때 미소를 짓거나 웃는다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorri ou ri quando você brinca de esconde-esconde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улыбается или смеётся, когда вы играете в «ку-ку»"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Dhoola cadeeyaa ama qoslaa marka aad ciyaareyso peek- a-boo"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỉm cười hoặc cười lớn khi quý vị chơi ú òa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玩躲猫猫时会笑或大笑"
          }
        }
      }
    },
    "cdc-9-uses_fingers": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
