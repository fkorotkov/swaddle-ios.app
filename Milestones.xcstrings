        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변에 낯선 사람이 있으면 수줍어하거나, (귀하에게) 달라붙어 있거나, 두려워한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
