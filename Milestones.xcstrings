    "cdc-18-moves_away": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحرك بعيدا عنك، ولكنه ينظر إليك للتأكد من أنك بالقرب منه"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves away from you, but looks to make sure you are close by"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aleja de usted, pero lo busca para asegurarse de que está cerca"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دور شدن از شما، ولی نگاه کردن به شما برای مطمئن شدن از این که نزدیکش هستید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalayo sa iyo, ngunit tumitingin upang masigurado na nasa malapit ka"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’éloigne de vous mais regarde pour s’assurer que vous êtes à proximité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपसे दूर जाता है, लेकिन यह सुनिश्चित करता है कि आप करीब हैं"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Deplase lwen ou, men ap gade pou asire ke ou toupre"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대에게서 한 발짝 물러나지만 상대가 가까이 있는지 확인한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afasta-se de você, mas procura ter certeza de que está por perto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отходит от вас, но оглядывается, чтобы убедиться, что вы рядом"
          }
        },
