          "stringUnit": {
            "state": "translated",
            "value": "अजनबियों के आसपास शर्मीला है, चिपक जाता है या भयभीत होता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Li timid, kolan, oswa pè lè li bòkote etranje"
