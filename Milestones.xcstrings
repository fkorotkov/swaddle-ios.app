    "cdc-24-says_words": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقول كلمتين متصلتين على الأقل، مثل “حليب أكثر”."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says at least two words together, like “More milk.”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice al menos dos palabras juntas, como “más leche”"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتن حداقل دو واژه در کنار هم، مثلا \"شیر بیشتر.\""
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagsasabi ng hinidi bababa sa dalawang salita nang magkasama, tulad ng \"Gatas pa.\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit au moins deux mots ensemble, comme « Plus de lait »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम दो शब्द एक साथ कहता है, जैसे \"ज्यादा दूध।\""
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Di omwen de mo ansanm, pa egzanp “Plis lèt.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“우유 더”와 같이 적어도 두 단어를 함께 말한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz pelo menos duas palavras juntas, como “Mais leite”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединяет хотя бы два слова, например «Ещё молока»"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay dhahaan ugu yaraan laba kelmadood, sida \"caano badan.\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói được ít nhất hai từ liền nhau, như “Thêm sữa”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少连说两个词，如“更多牛奶”"
          }
        }
      }
    },
    "cdc-24-tries_switches": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحاول استخدام مفاتيح لعبة أو مقابضها أو أزرارها"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tries to use switches, knobs, or buttons on a toy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta usar las manijas o botones de los juguetes"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش برای استفاده از سوییچ، دکمه پیچی یا دکمه فشاری اسباب بازی"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusubukang gumamit ng mga switch, knob, o pindutan sa isang laruan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaye d’utiliser des interrupteurs, des boutons de porte ou des boutons sur un jouet"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खिलौने की स्विच, नॉब या बटन का उपयोग करने की कोशिश करता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseye itilize switch, manch, oswa bouton sou yon jwèt"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장난감의 스위치, 손잡이 또는 버튼을 사용하려 시도한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta usar interruptores e botões em um brinquedo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пытается пользоваться переключателями, ручками или кнопками на игрушке"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay isku daydaa in ay isticmaasho furayaasha, handaraafyada, ama badhamada qalabka lagu ciyaaro"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cố sử dụng công tắc, núm xoay hoặc nút trên đồ chơi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试使用玩具上的开关、旋钮或按钮"
          }
        }
      }
    },
    "cdc-24-uses_gestures": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم إيماءات أكثر من مجرد التلويح والإشارة، مثل نفخ قبلة في الهواء أو هز رأسه إيجابا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses more gestures than just waving and pointing, like blowing a kiss or nodding yes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa más gestos, además de solo saludar con la mano o señalar cosas, como soplar besos o decir que sí con la cabeza"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "استفاده از حرکاتی بیشتر از صرفا تکان دادن دست و نشان دادن با دست، مثلا بوس کردن یا تکان دادن سر برای تایید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit ng higit pang mga pagkilos kaysa sa pagkaway at pagtuturo lang, tulad ng pag-ihip ng halik o pagtango ng oo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise plus de gestes que simplement secouer la main et montrer du doigt, comme envoyer un baiser en soufflant sur sa main ou hocher de la tête pour dire oui"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ हाथ हिलाने और इशारा करने से ज्यादा चेष्टाओं का उपयोग करता है, जैसे चुंबन देना या हां में सिर हिलाना"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Sèvi ak plis jès pase jis voye men ak montre, tankou voye yon bo oswa souke tèt pou di wi"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키스를 보내거나 예라고 고개를 끄덕이는 것과 같이, 단지 손을 흔들거나 가리키는 것보다 더 많은 몸짓을 사용한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa mais gestos do que somente acenar e apontar, como mandar um beijo ou balançar a cabeça com sim"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует жесты не только для прощания и указания: например, посылает воздушный поцелуй или кивает в знак согласия"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu adeegsadaa dhaqdhaqaaqyo ka badan hal-ku- dhegyo ka badan gacan-ku-taaga oo kaliya, sida u afuufida dhunkasho ama u luxida haa"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng nhiều động tác hơn ngoài vẫy và chỉ tay, như hôn gió hoặc gật đầu đồng ý"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除了挥手和指东西外，还会使用更多的手势，如飞吻或点头称是"
          }
        }
      }
    },
    "cdc-24-walks_climbs": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصعد على ساقيه (لا يتسلق) بضعة سلالم بمساعدة شخص آخر أو من دونها"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walks (not climbs) up a few stairs with or without help"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube varios escalones caminando (sin gatear) con o sin ayuda"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راه رفتن (و نه بالا رفتن از) روی چندین پله با یا بدون کمک"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naglalakad (hindi umaakyat) sa ilang hagdan nang mayroon o walang tulong"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte (n’escalade pas) quelques marches avec ou sans aide"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मदद के साथ या बिना कुछ सीढ़ियों पर चलकर आगे बढ़ता है (चढ़ता नहीं है)"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte (pa grenpe) kèk mach eskalye avèk oswa san èd"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도움을 받거나 받지 않고 몇 계단을 걸어 올라간다(기어 올라가지 않는다)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe (não escala) alguns degraus com ou sem ajuda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимается по нескольким ступенькам шагами, а не ползком, с помощью или без неё"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu ku socdaa (ma amaha fuulitaan) dhawr jaranjaro isagoo haysta ama aan lahayn caawimaad"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi (không phải leo) lên một vài bậc thang, có hoặc không cần người giúp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在有帮助或没有帮助的情况下，可以走（不是爬）上几级楼梯"
          }
        }
      }
    },
    "cdc-4-brings_hands": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجلب يديه لفمه"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings hands to mouth"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lleva las manos a la boca"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بردن دست به سمت دهان"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinusubo ang mga kamay"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Porte les mains à la bouche"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुँह में हाथ डालता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Pote men yo nan bouch li"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손을 입으로 가져간다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva as mãos à boca"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подносит руки ко рту"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay isku keentaa gacmaha iyo afka"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa tay lên miệng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手放在嘴巴里"
          }
        }
      }
    },
    "cdc-4-chuckles_laugh": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضحك ضحكة خافتة (لم تتطور إلى ضحكة كاملة بعد) عندما تحاولين جعله يضحك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuckles (not yet a full laugh) when you try to make him laugh"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta una risita (todavía no una risa completa) cuando usted trata de hacerlo reír"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خنده ملایم (و نه کامل) در واکنش به تلاش شما برای خنداندن کودک"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humahalakhak (hindi pa buong tawa) kapag sinubukan mong siyang patawanin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Émet un petit rire (pas encore un rire complet) lorsque vous essayez de le faire rire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप उसे हंसाने की कोशिश करते हैं तो हंसता है (अभी तक पूरी हंसी नहीं)"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Fè ti ri (se poko yon ri konplè) lè ou eseye fè l ri"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아기를 웃게 하려고 할 때 싱긋(아직 완전히 웃지 않음) 웃는다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá risadinhas (ainda não é uma risada completa) quando você tenta fazê-lo rir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихонько посмеивается, когда вы пытаетесь его рассмешить, но ещё не смеётся в полный голос"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Muusood (wali aan ahayn qosol buuxa) markaad isku daydo inaad ka qosliso"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cười khúc khích (chưa hẳn là cười lớn) khi quý vị cố khiến bé cười"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您逗宝宝时，宝宝会咯咯地笑（还不是大笑）"
          }
        }
      }
    },
    "cdc-4-holds_head": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنه رفع رأسه بثبات ومن دون دعم عند حمله"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds head steady without support when you are holding him"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la cabeza firme, sin apoyo, cuando usted lo tiene en brazos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ثابت نگه داشتن سر، بدون کمک، هنگامی که او را نگه می دارید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinananatili ang ulo nang walang suporta kapag karga mo siya"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient sa tête en place sans soutien lorsque vous le tenez dans les bras"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप उसे गोद में लिए हुए हों तो सिर को बिना सहारे के स्थिर रखता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenbe tèt li fiks san sipò lè ou kenbe l"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아기를 안고 있을 때 머리를 받쳐주지 않아도 머리를 흔들림 없이 유지한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a cabeça firme sem apoio quando você a segura"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уверенно держит голову без поддержки, когда вы держите его на руках"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay madaxa xasilisaa iyadoo aan taageero lahayn markaad iyada qabato"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngẩng đầu vững mà không cần đỡ khi được quý vị bế"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您抱着宝宝时，宝宝不用支撑即可保持头部稳定"
          }
        }
      }
    },
    "cdc-4-holds_toy": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسك الألعاب عند وضعها في يده"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds a toy when you put it in his hand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujeta un juguete cuando usted se lo pone en la mano"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نگه داشتن اسباب بازی که شما در دستش می گذارید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humahawak ng laruan kapag inilagay ito sa kanyang kamay"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tient un jouet lorsque vous lui mettez dans la main"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप उसके हाथ में एक खिलौना रखते हैं तो उसे पकड़ता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenbe yon jwèt lè ou mete l nan men l"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손에 장난감을 놓으면 그것을 쥔다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segura um brinquedo quando você o coloca na mão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держит игрушку, которую вы вкладываете ему в руку"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu qabsadaa alaab-alaabayda markaad gacanta u geliso"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nắm giữ đồ chơi khi quý vị đặt vào tay bé"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您把玩具放在宝宝手里时，宝宝会抓住玩具"
          }
        }
      }
    },
    "cdc-4-if_hungry": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح فمه إذا كان جائعا عند رؤية الثدي أو زجاجة الحليب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If hungry, opens mouth when he sees breast or bottle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tiene hambre, abre la boca cuando ve el pecho o el biberón"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در صورت گرسنه بودن، باز کردن دهان پس از دیدن سینه مادر یا شیشه شیر"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung gutom, ibinubuka ang bibig kapag nakakita siya ng suso o bote"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’il a faim, ouvre la bouche lorsqu’il voit le sein ou le biberon"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भूख लगे तो स्तन या बोतल देखकर मुंह खोलता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Si li grangou, li louvri bouch li lè li wè tete oswa bibwon"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배가 고프면 엄마 젖이나 우유병을 보고 입을 벌린다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando está com fome, abre a boca quando vê opeito ou a mamadeira"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если голоден, открывает рот при виде груди или бутылочки"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Haddii ay gaajaysan tahay, waxay kala furtaa afka markay aragto naaska ama masaasada"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở miệng khi thấy ngực hoặc bình sữa nếu bé đói"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果饿了，宝宝看到乳房或奶瓶时会张开嘴"
          }
        }
      }
    },
    "cdc-4-looks_at_hands": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينظر إلى يديه باهتمام"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks at her hands with interest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira sus propias manos con interés"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نگاه کردن مشتاقانه به دستهای خود"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumitingin sa kanyang mga kamay nang may interes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde ses mains avec intérêt"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने हाथों को दिलचस्पी से देखता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Enterese nan gade men li"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신의 손을 관심 있게 바라본다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha para as mãos com interesse"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С интересом рассматривает свои руки"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Gacmihiisa ayuu eegaa isagoo xiisaynaya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thích thú nhìn bàn tay bé"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会很有兴趣地看自己的手"
          }
        }
      }
    },
    "cdc-4-looks_you": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينظر إليك أو يتحرك أو يصدر أصواتا للفت انتباهك أو الاستمرار في لفته"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks at you, moves, or makes sounds to get or keep your attention"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo mira, se mueve o hace sonidos para llamar o mantener su atención"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نگاه کردن به شما، حرکت کردن، یا ایجاد صدا برای جلب یا حفظ توجه شما"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumitingin sa iyo, gumagalaw, o gumagawa ng mga tunog para makuha o mapanatili ang iyong pansin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous regarde, bouge ou émet des sons pour attirer ou conserver votre attention"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ध्यान आकर्षित करने या बनाए रखने के लिए आपकी ओर देखता है, हिलता-डुलता है या आवाज करता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Gade ou, bouje, oswa fè son pou atire oswa pou kenbe atansyon ou"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주의를 끌거나 자신에게 집중하도록 하기 위해 상대를 바라보거나 움직이거나 소리를 낸다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha para você, se move ou faz sons para chamar ou manter sua atenção"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрит на вас, двигается или издаёт звуки, чтобы привлечь или удержать ваше внимание"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuu ku soo fiiriyaa, dhaqaaqaa, ama wuxuu sameeyaa dhawaaqyo si uu u helo ama u xafido dareenkaaga"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn quý vị, cử động hoặc phát ra tiếng để thu hút hoặc duy trì sự chú ý của quý vị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看着您，做动作，或发出声音来吸引或保持您的注意力"
          }
        }
      }
    },
    "cdc-4-makes_sounds": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصدر أصواتا مثل “أووه” أو “آآه” (أصوات كهديل الحمام)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes sounds like “oooo”, “aahh” (cooing)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gorjea (“agú”, “aahh”)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایجاد صداهایی مانند \"اوووو\"، \"آآ هه\" (آواگری های آغازین)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagawa ng mga tunog na gaya ng \"oooo\", \"aahh\" (pag-coo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Émet des sons comme « oh », « ah » (roucoule)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ऊ\", \"आह\" (गुटगूं करना) जैसी आवाज़ें निकालता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Fè son tankou “oooo”, “aaaa” (gazouye)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"우우\", \"아아\"(옹알이)와 같은 소리를 낸다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz sons como “uuh”, “aah” (balbuciando)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Издаёт звуки вроде «у-у-у» и «а-а-а» — гулит"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay sameeyaan dhawaaqyada sida “oooo”, “aahh” (ganuunicid)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát ra tiếng như “u”, “a” (thì thầm)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发出“喔”、“啊”（呀呀学语）等声音"
          }
        }
      }
    },
    "cdc-4-pushes_up": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستند على كوعيه/ساعديه عندما يكون على بطنه"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes up onto elbows/forearms when on tummy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está boca abajo, se levanta hasta apoyarse en los codos y antebrazos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تحمیل فشار به آرنج/ساعد خود برای بلند شدن، در وضعیتی که روی شکم خود قرار گرفته است"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinutulak pataas gamit ang mga siko/bisig kapag nakadapa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se soulève sur les coudes/avant-bras lorsqu’il est sur le ventre"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब पेट के बल लेटा हो तो कोहनियों/कलाइयों के बल खुद को उठाता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouse monte sou koudbra/avanbra lè li sou vant"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배를 대고 엎드렸을 때 팔꿈치/팔뚝으로 몸을 밀어 올린다 발달지표는 중요합니다! 아기가 놀고, 배우고, 말하고, 행동하고, 움직이는 방식은 아기의 발육에 관한 중요한 실마리를 제공합니다. 만 4개월까지 나타나는 발달지표를 확인하세요. 아기의 정기 건강검진을 위해 소아과 의사를 방문할 때마다 이 체크리스트를 지참하고 아기가 이미 도달한 발달지표와 앞으로 기대되는 발달지표에 대해 상담하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurra para cima nos cotovelos/antebraços quando está de bruços"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёжа на животе, приподнимается, опираясь на локти или предплечья"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu kor ugu riixaa suxullada/gacmaha hore markuu caloosha ku jiro"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng khuỷu tay/cẳng tay để chống người lên khi nằm sấp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "趴着时，尝试用手肘/前臂支起上身里程碑很重要！宝宝的玩耍、学习、言谈、行为和运动是了解宝宝发育的重要线索。请勾选出您的宝宝在 4 个月大时已经达到的发育里程碑。每次儿童体检时带上这个里程碑参照表，与医生讨论宝宝已经达到的发育里程碑和下一阶段的里程碑。"
          }
        }
      }
    },
    "cdc-4-smiles_attention": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبتسم من تلقاء نفسه للفت انتباهك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smiles on his own to get your attention"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonríe solito para llamar su atención"
          }
        },
        "fa": {
          "stringUnit": {
