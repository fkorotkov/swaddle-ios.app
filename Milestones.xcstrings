          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“메롱”을 한다(혀를 내밀고 투레질을 함)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
