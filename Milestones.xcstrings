          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставит друг на друга хотя бы два небольших предмета, например кубики"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Isku dhejiya ugu yaraan laba shay oo yaryar, sida bulkeetiyo"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chồng ít nhất hai đồ vật nhỏ, như hai khối lắp ghép"
