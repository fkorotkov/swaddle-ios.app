    "cdc-24-looks-at-your-face-to-see-how-to-react-in-a-new-situation": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينظر إلى وجهك لمعرفة كيفية التفاعل في المواقف الجديدة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks at your face to see how to react in a new situation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo mira a la cara para ver cómo reaccionar en una situación nueva"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نگاه کردن به صورت شما برای ارزیابی واکنش شما به شرایط جدید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinitingnan ang iyong mukha upang makita kung paano ang reaksyon sa isang bagong sitwasyon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde votre visage pour voir comment réagir dans une nouvelle situation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई स्थिति में कैसे प्रतिक्रिया दी जाए यह देखने के लिए आपके चेहरे को देखता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Gade figi ou pou wè kòman pou reyaji nan yon nouvo sitiyasyon"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 상황에서 반응하는 방법을 보기 위해 상대의 얼굴을 바라본다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha para o seu rosto para ver como reagir em uma nova situação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрит на ваше лицо, чтобы понять, как реагировать в новой ситуации"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Eeg wajigaaga si aad u aragto sida looga falceliyo xaalad cusub"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn mặt quý vị để xem nên phản ứng như thế nào trong tình huống mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在遇到新的情况时，看您的脸，判断自己该如何反应"
          }
        }
      }
    },
    "cdc-24-notices_others": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلاحظ إصابة الآخرين بالأذى أو شعورهم بالحزن، مثل التوقف لوهلة وظهور الحزن على وجهه عند بكاء أحدهم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notices when others are hurt or upset, like pausing or looking sad when someone is crying"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se da cuenta cuando otra persona está lastimada o triste; por ejemplo, se detiene o pone cara triste cuando alguien está llorando"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توجه به حالات درد یا اندوه دیگران، مثلا درنگ کردن یا ناراحت شدن در صورت روبرو شدن با گریه دیگران"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Napapansin kapag nasaktan o nabalisa ang iba, tulad ng paghinto ng sandali o pagtingin na malungkot kapag may umiiyak"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remarque lorsque d’autres personnes sont blessées ou contrariées, par exemple en faisant une pause ou ayant l’air triste quand quelqu’un pleure"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब दूसरों को चोट लगती है या परेशान होते हैं तो ध्यान देता है, जैसे किसी के रोने पर रुकना या उदास दिखना"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Remake lè lòt moun fwase oswa fache, tankou fè yon poze oswa sanble tris lè yon moun ap kriye"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 울 때 잠시 멈추거나 슬퍼 보이는 것과 같이 다른 사람이 다치거나 화가 날 때 알아차린다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Percebe quando os outros estão magoados ou aborrecidos, como fazer uma pausa ou parecer triste quando alguém está chorando"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замечает, когда другим больно или грустно: например, замирает или грустит, когда кто-то плачет"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu ogaadaa marka dadka kale ay dhaawacmaan ama xanaaqaan, sida hakinta ama murugada marka qof ooyo"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận biết khi người khác bị tổn thương hoặc đau khổ, như tạm dừng lại hoặc tỏ vẻ buồn khi có người đang khóc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当别人受伤或伤心时，会注意到；比如当有人哭泣时， 会停下来或看起来很难过"
          }
        }
      }
    },
    "cdc-24-plays_toys": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلعب بأكثر من لعبة في نفس الوقت، مثل وضع طعام لعبة على طبق لعبة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays with more than one toy at the same time, like putting toy food on a toy plate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega con más de un juguete a la vez; por ejemplo, pone comida de juguete en un plato de juguete"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازی کردن همزمان با بیش از یک اسباب‌بازی، مثلا گذاشتن غذای اسباب بازی روی بشقاب اسباب بازی"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naglalaro ng higit sa isang laruan nang sabay sabay, tulad ng paglalagay ng laruang pagkain sa laruang plato"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue avec plusieurs jouets en même temps, comme mettre des jouets en forme de nourriture sur une assiette"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही समय में एक से अधिक खिलौनों के साथ खेलता है, जैसे टॉय प्लेट पर टॉय फ़ूड रखना"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Jwe avèk plis pase yon sèl jwèt an menm tan, tankou mete manje jwèt nan yon jwèt asyèt"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장난감 접시에 장난감 음식을 올려 놓는 것과 같이 동시에 두 개 이상의 장난감을 가지고 논다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Brinca com mais de um brinquedo ao mesmo tempo, como colocar comida de brinquedo em um prato de brinquedo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играет с несколькими игрушками одновременно, например кладёт игрушечную еду на игрушечную тарелку"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxa uu ku ciyaaraa in ka badan hal boombale isku mar, sida in cuntada lagu ciyaaro saxanada lagu ciyaaro"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi với nhiều đồ chơi cùng lúc, như đặt thức ăn đồ chơi lên đĩa đồ chơi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时玩多个玩具，比如将玩具食品放在玩具盘上"
          }
        }
      }
    },
    "cdc-24-points_body": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير إلى جزأين من الجسم على الأقل عندما تطلبين منه ذلك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points to at least two body parts when you ask him to show you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señala al menos 2 partes del cuerpo cuando le pide que le muestre"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشاره کردن به حداقل دو اندام بدن، وقتی این کار را از او درخواست می کنید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinuturo sa hindi bababa sa dalawang bahagi ng katawan kapag hiniling mo sa kanya para ipakita ito sayo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre du doigt au moins deux parties du corps lorsque vous lui demandez de vous les montrer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप उसे आपको अंग दिखाने के लिए कहते हैं तो शरीर के कम से कम दो अंगों की ओर इशारा करता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre omwen de pati nan kò lè w mande l pou l montre w"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이에게 보여 달라고 요청할 때 최소 두 개의 신체 부위를 가리킨다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponta para pelo menos duas partes do corpo quando você pede para ele mostrar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По просьбе показывает не менее двух частей тела"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu tilmaamayaa ugu yaraan laba xubnood oo jirka ah markaad weydiiso inuu ku tuso"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ vào ít nhất hai bộ phận cơ thể khi quý vị yêu cầu trẻ chỉ cho quý vị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少知道两个身体部位，并且您问的时候可以指给您看"
          }
        }
      }
    },
    "cdc-24-points_things": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير إلى أمور في الكتب عندما تسأليه عنها، مثل “أين الدب؟”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points to things in a book when you ask, like “Where is the bear?”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señala las cosas que aparecen en los libros cuando le pregunta; por ejemplo, “¿dónde está el osito?”"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشاره کردن به تصاویر کتاب، هنگامی که مثلا از او می‌پرسید \" خرس کجاست؟\""
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinuturo ang mga bagay sa isang libro kapag tinatanong mo, tulad ng \"Nasaan ang oso?\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre les choses du doigt dans un livre lorsque vous demandez, par exemple, « Où est l’ours ? »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप पूछते हैं जैसे \"भालू कहां है?\", तो किताब में चीजों की ओर इशारा करता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre bagay ki nan yon liv lè ou mande, tankou “Kote lous la?”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"곰이 어디에 있지?\"와 같이 질문할 때 책의 사물을 가리킨다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponta para coisas em um livro quando você pergunta, como “Onde está o urso?”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По вашей просьбе показывает предметы на картинке, например в ответ на «Где мишка?»"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu tilmaamayaa waxyaabaha ku jira buug marka aad waydiiso, sida \"Aaway oorsodu?\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ vào những thứ trong sách khi quý vị hỏi “Con gấu ở đâu nào?”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读书时，当您问“熊在哪里？”，孩子会指向书里的小熊"
          }
        }
      }
    },
