          "stringUnit": {
            "state": "translated",
            "value": "模仿您做家务，比如用扫帚扫地"
          }
        }
      }
    },
    "cdc-18-drinks_cup": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشرب من كوب من دون غطاء وقد يسكب محتوياته أحيانا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drinks from a cup without a lid and may spill sometimes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe de una taza sin tapa y a veces puede derramar la bebida"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوشیدن مایعات از فنجان بدون درپوش، و گاهی ریختن مایعات حین نوشیدن آنها"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Umiinom mula sa isang tasa na walang takip at minsan ay maaaring tumapon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boit avec une tasse sans couvercle et peut en renverser quelquefois"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना ढक्कन वाले प्याले से पीता है और कभी-कभी गिरा सकता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Bwè nan yon goblè san kouvèti, epi gendwa devèse pafwa"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뚜껑이 없는 컵으로 물을 마시며 때때로 쏟을 수 있다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe de um copo sem tampa e pode derramar às vezes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пьёт из чашки без крышки, иногда проливая"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxa uu ka cabaa koob aan dabool lahayn waxaana laga yaabaa inay mararka qaarkood daato"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống từ cốc không có nắp và đôi khi có thể đổ ra ngoài"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用没有盖子的杯子喝水，有时可能会洒"
          }
        }
      }
    },
    "cdc-18-feeds_himself": {
