          "stringUnit": {
            "state": "translated",
            "value": "Observa conforme você se move"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следит за вами, когда вы двигаетесь"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay ku daawanayan markaad dhaqaaqeyso"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan sát theo sự di chuyển của quý vị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您移动的时候看着您"
          }
        }
      }
    },
