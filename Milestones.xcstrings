        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пальцами подгребает к себе еду"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu isticmaalaa faraha si uu ugu \"aruuriyo\" cuntada xagiisa"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng ngón tay để “cào” đồ ăn về phía mình"
          }
        },
        "zh-Hans": {
