    "cdc-9-reacts_when_leave": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتفاعل عندما تغادرين (ينظر إليك، أو يمد يديه محاولا الوصول إليك، أو يبكي)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reacts when you leave (looks, reaches for you, or cries)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reacciona cuando usted se va (lo busca con la mirada, estira los brazos hacia usted o llora)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشان دادن واکنش به دور شدن شما (نگاه کردن، دراز کردن دست به سمت شما، گریه کردن)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutugon kapag umalis ka (tumitingin, inaabot ka, o umiiyak)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réagit lorsque vous partez (vous regarde, vous tend la main ou pleure)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप बाहर जाते हैं तो प्रतिक्रिया देता है (देखता है, आपकी ओर बाँहें फैलाता है, या रोता है)"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Reyaji lè ou pati (gade, chèche jwenn ou, oswa kriye)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하가 아기를 떠날 때 반응한다(바라보거나, 손을 뻗거나 운다)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reage quando você sai (olha, estende a mão para você ou chora)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реагирует, когда вы уходите: смотрит вслед, тянется к вам или плачет"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
