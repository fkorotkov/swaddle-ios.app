        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा किए जाने वाले कामों की नकल करता है, जैसे झाड़ू लगाना"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
