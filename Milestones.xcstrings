          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подражает вам в домашних делах, например подметает веником"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay koobiyaysaa adiga oo qabanaysa shaqooyinka, sida ku xaaqidda xaaqinka"
