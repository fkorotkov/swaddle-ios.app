        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хлопает в ладоши от радости"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Way sacbiyaan markay farxaan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vỗ tay khi hào hứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兴奋时拍手"
          }
        }
      }
    },
    "cdc-15-copies_other": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقلدون الأطفال الآخرين في أثناء اللعب، كأخذ اللعب من وعاء ما عندما يفعل طفل آخر ذلك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies other children while playing, like taking toys out of a container when another child does"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia a otros niños mientras juega, como sacar juguetes de un contenedor cuando otro niño lo hace"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تقلید از کودکان دیگر حین بازی، مثلا بیرون آوردن اسباب بازی از ظرف با مشاهده این رفتار از کودکان دیگر"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinokopya ang ibang mga bata habang naglalaro, tulad ng pagkuha ng mga laruan sa isang lalagyan kapag ginagawa ito ng ibang bata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imite les autres enfants tout en jouant, comme sortir des jouets d’un contenant lorsqu’un autre enfant le fait"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खेलते समय अन्य बच्चों की नकल करता है, जैसे किसी अन्य बच्चे द्वारा खिलौनों को कंटेनर से बाहर निकालना"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopye lòt timoun pandan y ap jwe, tankou retire jwèt sot nan yon veso lè yon lòt timoun fè sa"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 아이가 놀이를 할 때 장난감을 용기에서 꺼내는 것과 같이 다른 아이가 노는 것을 따라 한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia outras crianças quando brinca, como tirar brinquedos de um recipiente quando outra criança faz isso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подражает другим детям в игре, например вынимает игрушки из коробки вслед за другим ребёнком"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay koobiyeeyaan carruurta kale marka ay ciyaarayaan, sida inay alaabta ay ku ciyaaraan ka soo saaraan weelka marka uu ilmo kale sameeyo"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt chước các trẻ khác trong khi chơi, như lấy đồ chơi ra khỏi chỗ cất khi trẻ khác làm như vậy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玩耍时模仿其他孩子，比如学其他孩子从容器中拿出玩具"
          }
        }
      }
    },
    "cdc-15-follows_directions": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع التوجيهات عند تقديمها إليه بالإشارة أو الكلمات على حد سواء. على سبيل المثال، يعطيك لعبة عندما تمدين يدك وتقولين \"أعطني اللعبة\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows directions given with both a gesture and words. For example, he gives you a toy when you hold out your hand and say, “Give me the toy.”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue las instrucciones que se le dan con un gesto (acción). Por ejemplo le pasa un juguete cuando usted estira la mano y le dice: “Pásame el juguete”"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجرای دستورهایی که با اشاره و واژه داده می‌شود. مثلا، وقتی دست تان را دراز می کنید و می گویید \"اسباب بازی را به من بده\"، یک اسباب بازی به شما می دهد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusunod ang mga direksyong ibinigay gamit ang galaw at mga salita. Halimbawa, ibibigay sa iyo ang laruan kapag itinaas mo ang iyong kamay at sasabihing, “Ibigay mo sa akin ang laruan.”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit les instructions données avec un geste et des mots. Par exemple, il vous donne un jouet lorsque vous tendez la main et dites « Donne-moi le jouet »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हावभाव और शब्दों दोनों के साथ दिए गए निर्देशों का पालन करता है। उदाहरण के लिए, जब आप अपना हाथ आगे करके कहते हैं, \"मुझे खिलौना दो\", तो वह आपको एक खिलौना देता है।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiv direksyon yo bay avèk ni jès ni mo. Pa egzanp, li ba w yon jwèt lè w lonje men w epi w di: “Bann m jwèt la.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸짓과 단어로 지시를 주면 따른다. 예: 손을 내밀면서 “장난감 줘.”라고 말하면 장난감을 준다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue as instruções fornecidas com gestos e palavras. Por exemplo, ele dá um brinquedo quando você estende a mão e diz: “Dê-me o brinquedo”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет просьбу, сопровождаемую словами и жестом. Например, отдаёт игрушку, когда вы протягиваете руку и говорите: «Дай мне игрушку»"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay raacdaa tilmaamaha lagu bixiyo tilmaam iyo kelmado labadaba. Tusaale ahaan, waxa uu ku siinayaa qalab ay ku ciyaaraan marka aad gacanta soo taagto oo aad ku tidhaahdo, \"I sii alaabta\"."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm theo chỉ dẫn bằng cả động tác và lời nói. Ví dụ: trẻ sẽ đưa cho quý vị đồ chơi khi quý vị giơ tay ra và nói “Con đưa cho mẹ đồ chơi nào”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听从手势和语言指令。比如，当您伸出手并说“把玩具给我”时，孩子就会给您"
          }
        }
      }
    },
    "cdc-15-hugs_doll": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحضنون الدمى المحشوة أو غير ذلك من اللعب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugs stuffed doll or other toy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abraza una muñeca u otro juguete de peluche"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بغل کردن عروسک یا اسباب بازی دیگر"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Niyayakap ang manika o iba pang laruan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serre dans ses bras une poupée en peluche ou un autre jouet"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रुई से भरे खिलौने या अन्य खिलौने को गले लगाता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Bay poupe boure oswa lòt jwèt akolad"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "봉제 인형이나 기타 장난감을 끌어안는다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abraça um boneco de pelúcia ou outro brinquedo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнимает мягкую куклу или другую игрушку"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay isku duuban boombalada cufan ama qalab kale oo lagu ciyaaro"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ôm búp bê nhồi bông hoặc đồ chơi khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拥抱毛绒玩具或其他玩具"
          }
        }
      }
    },
    "cdc-15-looks_familiar": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينظرون إلى الغرض المألوف عندما تذكرين اسمه"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks at a familiar object when you name it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira un objeto conocido cuando usted lo nombra"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نگاه کردن به اشیای آشنا پس از شنیدن نام آنها"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumitingin sa isang pamilyar na bagay kapag binanggit mo ito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde un objet familier lorsque vous le nommez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप किसी परिचित वस्तु का नाम लेते हैं तो वह देखता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Gade yon objè li abitye ak li lè ou di non objè a"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익숙한 사물의 이름을 말하면 그 사물을 본다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha para um objeto familiar quando você o nomeia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрит на знакомый предмет, когда вы его называете"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu eegaa shay uu yaqaano markaad magacowdo"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn vào đồ vật quen thuộc khi quý vị gọi tên đồ vật đó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您说出熟悉的物体名称时，宝宝就会看向它"
          }
        }
      }
    },
    "cdc-15-points_help": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير بيده لطلب شيء ما أو لطلب المساعدة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points to ask for something or to get help"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señala con la mano para pedir algo o para obtener ayuda"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کمک خواستن یا درخواست کردن اشیا از طریق اشاره"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagtuturo para humingi ng isang bagay o para humingi ng tulong"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre du doigt pour demander quelque chose ou obtenir de l’aide"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ मांगने या मदद पाने के लिए उंगली से इशारा करता है।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Lonje dwèt li pou l mande yon bagay oswa pou li jwenn èd"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇인가를 달라고 요청하거나 도움을 구하려고 손으로 가리킨다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponta para pedir algo ou obter ajuda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает пальцем, чтобы попросить что-то или получить помощь"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu tilmaamaa si uu u waydiisto shay ama si uu u helo caawimaad"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tay để đòi thứ gì đó hoặc nhờ giúp đỡ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手指向想要的东西或寻求帮助"
          }
        }
      }
    },
    "cdc-15-shows_affection": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهرون حبهم لك (بالأحضان أو العناق أو القبلات)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
