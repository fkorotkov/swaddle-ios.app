    "cdc-18-follows_directions": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع التوجيهات التي تتألف من خطوة واحدة من دون أي إشارات، مثل إعطائك لعبة عندما تقولين “أعطني اللعبة”."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows one-step directions without any gestures, like giving you the toy when you say, “Give it to me.”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue instrucciones de 1 paso sin hacerle gestos; por ejemplo, le entrega un juguete cuando le dice “dámelo”"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجرای دستورهای تک‌مرحله‌ای بدون اشاره، مانند دادن اسباب‌بازی به شما، وقتی که می‌گویید \"آن را به من بده.\""
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumusunod sa mga isang-hakbang na direksyon nang walang anumang kilos, tulad ng pagbibigay sa iyo ng laruan kapag sinabi ang, \"Ibigay mo sa akin.\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit les instructions en une seule étape sans aucun geste, comme vous donner un jouet lorsque vous dites « Donne-le-moi »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना किसी इशारों के एक-चरणीय निर्देशों का पालन करता है, जैसे कि जब आप कहते हैं, \"मुझे दो\", तो आपको खिलौना देना।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiv direksyon yon sèl etap san okenn jès, tankou ba ou jwèt la lè ou di, “Ban mwen l.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"이리 줘.\"라고 말하면 장난감을 주는 것과 같이 몸짓 없이 단순히 내린 1단계의 지시를 따른다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue instruções de um passo sem nenhum gesto, como dar o brinquedo quando você diz: “Dê para mim”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет простую просьбу без жестов, например отдаёт игрушку, когда вы говорите: «Дай мне»"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxay raacdaa tilmaamo hal-tallaabo ah iyada oo aan wax dhaqdhaqaaq ah samayn, sida markay ku siinaysa boombalada marka aad tidhaahdo, \"I sii.\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm theo chỉ dẫn từng bước mà không cần động tác, như đưa đồ chơi cho quý vị khi quý vị nói “Hãy đưa cho mẹ nào”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遵循没有手势的简单指令，比如当您说“把玩具给我” 时，就把它给您"
          }
        }
      }
    },
    "cdc-18-helps_dress": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يساعدك على إلباسه من خلال دفع ذراعه عبر الكم أو رفع قدمه"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps you dress him by pushing arm through sleeve or lifting up foot"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda cuando lo viste, pasando los brazos por las mangas o levantando los pies"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همکاری با شما برای پوشیدن لباس با وارد کردن دست در آستین یا بلند کردن پا"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinutulungan ka sa kanyang pagbihis sa pamamagitan ng pagtulak ng braso niya sa manggas o pag-angat ng paa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous aide à l’habiller en poussant son bras dans la manche ou en levant le pied"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आस्तीन के बाहर हाथ निकालकर या पैर ऊपर उठाकर खुद तैयार होने में आपकी सहायता करता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Pa pouse bra antre nan manch rad oswa leve pye l pou ede w abiye l"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔을 소매 안으로 밀어넣거나 발을 들어 올려 옷을 입히기 쉽도록 돕는다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda você a vesti-lo, empurrando o braço na manga ou levantando o pé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогает одевать себя: просовывает руку в рукав или поднимает ногу"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu kaa caawinayaa inaad u labisato isaga cudud ku riixaya shaati ama cagta kor u qaadaysa"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giúp quý vị mặc quần áo cho trẻ khi cho tay vào ống tay áo hoặc nhấc chân lên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手臂穿过袖子或抬起脚来配合您给他/她穿衣服"
          }
        }
      }
    },
    "cdc-18-looks_pages": {
