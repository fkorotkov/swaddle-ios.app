    "cdc-15-stacks_small": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرص عنصرين صغيرين على الأقل كالمكعبات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacks at least two small objects, like blocks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca, uno sobre otro, al menos 2 objetos pequeños como dos bloques"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی هم چیدن حداقل دو شیء کوچک، مانند بلوک بازی"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
