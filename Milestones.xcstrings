        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sube y baja de un sofá o silla sin ayuda"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بالا و پایین رفتن از کاناپه یا صندلی، بدون کمک"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Umaakyat at bumababa sa sopa o upuan nang walang tulong"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grimpe sur un canapé ou une chaise et en descend sans aide"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना मदद के सोफे या कुर्सी पर चढ़ता-उतरता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte ak desann sou yon kanape oswa sou yon chèz san èd"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도움 없이 소파나 의자에 오르내린다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe e desce de um sofá ou cadeira sem ajuda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самостоятельно залезает на диван или стул и слезает с него"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu ku fuulaa oo ka soo baxa sariir ama kursi iyada oo aan la caawin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trèo lên và trèo xuống ghế dài hoặc ghế mà không cần giúp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在没有帮助的情况下,自己在沙发或椅子上爬上爬下"
          }
        }
      }
    },
    "cdc-18-copies_chores": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
