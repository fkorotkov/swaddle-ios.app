    "cdc-18-tries_words": {
      "comment": "Official CDC checklist wording; display translation only. Stable skill ID and stored observation wording remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحاول قول ثلاث كلمات أو أكثر بخلاف “ماما” أو “بابا”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tries to say three or more words besides “mama” or “dada”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta decir tres palabras o más, además de mamá o papá"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش برای ادا کردن حداقل سه واژه علاوه بر \"ماما\" یا \"دادا\""
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusubukang magsabi ng tatlo o higit pang salita bukod sa \"mama\" o \"dada\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie de dire au moins trois mots en plus de « maman » ou « papa »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ममा\" या \"डैडा\" के अलावा तीन या अधिक शब्द कहने का प्रयास करता है"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseye di twa mo oswa plis apade “mama” oswa “papa”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"마마\" 또는 \"빠빠\" 이외에 3개 이상의 단어를 말하려고 한다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta dizer três ou mais palavras além de “mama” ou “dada”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пытается произнести не менее трёх слов, кроме «мама» и «папа»"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu isku dayaa inuu yiraahdo saddex ama in ka badan oo aan ahayn \"hooyo\" ama \"aabe\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cố nói ba từ trở lên ngoài “mama” hoặc “dada”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除了“妈妈”或“爸爸”外，还尝试说三个或更多的词"
          }
        }
      }
    },
    "cdc-18-walks_without": {
