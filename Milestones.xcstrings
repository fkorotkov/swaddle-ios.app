        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको स्नेह दिखाता है (गले लगाना, चिपकना, या आपको चूमना)"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre ou afeksyon (anbrase, karese, oswa bo ou)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애정을 보여준다(상대를 포옹하거나, 껴안거나 뽀뽀한다)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra afeição (abraços, abraços ou beijos)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проявляет к вам нежность: обнимает, прижимается или целует"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu ku tusaa kalgacayl (wuu ku habsiin, koolkoolin, ama ku dhunkani)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thể hiện tình yêu thương với quý vị (ôm, âu yếm hoặc hôn quý vị)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向您表达爱意（拥抱、搂抱或亲吻您）"
          }
        }
      }
    },
