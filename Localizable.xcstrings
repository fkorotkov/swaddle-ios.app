    "Your log is a record of care. No scores, streaks, or feeding targets." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجلك يوثّق الرعاية، دون درجات أو سلاسل إنجازات يومية أو أهداف للتغذية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu diario registra los cuidados. Sin puntuaciones, rachas ni objetivos de alimentación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گزارش شما ثبت مراقبت است؛ بدون امتیاز، زنجیرهٔ روزهای پیاپی یا هدف تغذیه."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang iyong log ay isang talaan ng pag-aalaga. Walang mga marka, streaks, o feed target."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre journal garde la trace des soins. Sans score, sans séries à maintenir et sans objectif d’alimentation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका लॉग देखभाल का रिकॉर्ड है। इसमें अंक, लगातार दिनों के लक्ष्य या आहार के लक्ष्य नहीं हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ou se yon dosye de swen. Pa gen pwen, streaks, oswa manje objektif."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돌봄을 기록하는 공간입니다. 점수, 연속 기록일, 수유 목표는 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu diário registra os cuidados. Sem pontuações, sequências de dias ou metas de alimentação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш журнал — история заботы. Без баллов, непрерывных серий и целевых объёмов кормления."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diiwaankaagu wuxuu diiwaangeliyaa daryeelka. Ma laha dhibco, taxane maalmo ama yoolal quudin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhật ký lưu lại việc chăm sóc, không chấm điểm, đếm chuỗi ngày hay đặt mục tiêu cữ bú."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的日志是照顾记录,没有分数、连续或喂养目标。"
          }
        }
      }
    },
