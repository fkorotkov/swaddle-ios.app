    "timezone must be a valid time zone matching the UTC offset at occurredAt." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن تكون timezone منطقة زمنية صالحة تطابق فرق UTC عند occurredAt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone debe ser una zona horaria válida que coincida con el desfase UTC de occurredAt."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone باید منطقهٔ زمانی معتبری باشد که با اختلاف UTC در occurredAt مطابقت دارد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone ay dapat na isang wastong zone ng oras na tumutugma sa UTC offset sa occurredAt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone doit être un fuseau horaire valide correspondant au décalage UTC à occurredAt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone एक मान्य समय क्षेत्र होना चाहिए जो occurredAt पर UTC ऑफ़सेट से मेल खाता हो।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone dwe yon fuseau tan valab ki matche ak offset UTC nan occurredAt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone 는 occurredAt 의 UTC 오프셋과 일치하는 유효한 시간대여야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone deve ser um fuso horário válido correspondente ao deslocamento UTC em occurredAt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone должен быть действительным часовым поясом, соответствующим смещению UTC на occurredAt."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone waa in ay tahay zone waqti sax ah oo la mid ah offset UTC at occurredAt."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone phải là múi giờ hợp lệ khớp độ lệch UTC tại occurredAt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "timezone 必须是一个有效的时区,与 occurredAt 上的 UTC 偏移相匹配。"
          }
        }
      }
    },
