    "Example records show how Swaddle works, not care recommendations or targets." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Example records show how Swaddle works, not care recommendations or targets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de ejemplo muestran cómo funciona Swaddle; no son recomendaciones ni objetivos de cuidado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces exemples montrent le fonctionnement de Swaddle. Ce ne sont ni des recommandations de soins ni des objectifs."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os registros de exemplo mostram como o Swaddle funciona, não são recomendações nem metas de cuidados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примеры записей показывают, как работает Swaddle. Это не рекомендации по уходу и не целевые показатели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "示例记录仅用于展示 Swaddle 的使用方式，并非护理建议或目标。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예시 기록은 Swaddle의 사용 방법을 보여 주며, 돌봄 권장 사항이나 목표가 아니에요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bản ghi mẫu minh họa cách dùng Swaddle, không phải khuyến nghị hay mục tiêu chăm sóc."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipinapakita ng mga halimbawang tala kung paano gumagana ang Swaddle. Hindi ito mga rekomendasyon o target sa pangangalaga."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antre egzanp yo montre kijan Swaddle fonksyone; se pa rekòmandasyon ni objektif swen."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diiwaannada tusaaluhu waxay muujinayaan sida Swaddle u shaqeeyo, mana aha talooyin daryeel ama yoolal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उदाहरण रिकॉर्ड बताते हैं कि Swaddle कैसे काम करता है। ये देखभाल की सलाह या लक्ष्य नहीं हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توضّح السجلات النموذجية طريقة عمل Swaddle، وليست توصيات للرعاية أو أهدافًا."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوابق نمونه روش کار Swaddle را نشان می‌دهند و توصیه یا هدف مراقبتی نیستند."
          }
        }
      }
    },
