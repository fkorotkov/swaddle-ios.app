    "Choose a Boys or Girls growth reference in the child’s profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختار مرجع نمو الأولاد أو البنات في ملف الطفل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la referencia para niños o niñas en el perfil del bebé."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در پروفایل کودک، مرجع رشد پسران یا دختران را انتخاب کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pumili ng Boys o Girls growth reference sa profile ng bata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une référence de croissance Garçons ou Filles dans le profil de l’enfant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बच्चे के प्रोफ़ाइल में एक लड़के या लड़की विकास संदर्भ चुनें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chwazi yon rekòmandasyon pou kwasans ti gason oswa ti fi nan pwofil timoun nan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자녀의 프로필에서 남자 또는 여자 성장 참조를 선택합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma referência de crescimento Meninos ou Meninas no perfil da criança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите норматив роста для мальчиков или девочек в профиле ребёнка."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astaanta ilmaha ka dooro tixraaca koritaanka ee wiilasha ama gabdhaha."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn chuẩn tăng trưởng cho bé trai hoặc bé gái trong hồ sơ của bé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在孩子的个人资料中选择男孩或女孩成长参考。"
          }
        }
      }
    },
