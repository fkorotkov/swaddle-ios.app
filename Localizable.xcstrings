    "Unknown field “%@”. Check Format tips for the supported fields." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحقل غير المعروف “%@”. انظر إرشادات الشكل للحصول على الحقول المدعومة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campo desconocido «%@». Consulta los campos admitidos en Consejos de formato."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فیلد «%@» ناشناخته است. فیلدهای پشتیبانی‌شده را در «راهنمای قالب» ببینید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi kilalang patlang “%@”. Tingnan ang mga tip Format para sa suportadong patlang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Champ inconnu « %@ ». Consultez les conseils de formatage pour connaître les champs pris en charge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अज्ञात फ़ील्ड «%@»। समर्थित फ़ील्ड के लिए «फ़ॉर्मैट संबंधी सुझाव» देखें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chan «%@» enkoni. Gade Konsèy fòma pou chan ki sipòte yo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알 수 없는 필드 “%@”입니다. 지원되는 필드는 형식 도움말에서 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campo desconhecido “%@”. Verifique as dicas de formato para os campos suportados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неизвестное поле “%@”. Проверьте советы по форматированию для поддерживаемых полей."
          }
        },
        "so" : {
