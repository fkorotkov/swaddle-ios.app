    "Save the circumference around the head. Your dated measurements and growth comparisons appear in Trends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حفظ المحيط حول الرأس قياساتك المؤرخة ومقارنات النمو تظهر في الاتجاهات"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la medida alrededor de la cabeza. Tus mediciones con fecha y las comparaciones de crecimiento aparecen en Tendencias."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محيط اطراف سر را ذخيره كنيد. اندازه‌گيري‌هاي تاريخ شده و مقايسه‌هاي رشد شما در روندها ظاهر مي‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-save ang circumference sa paligid ng ulo. Ang iyong petsa pagsukat at paglago paghahambing ay lilitaw sa Trends."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez la circonférence autour de la tête. Vos mesures datées et les comparaisons de croissance apparaissent dans Tendances."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर के चारों ओर परिधि को सहेजें. आपकी तिथिबद्ध माप और वृद्धि की तुलना प्रवृत्ति में दिखाई देती है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sove mezi toutotou tèt la. Mezi ki gen dat ak konparezon kwasans yo ap parèt nan Tandans."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "머리 주위의 둘레를 저장합니다. 기록된 측정값과 성장 비교가 추세에 나타납니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve a circunferência ao redor da cabeça. Suas medições e comparações de crescimento aparecem em Tendências."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите окружность головы. Измерения с датами и сравнения с нормативами роста появятся в разделе «Тенденции»."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydinta wareegga madaxa ku hareeraysan. Miisaankaaga taariikhda iyo kala duwanaanshaha koritaanka ayaa ka muuqda Trends."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu số đo vòng đầu. Các số đo kèm ngày và so sánh tăng trưởng sẽ xuất hiện trong Xu hướng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存头围。您可以在“趋势”中查看带日期的测量记录和生长比较。"
          }
        }
      }
    },
    "Saved a care note for %@." : {
      "localizations" : {
