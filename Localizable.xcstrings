    "It may have been deleted, or your family access may have changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يكون قد تم حذفه، أو قد يكون وصول عائلتك قد تغير."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede haberse eliminado o haber cambiado tu acceso a la familia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ممکن است حذف شده باشد یا دسترسی شما به خانواده تغییر کرده باشد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaaring tinanggal na ito, o maaaring nagbago ang access ng iyong pamilya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a peut-être été supprimée ou votre accès familial a changé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह मिटाया जा सकता है, या आपका परिवार पहुँच बदल गया हो सकता है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li kapab ke li te efase, oswa aksè fanmi ou ka chanje."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제되었거나 가족 액세스가 변경되었을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela pode ter sido excluída ou o acesso da sua família pode ter mudado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, она была удалена или доступ к ней был изменен."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaa laga yaabaa in la tirtiro, ama waxaa laga yaabaa inay isbedeshay helitaanka qoyska."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể nó đã bị xóa, hoặc quyền truy cập của gia đình bạn có thể đã thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可能已被删除,或者您的家庭访问权限可能已经更改。"
          }
        }
      }
    },
