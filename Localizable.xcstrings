    "This caregiver’s invitation changed while syncing. Reopen the profile to continue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيرت دعوة مقدم الرعاية هذا أثناء التزامن. أعيد فتح الصورة الشخصية للاستمرار."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La invitación de este cuidador cambió durante la sincronización. Vuelve a abrir el perfil para continuar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این دعوت‌نامه مراقب در حین همگام‌سازی تغییر کرد. برای ادامه، پروفایل را دوباره باز کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
