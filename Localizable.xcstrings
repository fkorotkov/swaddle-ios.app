    "Wait for Swaddle to check your invitation before creating a profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتظر Swaddle للتحقق من دعوتك قبل إنشاء ملف تعريفي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera a que Swaddle compruebe tu invitación antes de crear un perfil."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صبر کنید تا Swaddle قبل از ایجاد یک پروفایل دعوت‌نامه شما را بررسی کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maghintay para sa Swaddle upang suriin ang iyong imbitasyon bago lumikha ng isang profile."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez que Swaddle vérifie votre invitation avant de créer un profil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोफ़ाइल बनाने से पहले Swaddle को अपना निमंत्रण जाँचने दें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpri tann pou Swaddle tcheke envitasyon ou anvan li kreye yon pwofil."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle이 초대를 확인한 후 프로필을 만드세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde que o Swaddle verifique seu convite antes de criar um perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед созданием профиля подождите, пока Swaddle проверит ваше приглашение."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suga Swaddle si aad u hubiso martiqaad ka hor intaan la abuurin profile."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chờ Swaddle kiểm tra lời mời trước khi tạo hồ sơ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在创建个人资料之前,等待 Swaddle 检查您的邀请。"
          }
        }
      }
    },
