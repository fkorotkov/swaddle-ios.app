    "Care history discovery requires iOS 27. Voice logging and feeding answers remain available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب العثور على سجل الرعاية iOS 27. يظل التسجيل بالصوت وإجابات التغذية متاحين."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda del historial de cuidados requiere iOS 27. El registro por voz y las respuestas sobre alimentación siguen disponibles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یافتن سابقهٔ مراقبت به iOS 27 نیاز دارد. ثبت صوتی و پاسخ‌های مربوط به تغذیه همچنان در دسترس هستند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan ng iOS 27 ang pagtukoy sa kasaysayan ng pangangalaga. Ang voice logging at feeding answers ay nananatiling magagamit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La découverte de l’historique des soins nécessite iOS 27. L’enregistrement vocal et les réponses d’alimentation restent disponibles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केयर इतिहास खोज iOS 27 की आवश्यकता होती है. आवाज लॉगिंग और फीडिंग उत्तर उपलब्ध रहते हैं."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dekouvri istorik swen mande iOS 27. Ou toujou ka anrejistre ak vwa epi jwenn repons sou alimantasyon."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돌봄 이력 검색에는 iOS 27이 필요합니다. 음성 기록과 수유 관련 답변은 계속 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A busca no histórico de cuidados requer o iOS 27. O registro por voz e as respostas sobre alimentação continuam disponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для поиска истории ухода нужна iOS 27. Голосовое добавление записей и ответы о кормлении остаются доступны."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daryeelka taariikhda soo bandhigida u baahan tahay iOS 27. Codka logging iyo jawaabaha quudinta weli waa la heli karaa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm kiếm lịch sử chăm sóc cần iOS 27. Ghi bằng giọng nói và câu trả lời về việc cho bú vẫn dùng được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "护理历史记录发现需要 iOS 27。 语音日志和喂食回答仍然可用。"
          }
        }
      }
    },
