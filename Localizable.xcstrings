    "Record pee, poo, or both. With one child, no name is needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل التبول أو البراز أو كليهما مع طفل واحد، لا حاجة إلى اسم."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra pipí, caca o ambos. Si solo hay un bebé, no hace falta un nombre."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادرار، مدفوع یا هر دو را ثبت کنید. اگر فقط یک کودک دارید، نام لازم نیست."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-record ng ihi, dumi, o pareho. Sa isang bata, walang pangalan ay kinakailangan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez pipi, selles ou les deux. S’il n’y a qu’un enfant, son nom n’est pas nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शौच, मल या दोनों को रिकॉर्ड करें. एक बच्चे के साथ कोई नाम नहीं चाहिए."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrejistre pipi, poupou, oswa tou le de. Si gen yon sèl timoun, pa bezwen non."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오줌, 똥 또는 둘 다를 기록합니다. 한 아이가 있으면 이름이 필요하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre urina, cocô ou ambos. Com uma criança, nenhum nome é necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записать мочу, стул или оба варианта. Если ребёнок один, имя не требуется."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diiwaangeli kaadi, saxaro ama labadaba. Haddii hal ilmo jiro, magac looma baahna."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi tè, phân hoặc cả hai. Nếu chỉ có một bé, không cần nêu tên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录尿液、粪便或两者。 如果只有一个孩子,则不需要姓名。"
          }
        }
      }
    },
