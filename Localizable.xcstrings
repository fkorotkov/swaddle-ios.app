          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस देखभालकर्ता का निमंत्रण समक्रमण के दौरान बदल गया. जारी रखने के लिए प्रोफ़ाइल को फिर से खोलें."
          }
        },
        "ht" : {
          "stringUnit" : {
