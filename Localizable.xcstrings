          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक परिवार संपादक जन्म तिथि जोड़ सकता है और बच्चे के प्रोफ़ाइल में विकास संदर्भ चुन सकता है।"
