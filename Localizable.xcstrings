          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc một ghi chép iCloud an toàn. Bản ghi cục bộ của bạn đã được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法安全读取 iCloud 记录。 本地日志已保留。"
