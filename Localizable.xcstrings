        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись iCloud не может быть прочитана безопасно. Ваш локальный журнал был сохранен."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
