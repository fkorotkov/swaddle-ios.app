    "Recorded activity will appear here. A day without entries doesn’t mean nothing happened." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوف يظهر النشاط المسجل هنا. يوم بدون مدخلات لا يعني أنه لم يحدث شيء."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecerá la actividad registrada. Un día sin registros no significa que no haya pasado nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعالیت‌های ثبت‌شده در اینجا ظاهر می‌شوند. یک روز بدون مدخل به این معنی نیست که هیچ اتفاقی نیفتاده است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lilitaw rito ang naitalang aktibidad. Hindi ibig sabihin ng araw na walang tala na walang nangyari."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les activités enregistrées apparaîtront ici. Un jour sans entrée ne signifie pas qu’il ne s’est rien passé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्ड की गई गतिविधि यहाँ दिखाई देगी. बिना प्रविष्टि के दिन का मतलब यह नहीं है कि कुछ भी नहीं हुआ."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivite anrejistre yo ap parèt isit la. Yon jou san antre pa vle di anyen pa t rive."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록된 활동이 여기에 나타납니다. 항목이 없는 하루가 아무 일도 일어나지 않았다는 것을 의미하지는 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atividade gravada aparecerá aqui. Um dia sem entradas não significa que nada aconteceu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь будет отображаться записанная активность. День без записей не означает, что ничего не произошло."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxqabadka la diiwaangeliyey halkan ka muuqan doonaa. Maalinta oo aan waxyaabo ku jira ma aha in waxba kama dhacay."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoạt động ghi lại sẽ xuất hiện ở đây. Một ngày không có mục nhập không có nghĩa là chẳng có gì xảy ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录的活动将出现在这里。 一天没有条目并不意味着什么都没发生。"
          }
        }
      }
    },
