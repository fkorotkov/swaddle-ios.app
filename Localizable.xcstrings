    "Check gestational age at birth in the child’s profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من عمر الحمل عند الولادة في ملف الطفل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la edad gestacional al nacer en el perfil del bebé."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سن بارداری هنگام تولد را در پروفایل کودک بررسی کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan ang gestational edad sa kapanganakan sa profile ng bata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l’âge gestationnel à la naissance dans le profil de l’enfant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जन्म के समय गर्भावस्था की आयु बच्चे के प्रोफ़ाइल में जाँचें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tcheke laj gestasyonèl nan nati a nan pwofil timoun nan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이의 프로필에서 출생 시 임신 연령을 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a idade gestacional no nascimento no perfil da criança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте гестационный возраст при рождении в профиле ребенка."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka hubi da'da uurka ee dhalashada profile-ka ilmaha."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra tuổi thai lúc sinh trong hồ sơ của trẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在孩子的个人资料中查看出生时的妊娠年龄。"
          }
        }
      }
    },
