      }
    },
    "Includes every child, existing history, and shared pumping. They can add, edit, or delete entries." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل كل طفل، التاريخ القائم، والمشاركة في إفراز لبن الثدي. يمكنهم إضافة أو تحرير أو حذف القيودات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye a todos los bebés, el historial existente y las extracciones compartidas. Puede añadir, editar o eliminar registros."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شامل همهٔ کودکان، سابقهٔ موجود و دوشیدن شیر مشترک است. آن‌ها می‌توانند ثبت‌ها را اضافه، ویرایش یا حذف کنند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasama ang bawat bata, kasalukuyang kasaysayan, at ibinahaging pag-pump. Maaari silang magdagdag, mag-edit, o magtanggal ng mga tala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprend chaque enfant, les antécédents existants et l'expression partagée de lait maternel.Ils peuvent ajouter, modifier ou supprimer des entrées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर बच्चा, मौजूदा इतिहास और साझा दूध निकालने के रिकॉर्ड शामिल हैं। वे प्रविष्टियाँ जोड़, बदल या मिटा सकते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkli tout timoun, istorik ki deja la, ak tire lèt pataje. Yo ka ajoute, modifye, oswa efase antre yo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 아이, 기존 이력 및 공유 유축 기록이 포함됩니다. 기록을 추가, 편집 또는 삭제할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui cada criança, histórico existente e extração compartilhada de leite materno.Eles podem adicionar, editar ou excluir entradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ ко всем детям, существующей истории и общим сцеживаниям. Можно добавлять, редактировать и удалять записи."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaa ku jira ilmo kasta, taariikhda jirta iyo lisidda caanaha la wadaago. Waxay ku dari karaan, beddeli karaan ama tirtiri karaan diiwaannada."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bao gồm mọi bé, lịch sử hiện có và bản ghi hút sữa chung. Người được mời có thể thêm, sửa hoặc xóa bản ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包括每个孩子、现有历史记录和共享的母乳抽取。 他们可以添加、编辑或删除条目。"
          }
        }
      }
    },
    "Includes existing history, new children, future activity, and shared pumping. Personal entry defaults stay private." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل السجل الموجود والأطفال الجدد والأنشطة القادمة وشفط الحليب المشترك. تبقى إعدادات التسجيل الشخصية خاصة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye el historial existente, nuevos bebés, actividad futura y extracciones compartidas. Las preferencias personales de registro siguen siendo privadas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شامل سابقهٔ موجود، کودکان جدید، فعالیت‌های آینده و دوشیدن شیر مشترک است. پیش‌فرض‌های شخصی ثبت، خصوصی می‌مانند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasama ang kasalukuyang kasaysayan, mga bagong bata, mga susunod na aktibidad, at ibinahaging pag-pump. Nananatiling pribado ang personal na default sa paglalagay ng tala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprend l’historique existant, les nouveaux enfants, les activités futures et les tirages partagés. Les préférences personnelles de saisie restent privées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा इतिहास, नए बच्चे, आगे की गतिविधि और साझा दूध निकालने के रिकॉर्ड शामिल हैं। प्रविष्टि की निजी डिफ़ॉल्ट सेटिंग्स निजी रहती हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkli istorik ki deja la, nouvo timoun, aktivite k ap vini yo, ak tire lèt pataje. Preferans pèsonèl pou antre done rete prive."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 이력, 새로 추가하는 아이, 앞으로의 활동 및 공유 유축 기록이 포함됩니다. 개인 입력 기본값은 비공개로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui o histórico existente, novas crianças, atividades futuras e extrações compartilhadas. As preferências pessoais de registro continuam privadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к существующей истории, новым детям, будущим записям и общим сцеживаниям. Личные значения по умолчанию остаются приватными."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaa ku jira taariikhda jirta, carruurta cusub, hawlaha mustaqbalka iyo lisidda caanaha la wadaago. Dejinta gaarka ah ee gelinta diiwaanka waa sir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bao gồm lịch sử hiện tại, trẻ con mới, hoạt động trong tương lai và chia sẻ việc hút sữa mẹ. Mặc định các mục nhập cá nhân vẫn giữ bí mật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包括现有历史、新添加的孩子、今后的活动和共享泵奶记录。个人录入默认值保持私密。"
          }
        }
      }
    },
