    "Can add children and record, edit, or delete shared entries across the family." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن إضافة الأطفال وتسجيل أو تحرير أو حذف القيود المشتركة عبر الأسرة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede añadir bebés y registrar, editar o eliminar entradas compartidas de toda la familia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "می‌تواند کودکان را اضافه کند و ثبت، ویرایش یا حذف مدخل‌های مشترک در سراسر خانواده را انجام دهد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaaring magdagdag ng mga anak at mag-record, mag-edit o magtanggal ng mga ibinahaging entry sa buong pamilya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut ajouter des enfants et enregistrer, modifier ou supprimer les entrées partagées dans la famille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बच्चों को जोड़ सकते हैं और परिवार में साझा प्रविष्टि को रिकॉर्ड, संपादित या मिटा सकते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka ajoute timoun yo ak enskri, modifye oswa efase entrées pataje atravè fanmi an."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자녀를 추가하고 가족 전체에서 공유된 항목을 기록, 편집 또는 삭제할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode adicionar crianças e gravar, editar ou excluir entradas compartilhadas em toda a família."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно добавлять детей и записывать, редактировать или удалять общие записи в семье."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad ku dari kartaa carruurta iyo diiwaanka, Edit, ama tirtirto qaybinta soo galaya qoyska oo dhan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể thêm trẻ em và ghi, chỉnh sửa hoặc xóa các mục chia sẻ trên toàn gia đình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
