          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم الوحدات الناقصة وحدة متسقة من التقرير، أو هذا الخيار إذا كان التقرير مختلطاً."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si faltan unidades, se usa una unidad coherente del informe, o esta opción si el informe mezcla unidades."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واحدهای گمشده از یک واحد ثابت از گزارش استفاده می‌کنند، یا این گزینه را انتخاب کنید اگر گزارش مخلوط باشد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawawalang mga yunit gamitin ang isang pare-pareho unit mula sa ulat, o ito pagpipilian kung ang ulat ay halo-halong."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les unités manquantes utilisent une unité cohérente du rapport, ou ce choix si le rapport est mixte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गुम इकाइयाँ रिपोर्ट से एक सुसंगत इकाई का उपयोग करती हैं, या यदि रिपोर्ट मिश्रित है तो यह विकल्प."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unite ki manke yo itilize yon unite konstan nan rapò a, oswa sa a chwa si rapò a se melanje."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누락된 단위는 보고서에서 일관된 단위를 사용하거나, 보고서가 혼합되어 있는 경우 이 선택을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unidades ausentes usam uma unidade consistente do relatório, ou esta opção se o relatório for misto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если единицы не указаны, используется единица, принятая во всём отчёте. Если в отчёте они разные, используется выбранная здесь."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qaybta ka maqan isticmaalaan mid isku mid ah oo ka tirsan warbixinta, ama doorashadan haddii warbixinta la isku daray."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các đơn vị thiếu sử dụng một đơn vị nhất quán từ báo cáo, hoặc lựa chọn này nếu báo cáo là hỗn hợp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺失单位使用报表中的一致单位,如果报表混合,则使用此选项。"
          }
        }
      }
    },
