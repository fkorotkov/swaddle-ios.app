          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका परिवार या iCloud खाता बदल गया है. जारी रखने के लिए परिवार साझा को फिर से खोलें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kont fanmi ou oswa kont iCloud ou te chanje. Re-ouvri Partage Famille pou kontinye."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족 또는 iCloud 계정이 변경되었습니다. 가족 공유를 다시 열어 계속합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
