    "We’re checking your invitation and looking for your caregiver profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحن نتحقق من دعوتك ونبحث عن بيانات مقدم الرعاية لديك"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos comprobando tu invitación y buscando tu perfil de cuidador."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در حال بررسی دعوت‌نامه و جست‌وجوی پروفایل مراقب شما هستیم."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinusuri namin ang iyong imbitasyon at naghahanap ng profile ng tagapag-alaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vérifions votre invitation et recherchons votre profil de soignant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम आपका निमंत्रण जाँच रहे हैं और आपकी देखभालकर्ता प्रोफ़ाइल खोज रहे हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nou ap tcheke envitasyon w lan epi nou ap chèche profil moun k ap pran swen ou a."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저희는 귀하의 초대장을 확인하고 귀하의 간호사 프로필을 찾고 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos a verificar o seu convite e à procura do seu perfil de cuidador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяем приглашение и ищем ваш профиль участника."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaan hubinaynaa casuumaaddaada oo raadinaynaa astaantaada daryeele."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
