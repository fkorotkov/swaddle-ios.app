    "A family editor can add a birth date and choose a growth reference in the child’s profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويمكن لمحرر الأسرة أن يضيف تاريخ ميلاد وأن يختار مرجع نمو في ملف الطفل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una persona con permiso de edición puede añadir la fecha de nacimiento y elegir una referencia de crecimiento en el perfil del bebé."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک ویرایشگر خانواده می‌تواند تاریخ تولد را اضافه کند و یک مرجع رشد در پروفایل کودک انتخاب کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
