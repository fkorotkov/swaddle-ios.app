    "Your own profile and the family owner’s profile can’t be deleted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن حذف ملف تعريفك الشخصي وملف تعريف مالك الأسرة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes eliminar tu propio perfil ni el del propietario de la familia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروفایل خودتان و پروفایل صاحب خانواده را نمی‌توان حذف کرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi maaaring tanggalin ang iyong sariling profile at ang profile ng may-ari ng pamilya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre propre profil et celui du propriétaire de la famille ne peuvent pas être supprimés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका अपना प्रोफ़ाइल और परिवार मालिक का प्रोफ़ाइल मिटाया नहीं जा सकता है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa gen okenn fason pou ou efase pwofil ou oswa pwofil pwopriyetè fanmi an."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 프로필과 가족 소유자의 프로필은 삭제할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu próprio perfil e o do proprietário da família não podem ser excluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш собственный профиль и профиль владельца семьи удалять нельзя."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilekaaga gaarka ah iyo profile-ka mulkiilaha qoyska lama tirtiri karo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xóa hồ sơ cá nhân của bạn và hồ sơ chủ sở hữu gia đình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您自己的个人资料和家庭所有者的个人资料不能被删除。"
          }
        }
      }
    },
