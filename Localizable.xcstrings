    "Left and right must add up to the total within 0.01 mL. Leave both blank for a total-only session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يضاف اليسار واليمين إلى المجموع في حدود 0.01 مللتر. اتركهما فارغين لدورة المجموع فقط."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suma de ambos lados debe coincidir con el total con una tolerancia de 0.01 mL. Deja ambos vacíos para una sesión con solo el total."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجموع چپ و راست باید با اختلاف حداکثر ۰٫۰۱ mL برابر کل باشد. برای ثبت فقط مجموع، هر دو را خالی بگذارید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaliwa at kanan ay dapat magdagdag ng hanggang sa kabuuan sa loob 0.01 mL. Mag-iwan ng parehong blanko para sa isang kabuuang session lamang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La somme des volumes gauche et droit doit correspondre au total à 0,01 mL près. Laissez les deux champs vides pour enregistrer uniquement le total."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाईं और दाईं मात्रा का जोड़ कुल से 0.01 mL के भीतर मेल खाना चाहिए। केवल कुल दर्ज करने के लिए दोनों खाली छोड़ें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwoup ki nan gòch ak dwa yo dwe ajoute pou total la nan 0.01 mL. kite tou de blan pou yon sesyon total-se sèlman."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좌우 양의 합이 총량과 0.01 mL 이내로 일치해야 합니다. 총량만 기록하려면 양쪽을 모두 비워 두세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A soma dos volumes esquerdo e direito deve coincidir com o total, com tolerância de 0,01 mL. Deixe ambos vazios para registrar só o total."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумма объёмов слева и справа должна совпадать с общим объёмом с точностью до 0,01 мл. Если известен только общий объём, оставьте оба поля пустыми."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wadarta bidix iyo midig waa inay wadarta guud la mid noqotaa iyadoo farqigu uusan ka badnayn 0.01 mL. Labadaba bannaan ka tag haddii wadarta keliya la hayo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tổng lượng bên trái và phải phải khớp tổng lượng với sai số không quá 0.01 mL. Nếu chỉ ghi tổng lượng, để trống cả hai bên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右奶量之和须与总量相差不超过0.01 mL。只记录总量时，请将左右两项留空。"
          }
        }
      }
    },
    "Left and right must be nonnegative and add up to totalML within 0.01 mL." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب ألا تكون كميتا اليسار واليمين سالبتين وأن يطابق مجموعهما totalML ضمن 0.01 mL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores de ambos lados deben ser no negativos y sumar totalML con una tolerancia de 0.01 mL."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چپ و راست نباید منفی باشند و مجموعشان باید با اختلاف حداکثر ۰٫۰۱ mL برابر totalML باشد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaliwa at kanan ay dapat na nonnegative at magdagdag ng hanggang sa totalML sa loob 0.01 mL."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les volumes gauche et droit doivent être positifs ou nuls et leur somme doit correspondre à totalML à 0,01 mL près."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाईं और दाईं मात्रा ऋणात्मक नहीं होनी चाहिए और उनका जोड़ totalML से 0.01 mL के भीतर मेल खाना चाहिए।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kantite bò gòch ak bò dwat yo pa ka negatif; sòm yo dwe egal totalML ak yon diferans ki pa depase 0.01 mL."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좌우 양은 음수가 아니어야 하며, 합이 totalML과 0.01 mL 이내로 일치해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os volumes esquerdo e direito não podem ser negativos e sua soma deve coincidir com totalML, com tolerância de 0,01 mL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объёмы для левой и правой груди не должны быть отрицательными и в сумме должны совпадать с totalML с точностью до 0.01 мл."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidix iyo midig waa inay noqdaan tirooyin aan tabanayn, wadartooduna totalML ha la mid noqoto iyadoo farqigu uusan ka badnayn 0.01 mL."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lượng trái và phải phải không âm, cộng lại khớp totalML với sai số không quá 0.01 mL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右值须为非负数，且总和与totalML相差不超过0.01 mL。"
          }
        }
      }
    },
    "Left and right volumes must add up to the total." : {
      "localizations" : {
        "ar" : {
