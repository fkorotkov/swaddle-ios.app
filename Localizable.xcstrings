    "Breastfeeding: %lld seconds. Breastfeeding time is separate from bottle volume." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرضاعة الطبيعية: %lld ثانية، مدة الرضاعة الطبيعية منفصلة عن حجم زجاجة الرضيع."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lactancia: %lld segundos. El tiempo de lactancia se registra por separado del volumen de biberón."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شیردهی: %lld ثانیه. زمان شیردهی از حجم بطری جداست."
          }
        },
        "fil" : {
