    "breastMilkML + formulaML must equal totalML (within 0.01 mL for rounding)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يساوي breastMilkML + formulaML القيمة totalML، بفارق لا يتجاوز 0.01 mL بسبب التقريب."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML debe ser igual a totalML (con tolerancia de 0.01 mL por redondeo)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجموع breastMilkML + formulaML باید برابر totalML باشد؛ اختلاف ناشی از گرد کردن حداکثر 0.01 mL مجاز است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML ay dapat pantay totalML (sa loob ng 0.01 mL para sa rounding)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML doit être égal à totalML, avec une tolérance de 0,01 mL pour l’arrondi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML का योग totalML के बराबर होना चाहिए (राउंडिंग के लिए अधिकतम 0.01 mL का अंतर मान्य है)।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML dwe egal a totalML (nan 0.01 mL pou arrondissement)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML 은 totalML과 같아야 합니다(반올림을 위해 0.01 mL 이내)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML deve ser igual a totalML, com tolerância de 0,01 mL para arredondamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML должны быть равны totalML (в пределах 0.01 мЛ для округления)."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML waa in ay la mid yihiin totalML (gudaha 0.01 mL u wareegsan)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML phải bằng totalML (trong 0.01 mL cho tròn)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML + formulaML 必须等于 totalML(四舍五入在 0.01 mL 以内 ) 。"
          }
        }
      }
    },
    "breastMilkML and formulaML must be nonnegative numbers with a positive combined volume." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويجب أن يكون breastMilkML و formulaML أرقاماً غير سالبة ذات حجم مشترك موجب."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML y formulaML deben ser números no negativos con un volumen combinado positivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML و formulaML باید اعداد غیر منفی با حجم ترکیبی مثبت باشند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML at formulaML ay dapat na nonnegative numero sa isang positibong pinagsamang dami."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML et formulaML doivent être des nombres non négatifs avec un volume combiné positif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML और formulaML धनात्मक संयुक्त आयतन के साथ गैर- ऋणात्मक संख्याएँ होनी चाहिए."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML ak formulaML dwe nonnegative nimewo ak yon pozitif konbinezon volim."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breastMilkML 과 formulaML 은 반드시 음수가 아닌 양의 결합된 부피를 가진 수여야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
