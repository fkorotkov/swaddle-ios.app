    "Included in total intake. No milk or formula amount is guessed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحتسب ضمن إجمالي الكمية المتناولة. لا تُخمَّن كمية حليب الأم أو الحليب الصناعي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluido en el consumo total. No se estima ninguna cantidad de leche o fórmula."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در مجموع شیر مصرف‌شده حساب می‌شود. مقدار شیر مادر یا شیر خشک حدس زده نمی‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasama sa kabuuang pagkonsumo. Walang gatas o formula halaga ng gatas ay hulaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclus dans l'apport total. Aucune quantité de lait ou de préparation n'est estimée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुल आहार में शामिल. कोई दूध या फार्मूला दूध की मात्रा अनुमानित नहीं है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkli nan total lèt bwè a. Nou pa devine kantite lèt manman oswa lèt fòmil."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "총 섭취량에 포함되어 있습니다. 우유 또는 유제품의 양은 추측하지 않습니다."
