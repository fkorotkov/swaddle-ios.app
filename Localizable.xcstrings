    "iCloud hasn’t returned your invitation details yet. Check again, or reopen the original invitation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يرسل iCloud تفاصيل دعوتك بعد. تحقق مرة أخرى، أو أعيد فتح الدعوة الأصلية."
          }
        },
        "es" : {
