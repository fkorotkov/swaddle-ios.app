    "Send this link to %@. Access starts when they accept using their Apple Account. Creating the link doesn’t send a message." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل هذا الرابط إلى %@. يبدأ الوصول عندما يقبلون باستخدام حساب Apple الخاص بهم. إنشاء الرابط لا يرسل رسالة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía este enlace a %@. El acceso empieza cuando lo acepta con su Cuenta de Apple. Crear el enlace no envía un mensaje."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارسال این پیوند به %@. دسترسی زمانی آغاز می‌شود که آن‌ها استفاده از حساب اپل خود را بپذیرند. ایجاد پیوند پیامی نمی‌فرستد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipadala ang link na ito sa %@. Magsisimula ang pag-access kapag tinanggap nila ang paggamit ng kanilang Apple Account. Hindi nagpapadala ng mensahe ang paglikha ng link."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez ce lien à %@. L’accès commence lorsqu’il accepte d’utiliser son compte Apple. La création du lien n’envoie pas de message."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस लिंक को %@ को भेजें. पहुँच शुरू होता है जब वे अपने Apple खाता का उपयोग स्वीकार करते हैं. लिंक बनाने से कोई संदेश नहीं भेजा जाता है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoye lyen sa a bay %@. Akses la kòmanse lè yo aksepte sèvi ak Kont Apple yo. Kreye lyen an pa voye yon mesaj."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에게 이 링크를 보내십시오. Apple 계정을 사용하는 것을 수락하면 액세스가 시작됩니다. 링크를 생성해도 메시지는 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie este link para %@. O acesso começa quando ele aceita usar sua Conta Apple.A criação do link não envia uma mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправьте ссылку: %@. Доступ появится после принятия приглашения через собственный Аккаунт Apple. Создание ссылки не отправляет сообщение."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xiriirkan u dir %@. Gelitaanku wuxuu bilaabmaa marka ay ku aqbalaan akoonkooda Apple. Abuurista xiriirku fariin ma dirto."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi liên kết này đến %@. Truy cập bắt đầu khi họ chấp nhận sử dụng tài khoản Apple của họ. Việc tạo liên kết không gửi một thông điệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此链接发送给%@。对方使用自己的Apple账户接受邀请后即可访问。创建链接不会发送消息。"
          }
        }
      }
    },
    "Separate from bottle intake. Original notes and exact amounts are kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منفصلة عن زجاجة الرضيع ويتم الاحتفاظ بالملاحظات الأصلية والكميات الدقيقة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separado del consumo de biberón. Se conservan las notas originales y las cantidades exactas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جدا از شیر مصرف‌شده با شیشه. یادداشت اصلی و مقدار دقیق حفظ می‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiwalay mula sa baby bottle intake. Orihinal na mga tala at eksaktong halaga ay pinananatili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptabilisé séparément du lait consommé au biberon. Les notes d’origine et les quantités exactes sont conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेबी बोतल के सेवन से अलग. मूल नोट्स और सटीक मात्राओं को रखा जाता है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separe ak kantite lèt nan bibwon. Nòt orijinal ak kantite egzak yo rete menm jan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "젖병 섭취량과 별도로 기록됩니다. 원래 메모와 정확한 양이 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contabilizado separadamente do leite consumido por mamadeira. As notas originais e as quantidades exatas são preservadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитывается отдельно от питания из бутылочки. Исходные заметки и точные объёмы сохраняются."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Way ka gaar tahay caanaha dhalada laga cabbay. Qoraallada asalka ah iyo qaddarrada saxda ah waa la hayaa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tách biệt với lượng bú bình. Ghi chú gốc và lượng chính xác được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与奶瓶摄入量分开记录。保留原始笔记和精确数值。"
          }
        }
      }
    },
