    "View the family’s participants or leave the shared log using Apple’s sharing controls." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انظر إلى المشاركين في العائلة أو ترك السجل المشترك باستخدام ضوابط التشارك في آبل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta los participantes de la familia o abandona el diario compartido con los controles de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شرکت‌کنندگان خانواده را مشاهده کنید یا با استفاده از کنترل‌های اشتراک گذاری اپل ثبت مشترک را ترک کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan ang mga kalahok ng pamilya o iwanan ang ibinahaging log gamit ang mga control sa pagbabahagi ng Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez les membres de la famille ou quittez le journal partagé à l’aide des commandes de partage d’Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिवार के प्रतिभागियों को देखें या Apple के साझा नियंत्रणों का उपयोग करके साझा लॉग छोड़ दें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gade patisipan fanmi an oswa kite rejis pataje a lè w itilize kontwolè pataje Apple."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 공유 제어 기능을 사용하여 가족 참여자를 확인하거나 공유 로그를 떠날 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja os participantes da família ou deixe o registro compartilhado usando os controles de compartilhamento da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просмотреть участников семьи или выйти из общего журнала можно через элементы управления общим доступом Apple."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daawo ka qaybgalayaasha qoyska ama iskaga tag diiwaanka la wadaago adoo isticmaalaya maareynta Apple ee kala qaybinta."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng các điều khiển chia sẻ của Apple để xem thành viên gia đình hoặc rời nhật ký chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 的共享控件查看家庭成员或离开共享日志。"
          }
        }
      }
    },
