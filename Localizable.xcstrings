    "Add a birth date to compare measurements by age." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف تاريخ ميلاد لمقارنة القياسات حسب العمر."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una fecha de nacimiento para comparar medidas por edad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاریخ تولد را برای مقایسه اندازه‌گیری‌ها بر اساس سن اضافه کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng isang petsa ng kapanganakan upang ihambing ang mga sukat sa pamamagitan ng edad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une date de naissance pour comparer les mesures par âge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आयु के अनुसार मापों की तुलना करने के लिए जन्म तिथि जोड़ें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute yon dat nesans pou konpare mezi pa laj."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나이별로 측정값을 비교하려면 생년월일을 추가합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma data de nascimento para comparar medidas por idade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте дату рождения, чтобы сравнить измерения по возрасту."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku dar taariikhda dhalashada si cabbirrada da' ahaan loo barbar dhigo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một ngày sinh để so sánh các đo đạc theo tuổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加出生日期以按年龄比较测量值。"
          }
        }
      }
    },
