          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم الأدوات وSiri سجل عائلتك، وليس العرض التجريبي."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویجت‌ها و Siri از دفتر خانوادهٔ خودتان استفاده می‌کنند، نه نسخهٔ نمایشی."
          }
