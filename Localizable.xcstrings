    "Breast milk, formula, and breastfeeding time for the last 24 hours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حليب الأم والحليب الصناعي ومدة الرضاعة الطبيعية خلال آخر 24 ساعة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leche materna, fórmula y tiempo de lactancia de las últimas 24 horas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شیر مادر، شیر خشک و زمان شیردهی در ۲۴ ساعت گذشته."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breast milk, formula ng gatas, at breastfeeding oras para sa huling 24 na oras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lait maternel, le lait maternisé et la durée de l'allaitement au cours des 24 dernières heures."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्तन दूध, फार्मूला दूध और पिछले 24 घंटों के लिए स्तनपान का समय।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lèt manman, lèt fòmil, ak tan bay tete nan dènye 24 èdtan yo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난 24시간 동안의 모유량, 분유량, 모유 수유 시간입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leite materno, leite de fórmula e tempo de amamentação nas últimas 24 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грудное молоко, смесь и время кормления грудью за последние 24 часа."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caanaha naaska, caanaha booraha iyo wakhtiga naasnuujinta ee 24-kii saac ee u dambeeyey."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sữa mẹ, sữa công thức và thời gian cho con bú trong 24 giờ qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "母乳,配方奶和哺乳时间的最后 24 小时。"
          }
        }
      }
    },
