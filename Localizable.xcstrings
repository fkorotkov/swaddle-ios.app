        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版本号及其家族具有不同的 iCloud 区域"
          }
        }
      }
    },
    "A saved record differs from its iCloud copy. The sync upgrade is paused to preserve both versions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختلف السجل المحفوظ عن نسخته iCloud. ويُعلق تحديث التزامن للحفاظ على النسختين."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un registro guardado difiere de su copia en iCloud. La actualización de sincronización está en pausa para conservar ambas versiones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رکورد ذخیره‌شده با نسخهٔ iCloud آن فرق دارد. ارتقای همگام‌سازی برای حفظ هر دو نسخه متوقف شده است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang isang naka-save na talaan ay naiiba mula sa kopya nito sa iCloud. Pinapahinga ang pag-upgrade ng sync upang mapanatili ang parehong bersyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enregistrement diffère de sa copie iCloud. La mise à niveau de la synchronisation est suspendue pour préserver les deux versions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजा गया रिकॉर्ड उसकी iCloud कॉपी से अलग है। दोनों संस्करणों को सुरक्षित रखने के लिए सिंक अपग्रेड रुका हुआ है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon dosye ki te sove diferan de li iCloud Kopi. Mizajou sinkronize a mete an pausa pou pwoteje tou de vèsyon yo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 레코드는 iCloud 사본과 다릅니다. 동기화 업그레이드가 일시 중지되어 두 버전을 모두 보존합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um registro salvo difere de sua cópia do iCloud.A atualização da sincronização é pausada para preservar ambas as versões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраненная запись отличается от ее копии в iCloud. Обновление синхронизации приостанавливается, чтобы сохранить обе версии."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diiwaan kaydsan ayaa ka duwan nuqulkiisa iCloud. Casriyeynta isku-xirka waa la hakiyey si labada nuqulba loo ilaaliyo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ghi chép đã lưu khác với bản sao iCloud của nó. Cập nhật đồng bộ sẽ bị tạm dừng để giữ cả hai phiên bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的记录与其 iCloud 副本不同。 同步升级暂停以保留两个版本。"
          }
        }
      }
    },
    "A shared record of feeding, changes, and growing. One less thing to remember." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجل مشترك للرضعات وتغيير الحفاض والنمو. أمر أقل لتتذكره."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un registro compartido de tomas, cambios y crecimiento. Una cosa menos que recordar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دفتر مشترک تغذیه، تعویض پوشک و رشد؛ یک چیز کمتر برای به‌خاطر سپردن."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magkakasamang tala ng pagpapakain, pagpapalit ng diaper, at paglaki. Mas kaunti ang kailangang tandaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un récit partagé de l’alimentation, des changements et de la croissance. Une chose en moins à retenir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूध पिलाने, डायपर बदलने और बढ़ने का साझा रिकॉर्ड। याद रखने की एक बात कम।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon dosye pataje sou manje, chanjman, ak kwasans. Yon bagay mwens pou sonje."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수유, 기저귀 교체, 성장을 함께 기록하세요. 기억해야 할 일이 하나 줄어듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um registro compartilhado de alimentação, mudanças e crescimento. Uma coisa a menos para lembrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общий дневник кормлений, подгузников и роста. На одну заботу меньше."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taariikh wadaaga cuntada, isbedelada, iyo koritaanka. Mid ka yar wax in la xusuusto."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cùng ghi lại việc cho bú, thay tã và lớn lên. Bớt một điều phải ghi nhớ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与家人共享喂养、换尿布和成长记录。少一件需要记在心里的事。"
          }
        }
      }
    },
    "A similar entry already exists or appears earlier in this report. Excluded unless you select it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد سجل مشابه مسبقًا أو ظهر في موضع سابق من التقرير. سيُستبعد ما لم تحدده."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un registro similar o aparece antes en este informe. Se excluye salvo que lo selecciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک مدخل مشابه از قبل در این گزارش وجود دارد یا پیشتر ظاهر شده است. حذف می‌شود مگر اینکه آن را برگزینید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang isang katulad na entry ay umiiral na o lilitaw mas maaga sa ulat na ito. Hindi kasama maliban kung piliin mo ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une entrée similaire existe déjà ou apparaît précédemment dans ce rapport.Exclu à moins que vous ne la sélectionniez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसी प्रविष्टि पहले से है या इस रिपोर्ट में पहले आई है। आपके चुने बिना इसे शामिल नहीं किया जाएगा।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon entwodiksyon ki sanble deja egziste oswa ap parèt pi bonè nan rapò sa a. Eksklize si ou pa chwazi li."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보고서에 유사한 항목이 이미 존재하거나 이전에 나타났습니다. 선택하지 않으면 제외됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma entrada semelhante já existe ou aparece anteriormente neste relatório. Excluído, a menos que você o selecione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похожая запись уже существует или появилась ранее в этом отчете. Исключается, если не выбрана."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entry la mid ah ayaa hadda jira ama soo muuqan hore ee warbixintan. ka maqan haddii aadan dooran."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một mục tương tự đã tồn tại hoặc xuất hiện trước đây trong báo cáo này. Bỏ qua trừ khi bạn chọn nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "类似的条目已经存在或在此报表中出现。 排除,除非您选择它。"
          }
        }
      }
    },
    "A sitting baby leans on their hands for support." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طفلة جالسة تستند على يديهم للدعم."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bebé sentado se apoya en las manos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک کودک نشسته بر روی دست‌هایش برای حمایت تکیه می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang isang nakaupo baby leans sa kanilang mga kamay para sa suporta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bébé assis prend appui sur ses mains."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैठा हुआ बच्चा सहारे के लिए अपने हाथों पर झुकता है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon tibebe ki chita apiye sou men li pou sipò."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앉아 있는 아기가 지원을 위해 그들의 손에 기대고 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um bebê sentado se apoia em suas mãos para apoio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Малыш сидит, опираясь на руки."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fadhiistay ilmaha ku tiirsan gacmahooda si ay u taageeraan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một đứa trẻ ngồi dựa vào tay để hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个坐着的婴孩靠在他们的手上为支持。"
          }
        }
      }
    },
    "A sound catches a baby’s attention and their expression changes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن الصوت يلفت انتباه الطفل ويغير تعبيره."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sonido llama la atención de un bebé y cambia su expresión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک صدا توجه نوزاد را جلب می‌کند و بیان او تغییر می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang isang tunog ay nakakaakit ng pansin ng sanggol at ang kanilang ekspresyon ay nagbabago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un son attire l’attention d’un bébé et son expression change."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक आवाज़ बच्चे का ध्यान खींचती है और उसके चेहरे का भाव बदलता है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yon son kapte atansyon yon tibebe ak ekspresyon yo chanje."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소리가 아기의 관심을 끌고 그들의 표정이 변화."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um som chama a atenção de um bebê e sua expressão muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук привлекает внимание ребенка, и его выражение лица меняется."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codku waa in uu soo jiito dareenka ilmaha, isla markaana muujintooda ay is beddelaan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một âm thanh thu hút sự chú ý của một đứa trẻ và biểu cảm của chúng thay đổi."
