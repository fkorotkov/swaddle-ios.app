    "Only invited people can join. An Apple Family Sharing group isn’t required." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن الانضمام إلا بدعوة. لا حاجة إلى مجموعة «المشاركة العائلية» من Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
