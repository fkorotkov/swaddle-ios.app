          "stringUnit" : {
            "state" : "translated",
            "value" : "आज तक की तारीख वाले मापों के लिए प्रतिशतक उपलब्ध हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persentyèl yo disponib pou mezire jiska jodi a."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘까지의 측정값에 대해 백분위를 확인할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os percentis estão disponíveis para medições até hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процентили доступны для измерений не позднее сегодняшнего дня."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darajooyinka boqolleeyda waxaa loo heli karaa cabbirrada ilaa maanta."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bách phân vị có sẵn cho các số đo đến ngày hôm nay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "百分位数可用于迄今为止的测量。"
          }
        }
      }
    },
    "Percentiles are rounded estimates, not a diagnosis. Your pediatrician considers the full growth pattern and other measurements." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المئينات تقديرات مقربة وليست تشخيصًا. ينظر طبيب الأطفال إلى نمط النمو الكامل والقياسات الأخرى."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los percentiles son estimaciones redondeadas, no un diagnóstico. Tu pediatra considera el patrón completo de crecimiento y otras medidas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدک‌ها برآوردهای گرد‌شده‌اند، نه تشخیص پزشکی. پزشک کودکتان الگوی کامل رشد و اندازه‌گیری‌های دیگر را در نظر می‌گیرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga percentile ay mga pagtatantiyang ni-round, hindi diagnosis. Isinasaalang-alang ng pediatrician ang buong pattern ng paglaki at iba pang mga sukat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les percentiles sont des estimations arrondies, pas un diagnostic. Votre pédiatre tient compte de l’ensemble de la courbe de croissance et des autres mesures."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रतिशतक अनुमानित और पूर्णांकित मान हैं, निदान नहीं। आपके बाल रोग विशेषज्ञ पूरे वृद्धि पैटर्न और अन्य मापों को ध्यान में रखते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pèsantil yo se estimasyon awondi, yo pa yon dyagnostik. Pedyat ou a konsidere tout modèl kwasans lan ak lòt mezi yo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백분위는 반올림한 추정치이며 진단이 아닙니다. 소아과 의사는 전체 성장 양상과 다른 측정값을 함께 고려합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os percentis são estimativas arredondadas, não um diagnóstico. O pediatra considera o padrão completo de crescimento e outras medidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процентили — округлённые оценки, а не диагноз. Педиатр учитывает всю динамику роста и другие измерения."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darajooyinka boqolleeydu waa qiyaaso la soo koobay, mana aha ogaansho caafimaad. Dhakhtarka carruurtu wuxuu tixgeliyaa qaabka koritaanka oo dhan iyo cabbirrada kale."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bách phân vị là các ước tính được làm tròn, không phải chẩn đoán. Bác sĩ nhi khoa xem xét toàn bộ xu hướng tăng trưởng và các số đo khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "百分位是取整后的估计值，并非诊断。儿科医生会综合考虑整个生长趋势和其他测量值。"
          }
        }
      }
    },
