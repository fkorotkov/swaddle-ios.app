    },
    "To keep your records and remove access instead, use Invite or manage caregivers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للاحتفاظ بسجلاتك وإزالة الوصول بدلا من ذلك، استخدم دعوة أو إدارة مقدمي الرعاية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para conservar los registros y solo quitar el acceso, usa Invitar o gestionar cuidadores."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای حفظ سوابق خود و حذف دسترسی به جای آن، از دعوت یا مدیریت مراقبان استفاده کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upang panatilihin ang iyong mga tala at alisin ang access sa halip, gamitin ang Mag-imbita o pamahalaan ang mga tagapag-alaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour conserver vos dossiers et supprimer l'accès, utilisez Inviter ou gérer les aidants naturels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने रिकॉर्ड रखने और इसके बजाय पहुँच हटाने के लिए, निमंत्रित करें या देखभालकर्ताओं का प्रबंधन करें का उपयोग करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pou kenbe dosye w yo epi retire aksè nan plas sa a, sèvi ak Konvite oswa jere moun k ap pran swen ou."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록을 유지하고 대신 액세스를 제거하려면 보호자 초대 또는 관리를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para manter seus registros e remover o acesso, use Convidar ou gerenciar cuidadores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы сохранить записи и только убрать доступ, откройте «Приглашения и участники»."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aad u ilaaliso diiwaanadaada oo aad uga saarto helitaanka, isticmaal Ku marti qaad ama maamul caawiyayaasha."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để giữ lại hồ sơ của bạn và loại bỏ quyền truy cập thay vào đó, sử dụng Mời hoặc quản lý người chăm sóc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要保留您的记录并移除访问权限,请使用邀请或管理护理人员 。"
          }
        }
      }
    },
