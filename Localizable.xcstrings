    "Record a bottle of breast milk, formula, or both. Ask for missing amounts and units before saving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل زجاجة لبن الأم أو حليب الأطفال أو كليهما، والسؤال عن الكميات والوحدات المفقودة قبل حفظها."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un biberón de leche materna, fórmula o ambas. Pregunta por las cantidades y unidades que falten antes de guardar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبت یک بطری شیر مادر، شیر مصنوعی یا هر دو. قبل از ذخیره مقدار و واحدهای گم‌شده را بپرسید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itala ang isang baby bottle ng breast milk, formula milk, o pareho. Magtanong para sa mga nawawalang halaga at yunit bago i-save."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez un biberon de lait maternel, de lait artificiel ou les deux et demandez les quantités et les unités manquantes avant d’enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्तन दूध, फार्मूला दूध या दोनों के लिए एक बच्चे की बोतल रिकॉर्ड करें. सहेजना से पहले गुम मात्रा और इकाइयों के लिए पूछें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrejistre yon bibwon lèt manman, lèt fòmil, oswa tou le de. Mande kantite ak inite ki manke yo anvan ou sove."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모유, 분유 또는 둘 다 포함된 젖병 수유를 기록합니다. 저장하기 전에 빠진 양과 단위를 물어봅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre um biberão de leite materno, leite em pó ou ambos e peça as quantidades e unidades que faltam antes de salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записать бутылочку грудного молока, смеси или обоих компонентов. Перед сохранением запросить недостающие объёмы и единицы измерения."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diiwaangeli dhalo caanaha naaska, caanaha booraha ama labadaba leh. Weydii qaddarrada iyo unugyada maqan ka hor kaydinta."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi lại một chai sữa mẹ, sữa công thức hoặc cả hai. Hỏi về số lượng và đơn vị thiếu trước khi lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录婴儿奶瓶里的母乳、配方奶或两者。 在保存前询问缺少的数量和单位。"
          }
        }
      }
