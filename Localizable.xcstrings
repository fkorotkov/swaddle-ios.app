          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez en revue les séances d’expression du lait maternel pour un soignant à la fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार में एक देखभालकर्ता के दूध निकालने के सत्रों की समीक्षा करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revize sesyon tire lèt pou yon sèl moun k ap bay swen alafwa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번에 한 보호자의 유축 기록을 검토하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise as sessões de extração do leite materno para um cuidador por vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяйте сцеживания только одного участника за раз."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mar kasta dib u eeg kalfadhiyada lisidda caanaha ee hal daryeele."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra các lần hút sữa của từng người chăm sóc một."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次检查一位照护者的泵奶记录。"
          }
        }
      }
    },
    "Review the other caregiver’s competing edits before merging." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع تعديلات مقدم الرعاية الآخر المتعارضة قبل الدمج."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa los cambios en conflicto del otro cuidador antes de combinar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از ادغام، ویرایش‌های متعارض مراقب دیگر را بررسی کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan ang mga nakikipagkumpitensya na edit ng ibang tagapag-alaga bago magsama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Examinez les modifications concurrentes de l’autre soignant avant de fusionner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिलाने से पहले दूसरे देखभालकर्ता के टकराते बदलावों की समीक्षा करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gade modifye konpetitif lòt moun ki bay swen an anvan ou fusionne."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "병합하기 전에 다른 보호자의 충돌하는 수정 사항을 검토하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise as edições concorrentes do outro cuidador antes de mesclar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед объединением проверьте конфликтующие изменения другого участника."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dib u eegista edits tartanka kale ee daryeelayaasha ka hor isku xirka."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem các chỉnh sửa xung đột của người chăm sóc kia trước khi hợp nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合并前，请检查另一位照护者有冲突的编辑。"
          }
        }
      }
    },
