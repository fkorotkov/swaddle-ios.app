        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطوط وزن‌های ثبت شده را به هم متصل می‌کنند؛ آنها وزن‌ها را بین ورودی‌ها تخمین نمی‌زنند."
          }
        },
        "fil" : {
