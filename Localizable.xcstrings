    "Record the moment. Hear the answer. Keep your attention on your baby." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل اللحظة، إسمع الإجابة، و إبقي انتباهك على طفلك"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra el momento. Escucha la respuesta. Sigue pendiente de tu bebé."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لحظه را ثبت کنید، پاسخ را بشنوید و توجهتان را به کودک نگه دارید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-record ang sandali. Makinig sa sagot. Panatilihin ang iyong pansin sa iyong sanggol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez le moment, écoutez la réponse et concentrez-vous sur votre bébé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस पल को रिकॉर्ड करो, जवाब सुनो और अपने बच्चे पर ध्यान केंद्रित करो."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enskri moman an, tande repons lan, kenbe atansyon w sou pitit ou."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 순간을 기록하고, 대답을 들어보고, 아기에게만 관심을 가져라."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grave o momento, ouça a resposta e mantenha sua atenção no bebê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите момент. Услышьте ответ. Всё внимание — малышу."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diiwaangeli daqiiqadda. Dhegayso jawaabta. Diiraddaada ku hay ilmahaaga."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi lại khoảnh khắc đó, nghe câu trả lời và tập trung vào đứa bé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录这一刻,听到答案,把注意力集中在宝宝身上。"
          }
        }
      }
    },
