    " Also %lld breastfeeding %@, %@ recorded. Breastfeeding time isn’t converted to volume." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " وكذلك %lld %@ للرضاعة الطبيعية، بمدة مسجلة %@. لا تُحوّل مدة الرضاعة إلى كمية حليب."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : " Also %1$lld breastfeeding %2$@, %3$@ recorded. Breastfeeding time isn’t converted to volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Además, %1$lld %2$@ de lactancia, con %3$@ registrados. El tiempo de lactancia no se convierte en volumen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " همچنین %lld %@ شیردهی، با مدت ثبت‌شدهٔ %@. زمان شیردهی به حجم تبدیل نمی‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Mayroon ding %lld pagpapasuso %@, %@ ang naitala. Hindi ginagawang dami ng gatas ang oras ng pagpapasuso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Également %1$lld %2$@ d’allaitement, pour une durée de %3$@. La durée d’allaitement n’est pas convertie en volume."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " साथ ही स्तनपान के %lld %@, %@ दर्ज। स्तनपान का समय दूध की मात्रा में नहीं बदला जाता।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Epitou %lld sesyon bay tete %@, %@ anrejistre. Nou pa konvèti tan bay tete an volim."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또한 %lld 모유 수유 %@, %@ 기록.모유 수유 시간은 볼륨으로 변환되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Também %1$lld %2$@ de amamentação, com duração de %3$@. O tempo de amamentação não é convertido em volume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Также %1$lld %2$@ грудью общей длительностью %3$@. Время кормления грудью не пересчитывается в объём."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Sidoo kale %lld naasnuujin %@, %@ la diiwaangeliyey. Waqtiga naasnuujinta looma beddelo mug."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also %lld breastfeeding %@, %@ recorded. Thời gian cho con bú không được chuyển đổi thành thể tích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 还有 %lld 母乳喂养 %@, %@ 记录在案。 哺乳时间不转换为体积。"
