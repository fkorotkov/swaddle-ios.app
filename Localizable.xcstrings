    "Use nonnegative pounds and ounces from 0 to less than 16." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل قيمة غير سالبة للأرطال، وقيمة للأوقيات من 0 إلى أقل من 16."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa libras no negativas y onzas entre 0 y menos de 16."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقدار پوند باید نامنفی و مقدار اونس از 0 تا کمتر از 16 باشد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi maaaring negatibo ang pounds; dapat mula 0 hanggang mas mababa sa 16 ang ounces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez des livres et des onces non négatives de 0 à moins de 16."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पाउंड ऋणात्मक नहीं होने चाहिए और औंस 0 से लेकर 16 से कम होने चाहिए।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sèvi ak liv nonnegatif ak onz soti nan 0 a mwens pase 16."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파운드는 음수가 아니어야 하며 온스는 0 이상 16 미만이어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use libras e onças não negativas de 0 a menos de 16."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фунты должны быть неотрицательными, унции — от 0 до значения меньше 16."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isticmaal rodol aan tabanayn iyo oons u dhexeeya 0 iyo wax ka yar 16."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập số pound không âm và số ounce từ 0 đến dưới 16."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磅数不能为负数，盎司数须大于等于0且小于16。"
          }
        }
      }
    },
    "Use null for both components when only totalML is known. Never guess a split. For a known split, the two components must add up to totalML within 0.01 mL; their sum is the saved volume." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم null لكلا المكونين عندما تكون totalML وحدها معروفة. لا تخمّن التوزيع. عند معرفة التوزيع، يجب أن يساوي مجموع المكونين totalML بفارق لا يتجاوز 0.01 mL؛ ويُحفظ مجموعهما باعتباره الحجم."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa null para ambos componentes si solo conoces totalML. Nunca inventes un desglose. Si lo conoces, los componentes deben sumar totalML con tolerancia de 0.01 mL; la suma es el volumen guardado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی فقط totalML مشخص است، برای هر دو جزء از null استفاده کنید. سهم‌ها را حدس نزنید. اگر سهم‌ها مشخص‌اند، مجموع دو جزء باید با totalML حداکثر 0.01 mL اختلاف داشته باشد؛ مجموع آن‌ها به‌عنوان حجم ذخیره می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang null para sa parehong mga bahagi kapag lamang totalML ay kilala. Hindi kailanman hulaan ng isang split. Para sa isang kilalang split, ang dalawang sangkap ay dapat magdagdag hanggang sa totalML sa loob ng 0.01 mL; ang kanilang kabuuan ay ang naka-save na dami."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez null pour les deux composants lorsque seul totalML est connu. N’inventez jamais de répartition. Si elle est connue, la somme des deux composants doit correspondre à totalML à 0,01 mL près ; cette somme est le volume enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब केवल totalML ज्ञात हो, तो दोनों घटकों के लिए null इस्तेमाल करें। विभाजन का अनुमान न लगाएँ। ज्ञात विभाजन में दोनों घटकों का योग totalML से अधिकतम 0.01 mL अलग हो सकता है; उनका योग ही सहेजी गई मात्रा होगी।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sèvi ak null pou tou de pati lè sèlman totalML se konnen. Pa janm devine yon divize. Pou yon divize ki konnen, de pati yo dwe ajoute jiska totalML nan 0.01 mL; kantite yo se volim sa a."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "totalML만 알려진 경우 두 구성 요소에 null을 사용합니다. 분할은 절대 추측하지 마십시오. 알려진 분할의 경우, 두 구성 요소가 0.01 mL 이내에서 totalML까지 합쳐져야 하며 그 합이 저장된 볼륨입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use null para ambos os componentes quando apenas totalML é conhecido. Nunca adivinhe uma divisão. Para uma divisão conhecida, os dois componentes devem somar até totalML dentro 0.01 mL; sua soma é o volume salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если известен только totalML, укажите null для обоих компонентов. Не определяйте состав наугад. При известном составе сумма компонентов должна совпадать с totalML с точностью до 0.01 мл; сохраняется сумма компонентов."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "isticmaal null labadaba qaybaha marka kaliya totalML waa la yaqaan. marnaba u maleynayaa kala go’aan ah. Si loo kala qaybiyo la ogyahay, laba qaybood oo waa in ay ku darto ilaa totalML 0.01 mL gudahood; tiradoodu waa tiradii kaydsan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng null cho cả hai thành phần khi chỉ biết totalML. Không đoán lượng từng loại. Nếu đã biết, tổng hai thành phần phải khớp totalML trong sai số 0.01 mL; tổng này là lượng được lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只知道totalML时，请将两个成分都设为null，切勿猜测比例。已知各成分用量时，两者之和与totalML的差不能超过0.01 mL；保存的奶量为两者之和。"
          }
        }
      }
    },
    "Use numbers for both components, or null for both when the split is unknown." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم أرقامًا لكلا المكونين، أو null لكليهما عندما يكون التوزيع غير معروف."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa números para ambos componentes o null para ambos si no conoces el desglose."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای هر دو جزء عدد وارد کنید؛ اگر سهم‌ها نامشخص‌اند، برای هر دو از null استفاده کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang mga numero para sa parehong bahagi, o null para sa parehong kapag ang split ay hindi kilala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez des nombres pour les deux composantes, ou null pour les deux lorsque la division est inconnue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों घटकों के लिए संख्याएँ इस्तेमाल करें, या विभाजन अज्ञात होने पर दोनों के लिए null रखें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sèvi ak nimewo pou de pati yo, oswa null pou tou de lè divizè a pa konnen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 구성 요소 모두에 숫자를 사용하거나 분할이 알 수 없을 때는 null을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use números para os dois componentes, ou null para ambos quando a divisão for desconhecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обоих компонентов используйте числа либо null, если состав неизвестен."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "isticmaalka tirada labadaba qaybaha, ama null labaduba marka kala qaybinta ma cadda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng các con số cho cả hai thành phần, hoặc null cho cả hai khi phân chia là không biết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于两个成分使用数字,或者当分割未知时对于两者都使用 null。"
          }
        }
      }
    },
    "Use one JSON object per line, without an array, headings, or code fences." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم كائن JSON واحدًا في كل سطر، دون مصفوفة أو عناوين أو علامات إحاطة بكتلة التعليمات البرمجية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un objeto JSON por línea, sin una matriz, encabezados ni bloques de código."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از یک شیء JSON در هر خط استفاده کنید، بدون آرایه، سرآیندها یا حصار کد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang isang JSON bagay sa bawat linya, nang walang array, mga pamagat, o code bakod."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un objet JSON par ligne, sans tableau, en-têtes ou clôtures de code."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर पंक्ति में एक JSON ऑब्जेक्ट रखें। ऐरे, शीर्षक या कोड ब्लॉक की सीमाएँ न जोड़ें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itilize yon objè JSON pou chak liy, san yon array, tit, oswa fenèt kòd."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배열, 헤더 또는 코드 펜스 없이 라인당 하나의 JSON 개체를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
