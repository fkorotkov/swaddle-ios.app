      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الدعوة لا تتطابق مع حساب آبل المسجل في iCloud على هذا الآي فون. أعيد فتح الدعوة بالحساب المدعو."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La invitación no coincide con la Cuenta de Apple conectada a iCloud en este iPhone. Vuelve a abrirla con la cuenta invitada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این دعوت‌نامه با حساب اپل وارد شده به iCloud در این iPhone تطابق ندارد. دعوت‌نامه را با حساب دعوت‌شده دوباره باز کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi tumutugma ang imbitasyong ito sa Apple Account na naka-sign in sa iCloud sa iPhone na ito. I-reopen ang imbitasyon gamit ang iniimbitahang account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette invitation ne correspond pas au compte Apple connecté à iCloud sur cet iPhone.Reouvrez l’invitation avec le compte invité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह निमंत्रण इस iPhone पर iCloud में साइन इन किए गए Apple खाते से मेल नहीं खाता। निमंत्रित खाते से इसे दोबारा खोलें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envitasyon sa a pa konpatib ak Kont Apple ki konekte nan iCloud sou iPhone sa a. Re-ouvri envitasyon an avèk kont la ou te invite."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 초대는 이 iPhone에서 iCloud에 로그인한 Apple 계정과 일치하지 않습니다. 초대받은 계정으로 초대를 다시 여세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este convite não corresponde à Conta Apple com sessão iniciada no iCloud neste iPhone.Reabra o convite com a conta convidada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приглашение не соответствует учетной записи Apple, вошедшей в iCloud на этом iPhone. Повторно откройте приглашение с приглашенной учетной записью."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casuumaaddani ma waafaqsana akoonka Apple ee iCloud looga galay iPhone-kan. Mar kale ku fur casuumaadda akoonkii la casuumay."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mời này không phù hợp với tài khoản Apple đã đăng nhập vào iCloud trên iPhone này. Hãy mở lại lời mời bằng tài khoản được mời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此邀请与在此 iPhone 上登录到 iCloud 的 Apple 帐户不匹配。 使用被邀请的帐户重新打开该邀请。"
          }
        }
      }
    },
