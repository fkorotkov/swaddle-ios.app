    "From CDC’s %@ checklist. These are skills most children (75%% or more) show by that age." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من القائمة المرجعية %@ لمراكز السيطرة على الأمراض. هذه هي المهارات التي يظهرها معظم الأطفال (75%% أو أكثر) في ذلك العمر."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la lista de los CDC para %@. Son habilidades que la mayoría de los niños (el 75%% o más) muestra a esa edad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از فهرست %@ مرکز CDC. این مهارت‌ها را بیشتر کودکان (75%% یا بیشتر) تا این سن نشان می‌دهند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mula sa CDC %@ checklist. Ang mga ito ay kasanayan karamihan sa mga bata (75%% o higit pa) ipakita sa pamamagitan ng edad na iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’après la liste du CDC pour %@. Ce sont des compétences que la plupart des enfants (75%% ou plus) présentent à cet âge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीडीसी की %@ जाँच सूची से. ये वे कौशल हैं जो ज्यादातर बच्चे (75%% या अधिक) उस उम्र तक दिखाते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soti nan CDC %@ checklist. Sa yo se ladrès pifò timoun (75%% oswa plis) montre pa sa a laj."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CDC의 %@ 체크리스트에 따른 내용입니다. 대부분의 아이(75%% 이상)가 이 나이까지 보이는 능력입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da lista do CDC para %@. São habilidades que a maioria das crianças (75%% ou mais) apresenta até essa idade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из списка CDC для возраста %@. Эти навыки проявляются к указанному возрасту у большинства детей (75%% и более)."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka CDC ee %@ liiska tijaabada. Kuwaas waa xirfado carruurta badan (75%% ama in ka badan) muujiyaan da'daas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ danh sách kiểm tra %@ của CDC. Đây là những kỹ năng mà hầu hết trẻ em (75%% hoặc hơn) thể hiện ở độ tuổi đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自美国疾病控制与预防中心 %@ 核对表。 这些是大多数儿童的技能(75%%或以上)显示该年龄。"
          }
        }
      }
    },
