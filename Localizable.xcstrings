    "Caregivers share access to every current and future child in this family." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويتقاسم مقدمو الرعاية إمكانية الوصول إلى كل طفل حالي ومستقبلي في هذه الأسرة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cuidadores tienen acceso a todos los bebés actuales y futuros de esta familia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در این خانواده، مراقبان دسترسی به تمام فرزندان فعلی و آینده را با هم تقسیم می‌کنند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga tagapag-alaga ibahagi ang access sa bawat kasalukuyang at hinaharap na mga bata sa pamilyang ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les soignants partagent l’accès à chaque enfant actuel et futur de cette famille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस परिवार में वर्तमान और भविष्य के हर बच्चे की देखभाल करने वाले लोगों को पहुंच है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moun k ap bay swen yo gen aksè a tout timoun ki nan fanmi sa a kounye a ak tout timoun ki pral ajoute."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보호자는 이 가족의 현재 및 앞으로 추가될 모든 아이의 기록에 접근할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cuidadores compartilham o acesso a cada criança atual e futura nesta família."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Участники получают доступ ко всем нынешним и будущим профилям детей в этой семье."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caregivers wadaagaan helitaanka carruur kasta oo hadda iyo mustaqbalka ee qoyska."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những người chăm sóc chia sẻ quyền truy cập vào mỗi đứa trẻ hiện tại và tương lai trong gia đình này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照顾者分享访问每一个当前和未来的孩子在这个家庭."
          }
        }
      }
    },
