    "Your device must authenticate before reading or changing your family’s log." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب على جهازك التحقق من الهوية قبل قراءة أو تغيير سجل أسرتك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dispositivo debe autenticarse antes de leer o cambiar el diario familiar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دستگاه شما باید قبل از خواندن یا تغییر تاریخچه خانوادگی‌تان هویت خود را تأیید کند."
