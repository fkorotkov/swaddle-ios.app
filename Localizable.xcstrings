    "Use the email they use with their Apple Account. You’ll choose how to send the invitation next." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم البريد الإلكتروني الذي يستخدمونه مع حساب آبل الخاص بهم. سوف تختار كيفية إرسال الدعوة بعد ذلك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el correo de su Cuenta de Apple. Después elegirás cómo enviar la invitación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از ایمیل استفاده کنید که با حساب اپل خود استفاده می‌کنند. سپس شما انتخاب می‌کنید که چگونه دعوت‌نامه را ارسال کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang email na ginagamit nila sa kanilang Apple Account. Pagkatapos ay pipiliin mo kung paano ipadala ang imbitasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez l’adresse e-mail qu’il utilise avec son compte Apple.Vous choisirez ensuite la manière d’envoyer l’invitation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमेल का प्रयोग करें जो वे अपने Apple खाता के साथ उपयोग करते हैं. आप चुनेंगे कि कैसे निमंत्रण को अगले भेजें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itilize imèl li itilize pou kont Apple li. Ou pral chwazi kijan pou voye envitasyon an apre."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 계정에 사용하는 이메일을 사용하십시오. 다음으로 초대장 보내기 방법을 선택합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o e-mail que eles usam com a Conta Apple.Você escolherá como enviar o convite em seguida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте адрес электронной почты, который они используют со своим Apple Account. Вы выберете, как отправить приглашение далее."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "isticmaal email ay isticmaalaan la xisaabtooda Apple. Waxaad dooran doontaa sida loo diro casuumaadda soo socda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng thư điện tử họ dùng với tài khoản Apple của họ. Bạn sẽ chọn cách gửi lời mời tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用他们与 Apple 帐户相关联的电子邮件地址。 接下来,你将选择如何发送邀请。"
          }
        }
      }
    },
    "Use the same Apple Account email to send this invitation again. To invite someone else, remove the previous invitation in Family sharing first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم نفس البريد الإلكتروني لحساب آبل لإرسال هذه الدعوة مرة أخرى. لدعوة شخص آخر، أزل الدعوة السابقة في التشارك العائلي أولا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el mismo correo de la Cuenta de Apple para enviar esta invitación de nuevo. Para invitar a otra persona, elimina primero la invitación anterior en Compartir en familia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ارسال مجدد این دعوت‌نامه از همان حساب اپل استفاده کنید. برای دعوت کردن شخص دیگری، ابتدا دعوت قبلی را در اشتراک‌گذاری خانوادگی حذف کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang parehong email ng Apple Account para ipadala muli ang imbitasyong ito. Upang mag-imbita ng ibang tao, una mong alisin ang nakaraang imbitasyon sa Family sharing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la même adresse du compte Apple pour renvoyer cette invitation. Pour inviter quelqu’un d’autre, supprimez d’abord l’ancienne invitation dans Partage en famille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस निमंत्रण को फिर से भेजने के लिए उसी Apple खाता ईमेल का प्रयोग करें. किसी अन्य को निमंत्रण करने के लिए, पहले परिवार साझा में पिछला निमंत्रण हटाएँ."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itilize menm imèl kont Apple la pou voye envitasyon sa a ankò. Pou envite yon lòt moun, retire ansyen envitasyon an nan Pataj fanmi anvan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동일한 Apple 계정 이메일을 사용하여 초대장을 다시 보내십시오. 다른 사람을 초대하려면 가족 공유에서 이전 초대를 제거해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o mesmo e-mail da Conta Apple para enviar esse convite novamente.Para convidar outra pessoa, remova primeiro o convite anterior no Compartilhamento Familiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте ту же учетную запись Apple, чтобы снова отправить это приглашение. Чтобы пригласить кого-то другого, сначала удалите предыдущее приглашение в Семейном общем доступе."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaad isticmaali kartaa email account Apple isku mid ah si aad u soo dirto casuumaadkan mar kale. Si aad qof kale ugu yeedhaan, ka saar martida hore ee Family sharing hore."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy dùng cùng một địa chỉ email của Tài khoản Apple để gửi lại lời mời này. Để mời người khác, hãy xóa lời mời trước đó trong Gia đình trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用同一 Apple 帐户电子邮件重新发送此邀请。 要邀请其他人,请先从\"家人共享\"中移除上一次的邀请。"
          }
        }
      }
    },
