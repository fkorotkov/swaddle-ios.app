      }
    },
    "This profile already has an invitation for someone else. Remove that invitation in Family sharing first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي هذا الملف الشخصي بالفعل على دعوة لشخص آخر. قم بإزالة تلك الدعوة في التشارك العائلي أولا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil ya tiene una invitación para otra persona. Elimínala primero en Compartir en familia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این پروفایل از قبل دعوت‌نامه‌ای برای شخص دیگری دارد. ابتدا آن دعوت‌نامه را در اشتراک‌گذاری خانوادگی حذف کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mayroon nang imbitasyon ang profile na ito para sa ibang tao. Una, tanggalin ang imbitasyong iyon sa Family sharing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil contient déjà une invitation pour quelqu’un d’autre, supprimez-la d’abord dans le partage familial."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रोफ़ाइल में पहले से ही किसी अन्य के लिए एक निमंत्रण है. परिवार साझेदारी में उस निमंत्रण को पहले मिटाएँ."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pwofil sa a deja gen yon envitasyon pou yon lòt moun. Retire envitasyon sa a nan Pataj fanmi an dabò."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필에는 다른 사람을 위한 초대장이 이미 있습니다. 가족 공유에서 해당 초대장을 먼저 제거하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil já tem um convite para outra pessoa, remova esse convite no Compartilhamento Familiar primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом профиле уже есть приглашение для другого пользователя. Сначала удалите это приглашение в Семейном доступе."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astaantan hore waxay u leedahay casuumaad qof kale. Marka hore ka saar casuumaadda Wadaagidda qoyska."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ này đã có một lời mời cho người khác. Lấy lời mời đó ra khỏi Gia đình trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置文件已有其他人的邀请。 首先在\"家人共享\"中移除该邀请。"
          }
        }
      }
    },
    "This profile is already linked to another Apple Account. Manage its access in Family sharing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الملف الشخصي مرتبط بالفعل بحساب آخر من حسابات آبل. قم بإدارة إمكانية وصوله في التشارك العائلي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil ya está vinculado a otra Cuenta de Apple. Gestiona su acceso en Compartir en familia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این پروفایل از قبل به یک حساب اپل دیگر مرتبط است. دسترسی آن را در اشتراک‌گذاری خانوادگی مدیریت کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang profile na ito ay naka-link na sa ibang Apple Account. Pamahalaan ang access nito sa Family Sharing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil est déjà associé à un autre compte Apple. Gérez son accès dans le partage familial."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह प्रोफ़ाइल पहले से ही अन्य Apple खाता से जुड़ा है. इसकी पहुँच का प्रबंधन परिवार साझा में करें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pwofil sa a deja lye ak yon lòt Kont Apple. Manaje aksè li nan Partage Famille."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필은 이미 다른 Apple 계정에 연결되어 있습니다. 가족 공유에서 액세스를 관리할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil já está associado a outra Conta Apple. Gerencie o acesso dele no Compartilhamento Familiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот профиль уже связан с другой учетной записью Apple. Управляйте его доступом в семейном общем доступе."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile this ayaa horeyba loo xiray xisaab kale Apple. Maareeyaha helitaanka ee Family sharing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ này đã được kết nối với một Tài khoản Apple khác. Quản lý quyền truy cập của nó trong chia sẻ gia đình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此个人资料已关联到另一个 Apple 帐户。 在\"家人共享\"中管理其访问权限。"
          }
        }
      }
    },
    "This profile is linked to an Apple Account. Keep it for their sign-in, and use Family sharing to manage their access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الصورة الشخصية مرتبطة بحساب آبل. احتفظ به لتسجيل الدخول، واستخدام التشارك العائلي لإدارة وصولهم."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil está vinculado a una Cuenta de Apple. Consérvalo para su acceso y usa Compartir en familia para gestionarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این پروفایل به یک حساب اپل پیوند خورده است. برای ورود آن‌ها نگه دارید و از اشتراک‌گذاری خانوادگی برای مدیریت دسترسی آنها استفاده کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang profile na ito ay naka-link sa isang Apple Account. Panatilihin ito para sa kanilang pag-sign in, at gamitin ang Pagbabahagi ng Pamilya upang pamahalaan ang kanilang access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil est associé à un compte Apple, conservez-le pour leur connexion et utilisez le partage familial pour gérer leur accès."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह प्रोफ़ाइल एक Apple खाता से जुड़ा है. इसे उनके लॉगइन के लिए रखें, और उनकी पहुँच को प्रबंधित करने के लिए परिवार साझा का उपयोग करें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pwofil sa a lye ak yon Kont Apple. Konserve l pou yo ka konekte, epi itilize Partage Famille pou jere aksè yo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필은 Apple 계정에 연결되어 있습니다. 상대방이 로그인할 수 있도록 프로필을 유지하고, 가족 공유에서 접근 권한을 관리하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil está associado a uma Conta Apple, mantenha-a para iniciar sessão e utilize o Partilha com a família para gerir o acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот профиль связан с учетной записью Apple. Сохраните его для входа в систему и используйте Семейный доступ, чтобы управлять их доступом."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile this waa la xidhiidhaa xisaab Apple. Ilaalinta ay u diiwaan-in, iyo isticmaalka Family qaybinta si ay u maamulaan helitaanka."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ này được liên kết với một Tài khoản Apple. Giữ nó cho việc đăng nhập của họ, và sử dụng chia sẻ gia đình để quản lý quyền truy cập của họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此个人资料关联到 Apple 帐户,请保留以供他们登录之用,并使用\"家人共享\"来管理他们的访问权限。"
          }
        }
      }
    },
    "This profile was deleted. Its pumping history is kept. Restore the profile in Settings → Review edits & deleted entries to record more." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُذف هذا الملف الشخصي وحُفظ سجل شفط الحليب. لاستئناف التسجيل، استعد الملف من الإعدادات ← مراجعة التعديلات والسجلات المحذوفة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil se eliminó. Se conserva su historial de extracciones. Restáuralo en Ajustes → Revisar cambios y registros eliminados para registrar más."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این پروفایل حذف شده اما سابقهٔ دوشیدن شیر حفظ شده است. برای ثبت بیشتر آن را در تنظیمات ← بررسی ویرایش‌ها و مدخل‌های حذف‌شده بازگردانید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinanggal ang profile na ito. Mananatili ang kasaysayan ng pag-pump. Ibalik ang profile sa Mga Setting → Tingnan ang mga edit at tinanggal na entries para makapagtala muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil a été supprimé, mais son historique d'expression du lait maternel est conservé. Restaurez le profil dans Paramètres → Réviser les modifications et les entrées supprimées pour en enregistrer davantage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह प्रोफ़ाइल हटाई गई है। दूध निकालने का इतिहास सुरक्षित है। और दर्ज करने के लिए सेटिंग्स → संपादन और मिटाई गई प्रविष्टियों की समीक्षा करें में प्रोफ़ाइल बहाल करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pwofil sa a te efase. Istorik tire lèt li konsève. Retabli pwofil la nan Paramèt → Revize chanjman ak antre efase pou anrejistre plis."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필은 삭제되었지만 유축 이력은 유지됩니다. 더 기록하려면 설정 → 편집 및 삭제된 항목 검토에서 프로필을 복원하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil foi excluído, mas seu histórico de extração de leite materno é mantido. Restaure o perfil em Configurações → Revisar edições e entradas excluídas para gravar mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль удалён, история сцеживаний сохранена. Чтобы добавлять записи, восстановите профиль в разделе «Настройки» → «Просмотр изменений и удалённых записей»."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astaantan waa la tirtiray. Taariikhda lisidda caanaha waa la hayaa. Si aad wax kale u diiwaangeliso, ka soo celi Dejinta → Dib u eeg wax-ka-beddellada iyo diiwaannada la tirtiray."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ này đã bị xóa nhưng lịch sử hút sữa vẫn được giữ. Để ghi thêm, khôi phục hồ sơ tại Cài đặt → Xem lại các mục sửa đổi và xoá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置文件已被删除,其抽奶历史记录保留。 在设置 → 查看编辑和删除条目 中恢复该配置文件以记录更多内容。"
          }
        }
      }
    },
    "This record belongs to a different family." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا السجل ينتمي إلى عائلة مختلفة"
