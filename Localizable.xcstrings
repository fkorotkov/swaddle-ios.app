    "Sign into the original Apple Account to sync this log. Your local records have been kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الدخول إلى حساب آبل الأصلي لمزامنة هذا السجل. سجلاتك المحلية تم الاحتفاظ بها."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con la Cuenta de Apple original para sincronizar este diario. Tus registros locales se han conservado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای همگام‌سازی این ثبت به حساب اصلی اپل وارد شوید. رکوردهای محلی شما نگه داشته شده‌اند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-sign in sa orihinal na Apple Account upang i-sync ang log na ito. Ang iyong mga lokal na talaan ay pinananatili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous au compte Apple d'origine pour synchroniser ce journal. Vos enregistrements locaux ont été conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस लॉग को सिंक करने के लिए मूल Apple खाता में लॉग इन करें. आपके स्थानीय रिकॉर्ड बनाए गए हैं."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enskri nan kont Apple orijinal ou pou sync sa a. Dosye lokal ou yo te rete."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 로그를 동기화하려면 원래 Apple 계정에 로그인합니다. 로컬 기록이 보존됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça login na Conta Apple original para sincronizar esse registro. Seus registros locais foram mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите в исходную учетную запись Apple, чтобы синхронизировать этот журнал. Ваши локальные записи были сохранены."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isku diiwaangelinta xisaabta Apple asalka ah si aad u sync log this. Your diiwaanada gudaha ayaa la hayaa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập vào tài khoản Apple ban đầu để đồng bộ hóa bản ghi này. Bản ghi cục bộ của bạn đã được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录原始 Apple 帐户以同步此日志。 本地记录已保留。"
          }
        }
      }
