        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनमें से कुछ रेखाएं रिकॉर्ड किए गए भारों को जोड़ती हैं; वे प्रविष्टियों के बीच वजन का अनुमान नहीं लगाती हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liy ki konekte pwa enskri; yo pa estime pwa ant entrées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선은 기록된 체중을 연결하며, 기록 사이의 체중을 추정하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As linhas conectam pesos registrados; elas não estimam pesos entre entradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Линии соединяют записанные значения веса и не оценивают вес между измерениями."
          }
