        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waqtiyada yar"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những khoảnh khắc nhỏ bé"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小时刻"
          }
        }
      }
    },
    "The local sync checkpoint couldn’t be read. Your care records have been kept; syncing needs attention." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكن من الممكن قراءة نقطة التحقق من التزامن المحلي. تم الاحتفاظ بسجلات الرعاية الخاصة بك؛ التزامن بحاجة إلى اهتمام."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el estado local de sincronización. Tus registros se han conservado; la sincronización necesita atención."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نتوانست نقطه کنترل همگام‌سازی محلی را بخواند. سوابق مراقبت شما حفظ شد؛ همگام‌سازی نیاز به توجه دارد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mababasa ang checkpoint ng lokal na pag-sync. Ang iyong mga talaan sa pangangalaga ay iningatan; kailangang pansin ang pag-sync."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le point de contrôle de synchronisation local n’a pas pu être lu. Vos dossiers de soins ont été conservés. La synchronisation nécessite une attention particulière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थानीय सिंक चेकपॉइंट पढ़ा नहीं जा सका. आपके देखभाल रिकॉर्ड बनाए गए हैं; सिंक को ध्यान की आवश्यकता है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa t kapab li pwen rekòmansman senkronizasyon lokal la. Done swen ou yo konsève; senkronizasyon bezwen atansyon."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 동기화 체크포인트를 읽을 수 없습니다. 관리 기록이 보존되었으므로 동기화에 주의해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ponto de verificação de sincronização local não pôde ser lido. Seus registros de cuidados foram mantidos. A sincronização precisa de atenção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать локальную контрольную точку синхронизации. Ваши записи об уходе были сохранены; синхронизация требует внимания."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barta kaydka isku-xirka qalabka lama akhrin karin. Diiwaannada daryeelkaaga waa la hayaa; isku-xirku wuxuu u baahan yahay fiiro."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc điểm kiểm tra đồng bộ cục bộ. Bản ghi chăm sóc của bạn đã được giữ lại; việc đồng bộ cần chú ý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取本地同步检查点。 您的护理记录已保留;同步需要注意。"
          }
        }
      }
    },
    "The report has conflicting time zones. Import each time zone separately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي التقرير على مناطق زمنية متضاربة. استورد كل منطقة زمنية على حدة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El informe tiene zonas horarias contradictorias. Importa cada zona por separado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گزارش مناطق زمانی متناقض دارد. هر منطقه زمانی را جداگانه وارد کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang ulat ay may mga magkakasalungat na time zones. Mag-import ng bawat time zone hiwalay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport contient des fuseaux horaires en conflit. Importez chaque fuseau horaire séparément."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिपोर्ट में परस्पर विरोधी समय क्षेत्र हैं. प्रत्येक समय क्षेत्र को अलग से आयात करें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapò a gen zòn tan konfli. Enpòte chak zòn tan separeman."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고서에는 충돌하는 시간대가 있습니다. 각 시간대를 별도로 가져옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relatório tem fusos horários conflitantes. Importe cada fuso horário separadamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчет содержит конфликтующие часовые пояса. Импортируйте каждый часовой пояс отдельно."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warbixinta waxaa jira wakhtiga gobollada khilaafsan. Importing wakhtiga gobol kasta oo kala duwan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo có các múi giờ mâu thuẫn. Nhập mỗi múi giờ riêng biệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告有冲突的时区。 分别导入每个时区。"
          }
        }
      }
    },
    "The same %@, with and without adjusting for prematurity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفس %@، مع ودون تعديل بسبب الولادة المبكرة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma medida de %@, con y sin ajuste por prematuridad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همون %@، با و بدون تعديل براي تولد زودرس"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang parehong %@, na may at walang pag-aayos para sa prematurity."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le même %@, avec et sans ajustement pour la prématurité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वही %@, समय-पूर्व जन्म के समायोजन के साथ और बिना।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "menm bagay la tou %@, ak ak san ajisteman pou prematurite."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조산에 대한 조정이 있거나 없는 동일한 %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mesmo %@, com e sem ajuste de prematuridade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно и то же измерение (%@) с поправкой на недоношенность и без неё."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isku mid ah %@, la iyo iyada oo aan la hagaajin prematurity."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cùng số đo %@, có và không hiệu chỉnh do sinh non."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同样的 %@,包括和不包括早产调整。"
          }
        }
      }
    },
    "The six motor-development windows come from the WHO Motor Development Study (2006). Their limits describe the 1st and 99th percentiles of observed achievement ages. They are not a deadline or a personalized prediction." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وتأتي نوافذ النمو الحركي الستة من دراسة منظمة الصحة العالمية عن النمو الحركي (2006) وتصف حدودها المئينين 1 و 99 من أعمار الإنجاز الملاحظة، وهي ليست موعداً نهائياً أو تنبؤاً شخصياً."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los seis intervalos de desarrollo motor proceden del Estudio del Desarrollo Motor de la OMS (2006). Sus límites describen los percentiles 1 y 99 de las edades observadas al alcanzar la habilidad. No son plazos ni predicciones personales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شش بازهٔ رشد حرکتی از پژوهش رشد حرکتی WHO در سال ۲۰۰۶ گرفته شده‌اند. حدهای آن‌ها صدک‌های ۱ و ۹۹ سنِ مشاهده‌شدهٔ کسب مهارت هستند. این بازه‌ها نه مهلت‌اند و نه پیش‌بینی شخصی."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang anim na mga bintana ng pag-unlad ng motor ay nagmula sa Pag-aaral sa Pag-unlad ng Motor ng WHO (2006). Inilalarawan ng kanilang mga limitasyon ang 1st at 99th percentiles ng napagmasdan na edad ng tagumpay. Hindi sila isang deadline o personal na hula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les six plages de développement moteur proviennent de l’étude de l’OMS sur le développement moteur (2006). Leurs limites correspondent aux 1er et 99e percentiles des âges d’acquisition observés. Ce ne sont ni des échéances ni des prédictions individuelles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विकास की छह गतिशीलता अवधियाँ WHO के 2006 के मोटर विकास अध्ययन से हैं। सीमाएँ कौशल पाने की देखी गई उम्रों के पहले और 99वें प्रतिशतक हैं। ये समय-सीमा या बच्चे के लिए व्यक्तिगत भविष्यवाणी नहीं हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sis entèval devlopman motè yo soti nan Etid Devlopman Motè OMS (2006). Limit yo se 1ye ak 99yèm pèsantil laj yo te obsève timoun yo rive fè ladrès yo. Yo pa dat limit ni prediksyon pèsonèl."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여섯 가지 운동 발달 시기 범위는 WHO 운동 발달 연구(2006)에서 가져왔습니다. 범위의 양 끝은 관찰된 달성 나이의 1백분위와 99백분위입니다. 기한이나 개인별 예측을 뜻하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As seis janelas de desenvolvimento motor são obtidas do Estudo sobre Desenvolvimento Motor da OMS (2006). Seus limites descrevem os percentis 1 e 99 das idades observadas de realização, não sendo um prazo ou uma previsão personalizada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шесть диапазонов развития двигательных навыков взяты из исследования ВОЗ Motor Development Study (2006). Их границы соответствуют 1-му и 99-му процентилям наблюдаемого возраста освоения навыка. Это не крайние сроки и не индивидуальный прогноз."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lixda muddo ee horumarka dhaqdhaqaaqu waxay ka yimaadeen Daraasadda Horumarka Dhaqdhaqaaqa WHO (2006). Xuduudahoodu waa darajooyinka boqolleeyda 1aad iyo 99aad ee da'da la arkay markii xirfadaha la gaaray. Ma aha wakhti kama dambays ah ama saadaal shaqsiyeed."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sáu khoảng thời gian phát triển vận động lấy từ Nghiên cứu Phát triển Vận động của WHO (2006). Hai giới hạn là bách phân vị thứ 1 và 99 của độ tuổi đạt kỹ năng được quan sát. Đây không phải thời hạn hay dự đoán riêng cho từng bé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "六项运动发育时间范围来自WHO运动发育研究（2006年）。上下限为研究中观察到的达成年龄的第1和第99百分位。它们不是截止期限，也不是对某个孩子的预测。"
          }
        }
      }
    },
    "Their Apple Account will be linked to this profile, including existing pumping sessions. They’ll be able to edit the whole family log." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وسوف يرتبط حساب آبل الخاص بها بهذه الصورة الشخصية، بما في ذلك جلسات إفراز لبن الأم القائمة. وسوف تتمكن من تحرير سجل الأسرة بالكامل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su Cuenta de Apple se vinculará a este perfil, incluidas las sesiones de extracción existentes. Podrá editar todo el diario familiar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب Apple آن‌ها به این پروفایل و نوبت‌های موجود دوشیدن شیر متصل می‌شود. آن‌ها می‌توانند کل دفتر خانواده را ویرایش کنند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maiuugnay ang kanilang Apple Account sa profile na ito, kasama ang mga kasalukuyang sesyon ng pag-pump. Magagawa nilang i-edit ang buong tala ng pamilya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leur compte Apple sera lié à ce profil, y compris les sessions d’expression de lait maternel existantes et ils pourront modifier le journal familial complet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनका Apple खाता इस प्रोफ़ाइल और मौजूदा दूध निकालने के सत्रों से जुड़ेगा। वे पूरे परिवार लॉग को बदल सकेंगे।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kont Apple yo pral konekte ak pwofil sa a, ki gen ladan tout sesyon eksprime lèt manman an deja egziste. Yo pral kapab modifye tout dosye fanmi an."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 유축 기록을 포함한 이 프로필에 상대방의 Apple 계정이 연결됩니다. 상대방은 가족 기록 전체를 수정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua conta Apple será ligada a este perfil, incluindo as sessões de extração de leite materno existentes e poderá editar o registo da família."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт Apple участника будет связан с этим профилем, включая существующие сцеживания. Участник сможет редактировать весь семейный журнал."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akoonkooda Apple wuxuu ku xirmayaa astaantan, oo ay ku jiraan kalfadhiyada lisidda caanaha ee hore. Waxay wax ka beddeli karaan diiwaanka qoyska oo dhan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản Apple của họ sẽ được liên kết với hồ sơ này, gồm các lần hút sữa hiện có. Họ sẽ có thể sửa toàn bộ nhật ký gia đình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们的 Apple 帐户将与此个人资料相关联,包括现有的抽奶会话。 他们可以编辑整个家庭日志。"
          }
        }
      }
    },
    "Their caregiver profile and history finish syncing separately. This existing link keeps the same access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات مقدمي الرعاية وتاريخهم ينتهي من التزامن بشكل منفصل هذا الرابط القائم يحتفظ بنفس الوصول"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su perfil e historial terminan de sincronizarse por separado. Este enlace existente conserva el mismo acceso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروفایل مراقب و تاریخچه آن‌ها به‌طور جداگانه همگام‌سازی می‌شوند. این پیوند موجود دسترسی مشابه را حفظ می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang kanilang profile ng tagapag-alaga at kasaysayan ay magtatapos na mag-sync nang hiwalay. Pinapanatili ng umiiral na link na ito ang parehong access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil et l'historique de leur soignant se synchronisent séparément. Ce lien existant conserve le même accès."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनके देखभालकर्ता प्रोफ़ाइल और इतिहास अलग से सिंक्रोनाइज़ेशन समाप्त होता है. यह मौजूदा लिंक एक ही पहुँच रखता है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pwofil ak istwa moun k'ap pran swen yo fini sinkronize separeman. Lyen sa a deja egziste kenbe menm aksè a."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간호사 프로필과 기록은 별도로 동기화가 완료됩니다. 이 기존 링크는 동일한 액세스를 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil e o histórico do cuidador são sincronizados separadamente. Esse link existente mantém o mesmo acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль участника и его история завершают синхронизацию отдельно. Существующая ссылка сохраняет прежние права доступа."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iyaga daryeel profil iyo taariikhda dhamaadka syncing kala duwan. xiriirkan hadda jira ilaaliya helitaanka isku mid ah."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ người chăm sóc và lịch sử của họ sẽ được đồng bộ hóa riêng biệt. Liên kết hiện có này vẫn giữ quyền truy cập như cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们的护理人员资料和历史记录将分别完成同步。 此现有链接保留相同的访问权限。"
          }
        }
      }
    },
    "Their unfolding\nstory." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قصتهم التي\nتتكشف."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su historia,\npaso a paso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داستانی که\nشکوفا می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unti-unting nabubuong\nkuwento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une histoire\nqui se déploie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उसकी उभरती\nकहानी।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istwa yo ap\ndewoule."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나씩 펼쳐지는\n아이의 이야기."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma história\nse revelando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История маленьких\nоткрытий."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sheekadooda\nkoraysa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câu chuyện\ndần mở ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成长中的\n故事。"
          }
        }
      }
    },
    "There are competing edits. Saving this version resolves them; all prior versions remain in history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد تعديلات متعارضة. يحل حفظ هذه النسخة التعارض؛ وتبقى كل النسخ السابقة في السجل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay cambios en conflicto. Guardar esta versión los resuelve; todas las versiones anteriores permanecen en el historial."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویرایش‌های متعارض وجود دارد. ذخیرهٔ این نسخه تعارض را حل می‌کند؛ همهٔ نسخه‌های قبلی در سابقه می‌مانند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May mga magkasalungat na pag-edit. Malulutas ang mga ito sa pag-save ng bersyong ito; mananatili sa kasaysayan ang lahat ng naunang bersyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a des modifications concurrentes. Enregistrer cette version les résout; toutes les versions précédentes restent dans l'historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टकराते बदलाव हैं। यह संस्करण सहेजने से टकराव हल होगा; सभी पुराने संस्करण इतिहास में रहेंगे।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gen kèk modifye ki konpetisyon. Enskri vèsyon sa a rezoud yo; tout vèsyon anvan yo rete nan istwa a."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌하는 수정 사항이 있습니다. 이 버전을 저장하면 충돌이 해결되며 이전 버전은 모두 이력에 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existem edições concorrentes. Salvar esta versão resolve-as; todas as versões anteriores permanecem no histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть конфликтующие изменения. Сохранение этой версии устранит конфликт; все предыдущие версии останутся в истории."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaa jira isbeddello la tartamaya. Ku kaydinta noocan ayaa xallisa; noocyada hore oo dhan waxay ku jiraan taariikhda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có các chỉnh sửa xung đột. Lưu phiên bản này để giải quyết; mọi phiên bản trước vẫn được giữ trong lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在有冲突的编辑。保存此版本即可解决冲突，所有旧版本都会保留在历史记录中。"
          }
        }
      }
    },
    "These capabilities require care history access and compatible Apple Intelligence settings. Siri’s choice of action and wording depend on system support. A care note saves text; it doesn’t create a feeding or diaper entry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب هذه القدرات الوصول إلى تاريخ الرعاية وإعدادات ذكاء أبل المتوافقة. ويعتمد اختيار سيري للتصرفات والصياغة على دعم النظام. وتوفر مذكرة الرعاية النص؛ ولا تنشئ مدخلا للإطعام أو الحفاضات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas funciones requieren acceso al historial de cuidados y ajustes compatibles de Apple Intelligence. La acción y las palabras que elige Siri dependen del sistema. Una nota de cuidados guarda texto; no crea una toma ni un pañal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این قابلیت‌ها نیازمند دسترسی به تاریخچه مراقبت و تنظیمات هوشمند سازگاری اپل هستند. انتخاب Siri برای عمل و کلمه بستگی به پشتیبانی سیستم دارد. یک یادداشت مراقبت متن را ذخیره می‌کند؛ آن یک ورودی تغذیه یا پوشک ایجاد نمی‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan ng mga kakayahang ito ng access sa kasaysayan ng pangangalaga at katugmang Apple Intelligence settings. Nakasalalay sa system ang aksyon at mga salitang pipiliin ng Siri. Teksto ang sine-save ng care note; hindi ito lumilikha ng tala ng pagpapakain o diaper."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces fonctions nécessitent l’accès à l’historique des soins et des réglages Apple Intelligence compatibles. Le choix des actions et des mots de Siri dépend du système. Une note de soins enregistre du texte ; elle ne crée pas de repas ni de changement de couche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन क्षमताओं के लिए देखभाल इतिहास पहुँच और संगत एप्पल इंटेलिजेंस सेटिंग की आवश्यकता होती है. Siri का कार्य और शब्दावली का चयन तंत्र समर्थन पर निर्भर करता है. एक देखभाल नोट पाठ को बचाता है; यह एक खिलाने या डायपर प्रविष्टि नहीं बनाता है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapasite sa yo bezwen aksè istorik swen ak paramèt Apple Intelligence ki konpatib. Aksyon ak mo Siri chwazi depann de sipò sistèm nan. Yon nòt swen sove tèks; li pa kreye yon antre alimantasyon oswa kouchèt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기능에는 돌봄 이력 접근 권한과 호환되는 Apple Intelligence 설정이 필요합니다. Siri의 동작과 표현은 시스템 지원에 따라 달라집니다. 돌봄 메모는 텍스트를 저장하며 수유나 기저귀 기록을 생성하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas funções exigem acesso ao histórico de cuidados e configurações compatíveis do Apple Intelligence. A escolha de ações e palavras da Siri depende do suporte do sistema. Uma nota de cuidados salva texto; não cria um registro de mamada ou fralda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этих функций нужны доступ к истории ухода и совместимые настройки Apple Intelligence. Выбор действий и формулировок Siri зависит от поддержки системы. Заметка об уходе сохраняет текст, но не создаёт запись кормления или подгузника."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awoodahani waxay u baahan yihiin gelitaanka taariikhda daryeelka iyo dejinta Apple Intelligence ee ku habboon. Ficilka iyo ereyada Siri doorato waxay ku xiran yihiin taageerada nidaamka. Qoraal daryeel wuxuu kaydiyaa qoraal keliya; ma abuuro quudin ama beddel xafaayad."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tính năng này cần quyền truy cập lịch sử chăm sóc và cài đặt Apple Intelligence tương thích. Tác vụ và cách diễn đạt của Siri phụ thuộc vào hệ thống. Ghi chú chăm sóc chỉ lưu văn bản, không tạo bản ghi cữ bú hay thay tã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些功能需要护理历史记录访问权限以及兼容的Apple Intelligence设置。Siri选择的操作和措辞取决于系统支持。护理笔记仅保存文字，不会创建喂养或尿布记录。"
          }
        }
      }
    },
    "These comparisons use the same age and sex. The lines are not boundaries between healthy and unhealthy growth." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم هذه المقارنات العمر والجنس نفسيهما. الخطوط ليست حدودًا بين النمو الصحي وغير الصحي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas comparaciones usan la misma edad y sexo. Las líneas no separan un crecimiento saludable de uno que no lo sea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این مقایسه‌ها برای سن و جنس یکسان‌اند. خط‌ها مرز بین رشد سالم و ناسالم نیستند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parehong edad at kasarian ang ginagamit sa mga paghahambing na ito. Hindi hangganan sa pagitan ng malusog at hindi malusog na paglaki ang mga linya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces comparaisons utilisent le même âge et le même sexe. Les lignes ne séparent pas une croissance saine d’une croissance malsaine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन तुलनाओं में आयु और लिंग समान होते हैं। ये रेखाएँ स्वस्थ और अस्वस्थ वृद्धि की सीमाएँ नहीं हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konparezon sa yo sèvi ak menm laj ak menm sèks. Liy yo pa limit ant kwasans ki an sante ak kwasans ki pa an sante."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 비교는 같은 나이와 성별을 사용합니다. 선은 건강한 성장과 건강하지 않은 성장의 경계가 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essas comparações usam a mesma idade e o mesmo sexo. As linhas não são limites entre crescimento saudável e não saudável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти сравнения используют тот же возраст и пол. Линии не являются границами между здоровым и нездоровым ростом."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isbarbardhigyadani waxay isticmaalaan da’ iyo jinsi isku mid ah. Xariiqyadu ma aha xuduudaha u dhexeeya koritaan caafimaad qaba iyo mid aan caafimaad qabin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các so sánh này dùng cùng tuổi và giới tính. Các đường không phải ranh giới giữa tăng trưởng khỏe mạnh và không khỏe mạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些比较使用相同年龄和性别。线条并非健康与不健康生长的界限。"
          }
        }
      }
    },
    "These WHO comparisons cover birth through the fifth birthday. Measurements are still saved at other ages." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وتغطي مقارنات منظمة الصحة العالمية هذه الفترة من الولادة حتى بلوغ الطفل سن الخامسة، ولا تزال القياسات تُحفظ في الأعمار الأخرى."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas comparaciones de la OMS abarcan desde el nacimiento hasta el quinto cumpleaños. También se guardan las mediciones de otras edades."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این مقایسه‌های WHO از تولد تا پنج‌سالگی را پوشش می‌دهند. اندازه‌گیری در سن‌های دیگر هم ذخیره می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga paghahambing WHO takip kapanganakan sa pamamagitan ng ikalimang kaarawan. Pagsukat ay nai-save pa rin sa iba pang edad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces comparaisons de l'OMS couvrent la naissance jusqu'au cinquième anniversaire, les mesures étant toujours enregistrées à d'autres âges."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये WHO तुलनाएँ जन्म से पाँचवें जन्मदिन तक हैं। दूसरी उम्र के माप भी सहेजे जाते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konparezon OMS sa yo kouvri nesans rive nan senkyèm anivèsè a. Ou ka toujou anrejistre mezi nan lòt laj."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이러한 WHO의 비교는 출생부터 다섯 번째 생일까지를 포함한다. 측정은 여전히 다른 나이에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essas comparações da OMS abrangem o nascimento até o quinto aniversário, mas as medições ainda são salvas em outras idades."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти сравнения ВОЗ охватывают возраст от рождения до пятого дня рождения. В другом возрасте измерения тоже сохраняются."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isbarbardhigyadan WHO waxay daboolaan dhalashada ilaa dhalashada shanaad. Cabbirrada weli waa la kaydiyaa da'aha kale."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các so sánh WHO này áp dụng từ khi sinh đến sinh nhật thứ năm. Số đo ở độ tuổi khác vẫn được lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世卫组织的这些比较涵盖从出生到五岁的生日，其他年龄段的测量仍然保存。"
          }
        }
      }
    },
    "They’ll join as %@ and record entries using this profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وسيقومون بالانضمام كـ %@ وتسجيل المدخلات باستخدام هذا الوصف."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se unirá como %@ y registrará con este perfil."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آن‌ها به عنوان %@ وارد می‌شوند و با استفاده از این پروفایل ورودی‌ها را ضبط می‌کنند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sila ay sumali bilang %@ at rekord ng mga entry gamit ang profile na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils rejoindront en tant que %@ et enregistreront des entrées à l’aide de ce profil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे %@ के रूप में शामिल होंगे और इस प्रोफ़ाइल का उपयोग कर प्रविष्टि रिकॉर्ड करेंगे."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yo pral rantre kòm %@ epi enskri entrées ki itilize sa a profil."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
