    "Lines connect measurements; they don’t estimate values between entries." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخطوط تربط القياسات؛ وهي لا تقدّر القيم بين القيودات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las líneas conectan las mediciones; no estiman valores entre registros."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطوط اندازه‌گیری‌ها را به هم متصل می‌کنند؛ آن‌ها مقادیر بین ورودی‌ها را تخمین نمی‌زنند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linya kumonekta pagsukat; hindi nila tinatayang halaga sa pagitan ng mga entry."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes relient les mesures; elles n’estiment pas les valeurs entre les entrées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रेखाएँ मापों को जोड़ती हैं; वे प्रविष्टियों के बीच मूल्यों का अनुमान नहीं लगाती हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liy ki konekte mezi; yo pa estime valè ant entrées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선은 측정값을 연결하며, 항목 사이의 값을 추정하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As linhas conectam medidas; elas não estimam valores entre entradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Линии соединяют измерения; они не оценивают значения между записями."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lines isku xiran tirakoobka; ma ay qiimeeyaan qiimaha u dhexeeya gelida."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các đường nối các phép đo; chúng không ước tính giá trị giữa các mục nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "线连接测量值;它们不估计条目之间的值。"
          }
        }
      }
    },
    "Lines connect recorded weights; they don’t estimate weights between entries." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخطوط تربط الأوزان المسجلة؛ وهي لا تقدر الأوزان بين القيودات."
