    "Choose Boy or Girl above, or set a reference in Advanced growth settings, to show growth percentiles." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختار صبي أو فتاة أعلاه، أو حدد مرجعا في إعدادات النمو المتقدمة، لعرض المئويات من النمو."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Niño o Niña arriba, o establece una referencia en Ajustes avanzados de crecimiento, para mostrar percentiles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای نمایش صدک‌های رشد، بالا پسر یا دختر را انتخاب کنید یا در تنظیمات پیشرفتهٔ رشد یک مرجع تعیین کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin ang Lalaki o Babae sa itaas, o pumili ng pamantayan sa Advanced na mga setting ng paglaki para ipakita ang mga percentile."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Garçon ou Fille ci-dessus, ou définissez une référence dans Paramètres de croissance avancés pour afficher les percentiles de croissance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वृद्धि के प्रतिशतक दिखाने के लिए ऊपर लड़का या लड़की चुनें, या वृद्धि की उन्नत सेटिंग्स में संदर्भ चुनें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chwazi Ti gason oswa Ti fi pi wo a, oswa chwazi yon referans nan Paramèt avanse pou kwasans, pou wè pèsantil yo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위에서 남아 또는 여아를 선택하거나 고급 성장 설정에서 기준을 선택하면 성장 백분위를 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Menino ou Menina acima, ou defina uma referência em Configurações avançadas de crescimento para mostrar percentis de crescimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите выше «Мальчик» или «Девочка» либо задайте норматив в дополнительных настройках роста, чтобы видеть процентили."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kor ka dooro Wiil ama Gabar, ama tixraac ka dooro Dejinta sare ee koritaanka, si loo muujiyo darajooyinka boqolleeyda koritaanka."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn Bé trai hoặc Bé gái ở trên, hoặc chọn bộ chuẩn trong Cài đặt tăng trưởng nâng cao, để hiển thị bách phân vị tăng trưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择上方的“男孩”或“女孩”，或在“高级生长设置”中选择参考标准，即可显示生长百分位。"
          }
        }
      }
    },
