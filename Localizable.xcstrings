    "WHO observed achievement window, %@ to %@ months. First to ninety-ninth percentile. A broad reference range, not a due date or a score for your child." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نافذة الإنجاز التي لاحظتها منظمة الصحة العالمية، %@ إلى %@ أشهر، المئين الأول إلى المئين التاسع والتسعين، نطاق مرجعي واسع، وليس تاريخا محددا أو درجة لطفلك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "WHO observed achievement window, %1$@ to %2$@ months. First to ninety-ninth percentile. A broad reference range, not a due date or a score for your child."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalo observado de la OMS, de %1$@ a %2$@ meses. Percentiles 1 a 99. Un intervalo amplio de referencia, no una fecha límite ni una puntuación para tu bebé."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بازهٔ کسب مهارت مشاهده‌شده در WHO، از %@ تا %@ ماه. صدک یکم تا نودونهم. این بازهٔ مرجع گسترده است، نه موعد مشخص یا امتیازی برای کودک شما."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naobserbahang panahon ng pagkamit ng kasanayan ayon sa WHO, %@ hanggang %@ buwan. Mula una hanggang ikasiyamnapu’t siyam na percentile. Malawak itong sanggunian, hindi takdang petsa o marka para sa iyong anak."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenêtre de réalisation observée par l’OMS, %@ à %@ mois. Premier au quatre-vingt-dix-neuvième percentile. Une large plage de référence, pas une date d’échéance ou un score pour votre enfant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHO में देखी गई कौशल प्राप्ति की अवधि: %@ से %@ महीने। पहले से निन्यानवेवें प्रतिशतक तक। यह एक विस्तृत संदर्भ सीमा है, आपके बच्चे के लिए कोई समय सीमा या अंक नहीं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OMS te obsève kapasite sa a ant %@ ak %@ mwa, soti nan premye pèsantil rive nan katreven-diznevyèm pèsantil. Se yon seri laj referans, se pa yon dat limit oswa yon nòt pou pitit ou."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHO가 관찰한 발달 시기: %@~%@개월, 첫 번째부터 아흔아홉 번째 백분위수까지입니다. 넓은 참고 범위이며 아이의 마감 시기나 점수가 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janela de realização observada pela OMS, %@ a %@ meses. Percentil do primeiro ao noventa e nove. Uma ampla faixa de referência, não uma data de vencimento ou pontuação para o seu filho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наблюдаемый диапазон освоения навыка по ВОЗ: от %@ до %@ месяцев, с 1-го по 99-й процентиль. Это широкий нормативный диапазон, а не крайний срок или оценка ребёнка."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muddada WHO arkay in xirfad la gaaray: %@ ilaa %@ bilood. Darajada boqolleeyda koowaad ilaa sagaashan iyo sagaalaad. Waa xad tixraac oo ballaaran, ma aha wakhti kama dambays ah ama dhibco ilmahaaga la siiyey."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoảng tuổi đạt kỹ năng quan sát được của WHO, từ %@ đến %@ tháng. Từ bách phân vị thứ nhất đến thứ chín mươi chín. Đây là khoảng tham khảo rộng, không phải hạn chót hay điểm số cho trẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世卫组织观察到的达成时间范围：%@至%@个月，对应第一至第九十九百分位。这是宽泛的参考范围，并非孩子的截止日期或分数。"
          }
        }
      }
    },
