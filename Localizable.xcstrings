          "stringUnit" : {
            "state" : "translated",
            "value" : "با نام %@ به دفتر مشترک خانوادهٔ ما بپیوندید. این دعوت‌نامه را روی iPhone دارای Swaddle باز کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumali sa aming ibinahaging pamilya log bilang %@. Buksan ang imbitasyong ito sa iyong iPhone gamit ang Swaddle naka-install."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoignez notre journal familial partagé en tant que %@. Ouvrez cette invitation sur votre iPhone avec Swaddle installé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के रूप में हमारे साझा परिवार लॉग में शामिल हों। Swaddle इंस्टॉल किए हुए iPhone पर यह निमंत्रण खोलें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join nou an pataje fanmi log kòm %@. Ou ka louvri envitasyon sa a sou iPhone ou ak Swaddle enstale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 프로필로 공유 가족 기록에 참여하세요. Swaddle이 설치된 iPhone에서 이 초대를 여세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junte-se ao nosso registro familiar compartilhado como %@. Abra este convite no seu iPhone com o Swaddle instalado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присоединяйтесь к нашему общему семейному журналу как %@. Откройте это приглашение на вашем iPhone с установленным Swaddle."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku biir diiwaanka qoyska aan wadaagno adigoo ah %@. Casuumaaddan ku fur iPhone-kaaga oo Swaddle ku rakiban yahay."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tham gia nhật ký gia đình chung với tên %@. Mở lời mời trên iPhone đã cài Swaddle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以%@的身份加入我们的共享家庭记录。请在已安装Swaddle的iPhone上打开此邀请。"
          }
        }
      }
    },
    "Join your family" : {
