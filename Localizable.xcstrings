    "Keep %@’s profile with %@. Every original entry is kept, and this change syncs to your family. Update Swaddle on every family device first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على ملف تعريف %@ مع %@. يتم الاحتفاظ بكل مدخل أصلي، ويتم تزامن هذا التغيير مع أسرتك. تحديث Swaddle على كل جهاز أسرة أولا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep %1$@’s profile with %2$@. Every original entry is kept, and this change syncs to your family. Update Swaddle on every family device first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva el perfil de %1$@ con %2$@. Se mantienen todos los registros originales y el cambio se sincroniza con tu familia. Actualiza Swaddle primero en todos los dispositivos de la familia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروفایل %@ را با %@ نگه دارید. هر مدخل اصلی نگهداری می‌شود و این تغییر با خانواده شما همگام‌سازی می‌شود. ابتدا Swaddle را در همه دستگاه‌های خانواده به روز کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panatilihin ang profile ni %@ kasama ng %@. Mananatili ang bawat orihinal na tala at masi-sync ang pagbabago sa pamilya. I-update muna ang Swaddle sa bawat device ng pamilya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le profil de %@ avec %@. Chaque entrée originale est conservée et cette modification se synchronise avec votre famille. Mettez à jour Swaddle sur chaque appareil familial en premier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ की प्रोफ़ाइल %@ के साथ रखें। हर मूल प्रविष्टि सुरक्षित रहेगी और यह बदलाव परिवार के साथ सिंक होगा। पहले परिवार के हर डिवाइस पर Swaddle अपडेट करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenbe pwofil %@ ansanm ak %@. Tout antre orijinal yo konsève, epi chanjman sa a senkronize ak fanmi ou. Mete Swaddle ajou sou tout aparèy fanmi an anvan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@가 포함된 %1$@의 프로필을 유지합니다. 모든 원본 기록이 보존되며 변경 사항은 가족에게 동기화됩니다. 먼저 모든 가족 기기에서 Swaddle을 업데이트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o perfil de %@ com %@. Todos os registros originais são preservados, e esta alteração será sincronizada com a família. Atualize o Swaddle em todos os dispositivos da família primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранить профиль %@ с %@. Все исходные записи сохранятся, а изменение синхронизируется с семьёй. Сначала обновите Swaddle на всех устройствах семьи."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astaanta %@ ku hay %@. Diiwaan kasta oo asalka ah waa la haynayaa, isbeddelkanna qoyska ayuu la jaanqaadaa. Marka hore Swaddle ku cusboonaysii qalab kasta oo qoyska ah."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ hồ sơ %@ với %@. Mỗi mục gốc sẽ được giữ, và thay đổi này đồng bộ hóa với gia đình của bạn. Cập nhật Swaddle trên mọi thiết bị gia đình trước tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留%1$@的资料，包含%2$@。每条原始记录都会保留，变更会同步给家人。请先在每台家庭设备上更新Swaddle。"
          }
        }
      }
    },
