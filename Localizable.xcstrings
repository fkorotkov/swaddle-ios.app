    "Original notes are kept with every entry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويحتفظ بالملاحظات الأصلية مع كل بند."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas originales se conservan en cada registro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یادداشت اصلی با هر ثبت نگه داشته می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orihinal na mga tala ay pinananatili sa bawat entry."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes originales sont conservées avec chaque entrée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर प्रविष्टि के साथ मूल नोट सुरक्षित रहते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nòt orijinal yo rete ak chak antre."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 노트는 모든 항목과 함께 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas originais são mantidas com cada entrada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оригинальные заметки сохраняются при каждой записи."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qoraallada asalka ah waxaa lagu hayaa gelitaanka kasta."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi chú gốc được giữ với mỗi mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个条目都保留原始注释。"
          }
        }
      }
    },
    "Original records and authors kept" : {
