    "Combine duplicate profiles for the same caregiver. Every care entry and pumping session is kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادمج الملفات المكررة لمقدم الرعاية نفسه. ستُحفظ كل سجلات الرعاية وجلسات شفط الحليب."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina los perfiles duplicados del mismo cuidador. Se conservan todos los registros de cuidados y sesiones de extracción."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروفایل‌های تکراری یک مراقب را ادغام کنید. همهٔ ثبت‌های مراقبت و نوبت‌های دوشیدن شیر حفظ می‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagsamahin ang mga dobleng profile ng iisang tagapag-alaga. Mananatili ang bawat tala ng pangangalaga at sesyon ng pag-pump."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinez les profils en double pour le même soignant.Chaque entrée de soins et session d'expression du lait maternel est conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही देखभालकर्ता की दोहरी प्रोफ़ाइल मिलाएँ। देखभाल की हर प्रविष्टि और दूध निकालने का हर सत्र सुरक्षित रहेगा।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizyone pwofil ki double pou menm moun k ap bay swen an. Tout antre swen ak sesyon tire lèt ap rete."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 보호자의 중복 프로필을 합칩니다. 모든 돌봄 및 유축 기록은 보존됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine perfis duplicados para o mesmo cuidador.Cada entrada de cuidado e sessão de extração de leite materno é mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объедините дублирующиеся профили одного участника. Все записи об уходе и сцеживаниях сохранятся."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isku dar astaamaha soo noqnoqda ee isla daryeelaha. Diiwaan kasta oo daryeel iyo kalfadhi kasta oo lisidda caanaha ah waa la haynayaa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gộp các hồ sơ trùng của cùng một người chăm sóc. Mọi bản ghi chăm sóc và lần hút sữa đều được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合并同一照护者的重复资料。所有照护和泵奶记录都会保留。"
          }
        }
      }
    },
    "Combine duplicate profiles for the same person while keeping their history. Save any profile changes first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دمج ملف تعريفي مزدوجة لنفس الشخص مع الحفاظ على تاريخهم. حفظ أي تغييرات ملف تعريفي أولا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina los perfiles duplicados de la misma persona y conserva su historial. Guarda primero los cambios del perfil."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترکیب پروفایلهای تکراری برای یک شخص با نگه داشتن تاریخچه آنها. ابتدا هرگونه تغییرات پروفایل را ذخیره کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isama ang duplicate na profile para sa parehong tao habang pinapanatili ang kanilang kasaysayan. I-save muna ang anumang mga pagbabago sa profile."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinez des profils en double pour la même personne tout en conservant leur historique.Enregistrez d'abord toutes les modifications apportées au profil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही व्यक्ति के लिए दोहरे प्रोफ़ाइलों को जोड़ें जबकि उनका इतिहास बनाए रखें. किसी भी प्रोफ़ाइल परिवर्तन को पहले सहेजें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizyone pwofil ki double pou menm moun nan pandan ou konsève istorik li. Sove nenpòt chanjman nan pwofil yo anvan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동일한 사람에 대한 중복 프로필을 결합하면서 그들의 기록을 유지합니다. 먼저 모든 프로필 변경 사항을 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine perfis duplicados para a mesma pessoa, mantendo o histórico deles e salvando quaisquer alterações no perfil primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объедините профили одного человека, сохранив их историю. Сначала сохраните изменения профиля."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isku dar astaamaha soo noqnoqda ee isla qofka adigoo ilaalinaya taariikhdiisa. Marka hore kaydi isbeddel kasta oo astaanta ah."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gộp các hồ sơ sao chép cho cùng một người trong khi giữ lịch sử của họ. Lưu bất kỳ thay đổi hồ sơ nào trước."
          }
        },
