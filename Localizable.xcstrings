    "Leave both sides blank when the split is unknown." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يترك الجانبان فارغين عندما يكون الانقسام غير معروف."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja ambos lados vacíos si no conoces el desglose."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر دو طرف را خالی بگذارید وقتی که تقسیم ناشناخته است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-iwan ng parehong panig blanko kapag ang split ay hindi kilala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez les deux côtés vides lorsque la division est inconnue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों ही पक्षों को खाली छोड़ दें जब विभाजन अज्ञात हो।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kite toude bò yo vid lè repatisyon an enkoni."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할이 알려지지 않은 경우 양쪽을 비워두십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe ambos os lados em branco quando a divisão é desconhecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте оба поля пустыми, если объёмы с каждой груди неизвестны."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Labada dhinacba bannaan ka tag marka aan kala qaybinta la garanayn."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để trống cả hai bên khi phân chia không rõ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若不知道左右各自的奶量，请将两项都留空。"
          }
        }
      }
    },
    "Leaving ends your access to every child and shared pumping session. Previously synchronized entries remain in the family’s history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن المغادرة تنتهي من وصولك إلى كل طفل وجلسة مشتركة لإخراج لبن الثدي. وتظل القيود المتزامنة سابقا في تاريخ الأسرة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al salir pierdes el acceso a todos los bebés y sesiones de extracción compartidas. Los registros ya sincronizados permanecen en el historial de la familia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با خروج، دسترسی شما به همهٔ کودکان و نوبت‌های مشترک دوشیدن شیر پایان می‌یابد. ثبت‌های همگام‌شدهٔ قبلی در سابقهٔ خانواده باقی می‌مانند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mawawala ang access mo sa bawat bata at ibinahaging sesyon ng pag-pump kapag umalis ka. Mananatili sa kasaysayan ng pamilya ang mga talang na-sync na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitter la famille met fin à votre accès à tous les enfants et aux tirages partagés. Les entrées déjà synchronisées restent dans l’historique familial."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोड़ने पर हर बच्चे और साझा दूध निकालने के सत्रों का आपका एक्सेस खत्म हो जाता है। पहले सिंक की गई प्रविष्टियाँ परिवार के इतिहास में रहती हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lè ou kite, aksè ou a tout timoun ak sesyon tire lèt pataje fini. Antre ki te deja senkronize rete nan istorik fanmi an."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족을 나가면 모든 아이와 공유 유축 기록에 접근할 수 없습니다. 이전에 동기화된 기록은 가족 이력에 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao sair, você perde o acesso a todas as crianças e sessões de extração compartilhadas. Os registros já sincronizados ficam no histórico da família."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При выходе вы потеряете доступ ко всем детям и общим сцеживаниям. Ранее синхронизированные записи останутся в истории семьи."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka bixistu waxay joojinaysaa gelitaankaaga ilmo kasta iyo kalfadhiyada lisidda caanaha la wadaago. Diiwaannadii hore loo isku xiray waxay ku sii jiraan taariikhda qoyska."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rời gia đình sẽ chấm dứt quyền truy cập vào mọi bé và bản ghi hút sữa chung. Các bản ghi đã đồng bộ trước đó vẫn còn trong lịch sử gia đình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出后，您将无法访问所有孩子及共享泵奶记录。此前已同步的记录仍保留在家庭历史中。"
          }
        }
      }
    },
