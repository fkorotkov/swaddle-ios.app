        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者说“只小便”或“只有粪便 ” 。"
          }
        }
      }
    },
    "Or say “wet and dirty” instead of “pee and poo”." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو قل «مبلل ومتسخ» بدلًا من «بول وبراز»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or say “wet and dirty” instead of “pee and poo”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes decir «mojado y sucio» en vez de «pipí y caca»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یا به‌جای «ادرار و مدفوع» بگو «خیس و کثیف»."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puwede ring sabihin ang “basa at marumi” sa halip na “ihi at dumi”."
          }
        },
        "fr" : {
          "stringUnit" : {
