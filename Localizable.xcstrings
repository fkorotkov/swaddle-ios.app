        }
      }
    },
    "Swaddle uses 1 oz = 30 mL for volume entry and display. Changing units preserves saved amounts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle يستخدم 1 oz = 30 ml لإدخال الحجم وعرضه، ويحافظ تغيير الوحدات على الكميات المودعة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle usa 1 oz = 30 mL para introducir y mostrar volúmenes. Cambiar de unidad conserva las cantidades guardadas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle برای ورود و نمایش مقدار از 1 oz = 30 mL استفاده می‌کند. تغییر واحد، مقدارهای ذخیره‌شده را حفظ می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle gumagamit ng 1 oz = 30 mL para sa dami entry at display. Pagbabago ng mga yunit preserves nai-save na halaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle utilise 1 oz = 30 mL pour la saisie et l’affichage des volumes. Changer d’unité préserve les quantités enregistrées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle मात्रा दर्ज करने और दिखाने के लिए 1 oz = 30 mL मानता है। इकाई बदलने पर सहेजी मात्राएँ सुरक्षित रहती हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle itilize 1 oz = 30 mL pou antre ak montre volim. Lè ou chanje inite, kantite ki anrejistre yo rete menm jan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle은 용량 입력과 표시에 1 oz = 30 mL를 사용합니다. 단위를 바꿔도 저장된 양은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Swaddle usa 1 oz = 30 mL para registrar e exibir volumes. Mudar de unidade preserva as quantidades salvas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для ввода и отображения объёма Swaddle использует соотношение 1 oz = 30 мл. При смене единиц сохранённые объёмы не меняются."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle isticmaalaa 1 oz = 30 mL in volume galay iyo bandhigga. Isbedelka unugyada ilaaliya tirada kaydsan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle sử dụng 1 oz = 30 mL cho nhập và hiển thị thể tích. Thay đổi đơn vị giữ nguyên số lượng đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle在奶量输入和显示中使用1 oz = 30 mL。切换单位不会改变已保存的奶量。"
          }
        }
      }
    },
    "Swaddle uses WHO Child Growth Standards. For a known preterm birth, the chart uses corrected age until the second birthday, then age since birth. These comparisons cover birth through the fifth birthday. Recorded measurements remain visible outside the reference range." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويستخدم Swaddle معايير نمو الطفل لمنظمة الصحة العالمية. وبالنسبة للولادة المبكرة المعروفة، يستخدم الرسم البياني السن المصوبة حتى عيد الميلاد الثاني، ثم السن منذ الولادة. وتغطي هذه المقارنات الولادة حتى عيد الميلاد الخامس. وتظل القياسات المسجلة مرئية خارج النطاق المرجعي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle usa los Patrones de Crecimiento Infantil de la OMS. Si se conoce que nació prematuro, el gráfico usa la edad corregida hasta el segundo cumpleaños y, después, la edad desde el nacimiento. Las comparaciones abarcan desde el nacimiento hasta el quinto cumpleaños. Las mediciones siguen visibles fuera del intervalo de referencia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle از استانداردهای رشد کودک WHO استفاده می‌کند. اگر زودرس بودن مشخص باشد، نمودار تا دو سالگی سن اصلاح‌شده و پس از آن سن از تولد را به کار می‌برد. این مقایسه‌ها از تولد تا پنج‌سالگی را پوشش می‌دهند. اندازه‌گیری‌های خارج از محدودهٔ مرجع هم دیده می‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle gumagamit ng WHO Child Growth Pamantayan. Para sa isang kilalang preterm kapanganakan, ang tsart ay gumagamit ng wastong edad hanggang sa ikalawang kaarawan, pagkatapos ay edad mula noong kapanganakan. Ang mga paghahambing na ito ay sumasaklaw sa kapanganakan hanggang sa ikalimang kaarawan. Ang mga recorded measurements ay nananatiling makikita sa labas ng reference range."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle utilise les Normes de croissance infantile de l’OMS. Pour une naissance prématurée connue, le tableau utilise l'âge corrigé jusqu'au deuxième anniversaire, puis l'âge depuis la naissance. Ces comparaisons couvrent la naissance jusqu'au cinquième anniversaire. Les mesures enregistrées restent visibles en dehors de la plage de référence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle WHO बाल वृद्धि मानकों का उपयोग करता है। समय-पूर्व जन्म की जानकारी होने पर चार्ट दूसरे जन्मदिन तक समायोजित आयु और फिर जन्म से आयु लेता है। ये तुलनाएँ जन्म से पाँचवें जन्मदिन तक हैं। संदर्भ सीमा के बाहर भी दर्ज माप दिखते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle sèvi ak estanda kwasans timoun OMS. Pou yon nati prematir ki konnen, tablo a itilize laj kòrèkte jiska dezyèm anivèsè nesans la, Lè sa a, laj depi nati. Sa yo konparasyon kouvri nati jouk nan senkyèm anivèsè nesans. Mezi enskri rete vizib deyò zòn referans an."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle은 WHO 아동 성장 표준을 사용합니다. 조산 정보가 있으면 만 2세 전까지 교정 나이로, 이후에는 출생 후 실제 나이로 비교합니다. 비교는 출생부터 만 5세 생일까지 제공됩니다. 기준 범위를 벗어나도 측정 기록은 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle utiliza os Padrões de Crescimento Infantil da OMS. Para um nascimento prematuro conhecido, o gráfico usa a idade corrigida até o segundo aniversário e depois a idade desde o nascimento. Essas comparações abrangem o nascimento até o quinto aniversário. As medições gravadas permanecem visíveis fora da faixa de referência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle использует стандарты ВОЗ в отношении роста детей. Для известных преждевременных родов в диаграмме используется скорректированный возраст до второго дня рождения, а затем возраст с момента рождения. Эти сопоставления охватывают период с момента рождения до пятилетнего возраста. Зарегистрированные измерения остаются видимыми за пределами исходного диапазона."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle waxay isticmaashaa Heerarka Koritaanka Carruurta ee WHO. Ilmaha la og yahay inuu xilli hore dhashay, jaantusku wuxuu isticmaalaa da'da la saxay ilaa dhalashada labaad, dabadeed da'da laga bilaabo dhalashada. Isbarbardhigyadu waxay daboolaan dhalashada ilaa dhalashada shanaad. Cabbirrada la diiwaangeliyey way muuqdaan xitaa marka ay ka baxsan yihiin xadka tixraaca."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle sử dụng Chuẩn tăng trưởng trẻ em của WHO. Nếu biết bé sinh non, biểu đồ dùng tuổi hiệu chỉnh đến sinh nhật thứ hai, rồi dùng tuổi tính từ ngày sinh. Các so sánh áp dụng từ lúc sinh đến sinh nhật thứ năm. Số đo ngoài phạm vi tham chiếu vẫn được hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle使用WHO儿童生长标准。如果已知孩子为早产，在两周岁前使用矫正年龄，此后使用出生后的实际年龄。这些比较适用于出生至五周岁。超出参考范围的测量记录仍会显示。"
          }
        }
      }
    },
    "Swaddle uses WHO Child Growth Standards. For a known preterm birth, the chart uses corrected age, counted from the estimated due date. For term births, it uses age since birth. Weight comparisons stop at the second birthday." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويستخدم Swaddle معايير نمو الطفل لمنظمة الصحة العالمية. وبالنسبة للولادة المبكرة المعروفة، يستخدم الرسم البياني السن المصوبة، محسوبة من التاريخ المتوقع للولادة. وبالنسبة للولادات المنتظمة، يستخدم الرسم البياني السن منذ الولادة. وتتوقف مقارنات الوزن عند عيد الميلاد الثاني."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle usa los Patrones de Crecimiento Infantil de la OMS. Si se conoce que nació prematuro, el gráfico usa la edad corregida desde la fecha prevista de parto. Para nacimientos a término, usa la edad desde el nacimiento. Las comparaciones de peso terminan en el segundo cumpleaños."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle از استانداردهای رشد کودک سازمان بهداشت جهانی استفاده می‌کند. برای تولد پیش از موعد شناخته شده، نمودار از سن تصحیح‌شده استفاده می‌کند که از تاریخ تخمین زده شده متولد شدن محاسبه می‌شود. برای تولد به موقع، از سن از زمان تولد استفاده می‌کند. مقایسه وزن در دومین سالروز تولد متوقف می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle gumagamit ng WHO Child Growth Standards. Para sa isang kilalang preterm kapanganakan, ang tsart ay gumagamit ng wastong edad, na binibilang mula sa tinatayang petsa ng due. Para sa term births, ito ay gumagamit ng edad dahil sa kapanganakan. Timbang paghahambing tumigil sa ikalawang kaarawan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle utilise les Normes de croissance infantile de l’OMS. Pour une naissance prématurée connue, le tableau utilise l'âge corrigé, compté à partir de la date d'accouchement estimée. Pour les naissances à terme, il utilise l'âge depuis la naissance. Les comparaisons de poids s'arrêtent au deuxième anniversaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle WHO बाल वृद्धि मानकों का उपयोग करता है। समय-पूर्व जन्म की जानकारी होने पर चार्ट अनुमानित जन्मतिथि से समायोजित आयु लेता है। पूर्ण अवधि पर जन्म होने पर जन्म से आयु लेता है। वजन की तुलना दूसरे जन्मदिन पर रुक जाती है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle itilize Estanda Kwasans Timoun OMS. Pou yon nesans prematire ki konnen, tablo a itilize laj korije depi dat yo te prevwa pou akouchman an. Pou nesans a tèm, li itilize laj depi nesans. Konparezon pwa yo sispann nan dezyèm anivèsè nesans la."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle은 WHO 아동 성장 표준을 사용합니다. 조산 정보가 있으면 예정일로부터 계산한 교정 나이를, 만삭 출생이면 출생 후 실제 나이를 사용합니다. 체중 비교는 만 2세 생일까지 제공됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Swaddle usa os Padrões de Crescimento Infantil da OMS. Quando a prematuridade é conhecida, o gráfico usa a idade corrigida desde a data prevista do parto. Para nascimentos a termo, usa a idade desde o nascimento. As comparações de peso vão até o segundo aniversário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle использует стандарты роста детей ВОЗ. Если известно, что ребёнок родился раньше срока, график использует скорректированный возраст от предполагаемой даты родов. Для доношенных детей используется возраст от рождения. Сравнения веса доступны до второго дня рождения."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle waxay isticmaashaa Heerarka Koritaanka Carruurta ee WHO. Ilmaha la og yahay inuu xilli hore dhashay, jaantusku wuxuu isticmaalaa da'da la saxay laga bilaabo taariikhda dhalmada la filayey. Ilmaha waqtigiisa dhashay, waxaa la isticmaalaa da'da dhalashada. Isbarbardhigga miisaanku wuxuu joogsadaa dhalashada labaad."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle sử dụng Chuẩn tăng trưởng trẻ em của WHO. Nếu biết bé sinh non, biểu đồ dùng tuổi hiệu chỉnh tính từ ngày dự sinh. Với bé sinh đủ tháng, biểu đồ dùng tuổi từ ngày sinh. So sánh cân nặng dừng ở sinh nhật thứ hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swaddle使用WHO儿童生长标准。如果已知孩子为早产，图表使用从预产期计算的矫正年龄；足月出生则使用出生后的实际年龄。体重比较在两周岁时结束。"
          }
        }
      }
    },
