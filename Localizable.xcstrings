    "Upper dotted line (97th): about 97 out of 100 have a smaller measurement, and 3 have a larger one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخط المنقط العلوي (المئين 97): لدى نحو 97 من كل 100 قياس أصغر، ولدى 3 قياس أكبر."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Línea superior de puntos (percentil 97): unos 97 de cada 100 tienen una medida menor y 3, una mayor."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خط نقطه‌چین بالا (صدک 97): حدود 97 نفر از هر 100 کودک اندازه‌ای کوچک‌تر و 3 نفر اندازه‌ای بزرگ‌تر دارند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itaas na tuldok-tuldok na linya (ika-97 percentile): humigit-kumulang 97 sa bawat 100 ang may mas maliit na sukat, at 3 ang may mas malaki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligne pointillée supérieure (percentile 97) : environ 97 sur 100 ont une mesure plus petite et 3 ont une mesure plus grande."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर की बिंदु वाली रेखा (97वाँ प्रतिशतक): हर 100 में लगभग 97 का माप छोटा और 3 का माप बड़ा होता है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liy pwen anlè a (pèsantil 97): anviwon 97 sou chak 100 gen yon mezi ki pi piti, epi 3 gen yon mezi ki pi gwo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위 점선(97 백분위): 100명 중 약 97명은 측정값이 더 작고 3명은 더 큽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linha pontilhada superior (percentil 97): cerca de 97 em cada 100 têm uma medida menor, e 3 têm uma medida maior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Верхняя точечная линия (97-й процентиль): примерно у 97 из 100 детей значение меньше, а у 3 — больше."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xariiqda dhibcaha ee sare (darajada 97): qiyaastii 97 ka mid ah 100 ayaa leh cabbir ka yar, halka 3 ay leeyihiin cabbir ka weyn."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường chấm trên (bách phân vị thứ 97): khoảng 97 trong 100 trẻ có số đo nhỏ hơn và 3 trẻ có số đo lớn hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上方点线（第97百分位）：每100名儿童约有97名的测量值更小，3名更大。"
          }
        }
      }
    },
    "Use Merge caregiver profiles to combine profiles, or Separate profiles to undo a merge." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم «دمج ملفات مقدمي الرعاية» لدمج الملفات، أو «فصل الملفات» للتراجع عن الدمج."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Combinar perfiles de cuidadores para unir perfiles, o Separar perfiles para deshacerlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ترکیب پروفایل‌ها از «ادغام پروفایل‌های مراقبان» و برای لغو ادغام از «جداسازی پروفایل‌ها» استفاده کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang Magsama ng mga profile ng tagapag-alaga upang pagsamahin ang mga profile, o Maghiwalay ng mga profile upang ibalik ang isang pagsasama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Fusionner les profils de soignant pour combiner des profils ou Séparer les profils pour annuler une fusion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोफ़ाइलें जोड़ने के लिए «देखभालकर्ता प्रोफ़ाइलें मिलाएँ» और विलय रद्द करने के लिए «प्रोफ़ाइलें अलग करें» का उपयोग करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itilize Fizyone pwofil moun k ap bay swen pou mete pwofil ansanm, oswa Separe pwofil pou anile yon fizyon."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간호사 프로필 병합을 사용하여 프로필을 결합하거나 프로필 분리를 사용하여 병합을 실행 취소합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Mesclar perfis de cuidadores para combinar perfis ou Separação de perfis para desfazer uma mesclagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите «Объединить профили участников» для объединения или «Разделить профили» для его отмены."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U isticmaal isku darka profiles Caregiver in ay isku daraan profiles, ama kala qaybiyaan profiles si aad u joojiso isku darka."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng Hợp nhất hồ sơ người chăm sóc để gộp hồ sơ, hoặc Tách hồ sơ để hoàn tác việc hợp nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用\"合并护理人员配置文件\"来合并配置文件,或使用\"分离配置文件\"取消合并。"
          }
        }
      }
    },
