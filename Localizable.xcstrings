    "This duplicate was combined with another caregiver. Original records and authorship are still kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقد تم الجمع بين هذه النسخة وأخرى لمقدم رعاية آخر، ولا تزال السجلات الأصلية ووثائق التأليف محفوظة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este duplicado se combinó con otro cuidador. Se conservan los registros y sus autores originales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اين رونوشت با مراقب ديگه اي ادغام شده. سوابق اصلي و نویسندگي هنوز نگه داشته ميشه"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang duplicate na ito ay pinagsama sa isa pang tagapag-alaga. Orihinal na mga talaan at may-akda ay pa rin pinananatili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce doublon a été fusionné avec un autre profil. Les enregistrements d’origine et leurs auteurs sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस नक़ल को दूसरे देखभालकर्ता के साथ जोड़ा गया था. मूल रिकॉर्ड और लेखकत्व अभी भी बनाए रखा गया है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplikat sa a te konbine avèk yon lòt moun ki pran swen li. Dosye orijinal yo ak otè yo toujou rete."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 중복 프로필은 다른 보호자와 병합되었습니다. 원래 기록과 작성자 정보는 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este duplicado foi combinado com outro cuidador. Registros originais e autoria ainda são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот дублирующийся профиль объединён с другим участником. Исходные записи и авторство сохранены."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dukumiintigan isku mid ah ayaa la isku daray la caawiye kale. Taariikhda asalka iyo authorship weli waa in la ilaaliyo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ trùng này đã được hợp nhất với người chăm sóc khác. Các bản ghi gốc và thông tin người ghi vẫn được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这份副本与另一位护理人员合并,原始记录和作者仍然保留。"
          }
        }
      }
    },
    "This entry can’t be undone from a widget. Review it in Swaddle." : {
      "localizations" : {
