            "value" : "无法读取记录。 您保存的数据已被保留。"
          }
        }
      }
    },
    "A revision and its family have different iCloud zones" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنقيح وعائلته لديها مناطق مختلفة iCloud"
