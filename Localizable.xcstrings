            "value" : "Ilagay ang dami ng na-pump para magamit ang I-save."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez la quantité de lait maternel exprimée pour activer Enregistrer."
          }
