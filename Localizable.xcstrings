        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기록은 다른 가족에 속합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este registro pertence a uma família diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта запись относится к другой семье."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekorkan waxaa iska leh qoyska kale."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi này thuộc gia đình khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个记录属于另一个家族。"
          }
        }
      }
    },
    "This record is no longer available in your family. It may have been deleted, or need an edit reviewed in Swaddle." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا السجل لم يعد متاحا في أسرتك، ربما تم حذفه، أو يحتاج إلى تعديل تم استعراضه في Swaddle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este registro ya no está disponible en tu familia. Puede haberse eliminado o necesitar una revisión de cambios en Swaddle."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این رکورد دیگر در خانواده شما موجود نیست. ممکن است حذف شده باشد، یا نیاز به ویرایش دارد که در Swaddle بررسی شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang talaang ito ay hindi na magagamit sa iyong pamilya. Maaaring tinanggal, o kailangan ng isang edit na sinuri sa Swaddle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document n'est plus disponible dans votre famille, il a peut-être été supprimé ou nécessite une modification révisée dans Swaddle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह रिकॉर्ड आपके परिवार में अब उपलब्ध नहीं है. इसे मिटाया जा सकता है, या इसमें संपादन की समीक्षा की आवश्यकता हो सकती है Swaddle."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enskrisyon sa a pa disponib plis nan fanmi ou. Li ka te efase, oswa bezwen yon modifye revize nan Swaddle."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족에서 이 기록을 더 이상 사용할 수 없습니다. 삭제되었거나 Swaddle에서 수정 사항을 검토해야 할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este registro não está mais disponível em sua família, pode ter sido excluído ou precisa de uma edição revisada no Swaddle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта запись больше недоступна в семье. Возможно, она удалена или в Swaddle нужно проверить конфликтующие изменения."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeybtan waa aan ka heli karin qoyskaada. Waxaa laga yaabaa in la tirtiro, ama u baahan tahay edit dib loo eego in Swaddle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gia đình bạn không còn truy cập được bản ghi này. Bản ghi có thể đã bị xóa hoặc cần xem lại chỉnh sửa trong Swaddle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的家庭中已无法访问此记录。它可能已被删除，或有编辑需要在Swaddle中检查。"
          }
        }
      }
    },
    "This removes the child and their activity from your family log and widgets. Siblings and maternal pumping are preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل هذا الطفل وأنشطته من سجل العائلة والودجات. تبقى بيانات الإخوة والأخوات وجلسات شفط حليب الأم محفوظة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina al bebé y su actividad del diario familiar y los widgets. Se conservan los hermanos y las extracciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار کودک و فعالیتش را از دفتر خانواده و ویجت‌ها حذف می‌کند. اطلاعات خواهر و برادرها و دوشیدن شیر مادر حفظ می‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aalisin ang bata at ang mga aktibidad niya sa tala ng pamilya at mga widget. Mananatili ang mga kapatid at pag-pump ng ina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime l'enfant et son activité du journal de votre famille et des widgets, mais les frères et sœurs et le lait maternel exprimé par la mère sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे बच्चा और उसकी गतिविधि परिवार लॉग और विजेट से हटेंगे। भाई-बहनों और माँ के दूध निकालने के रिकॉर्ड सुरक्षित रहेंगे।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa retire timoun nan ak aktivite li nan jounal fanmi ak widget yo. Frè ak sè yo ak sesyon tire lèt manman an rete."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 아이와 활동 기록이 가족 기록과 위젯에서 제거됩니다. 다른 아이와 모유 유축 기록은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso removerá a criança e sua atividade do registro da família e dos widgets, mas os irmãos e o leite materno extraído serão preservados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль ребёнка и записи об уходе будут удалены из семейного журнала и виджетов. Профили других детей и сцеживания мамы сохранятся."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tani waxay ilmaha iyo hawlihiisa ka saartaa diiwaanka qoyska iyo widget-yada. Walaalaha iyo lisidda caanaha hooyada waa la hayaa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này xóa bé và hoạt động của bé khỏi nhật ký gia đình và các tiện ích. Hồ sơ anh chị em và các lần hút sữa của mẹ vẫn được giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从您的家庭日志和小部件中删除孩子及其活动。 兄弟姐妹和母亲抽取的母乳会保留下来。"
          }
        }
      }
    },
    "This session belongs to a deleted profile. Choose another pumping profile to move it, or restore the original profile in Settings → Review edits & deleted entries." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الجلسة تنتمي إلى ملف تعريف محذوف. اختر ملف تعريف آخر لإخراج لبن الثدي لنقله، أو استعادة ملف التعريف الأصلي في الإعدادات → مراجعة التعديلات والقيود المحذوفة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión pertenece a un perfil eliminado. Elige otro perfil de extracción para moverla o restaura el original en Ajustes → Revisar cambios y registros eliminados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این نوبت متعلق به پروفایل حذف‌شده است. برای جابه‌جایی، پروفایل دوشیدن شیر دیگری انتخاب کنید یا پروفایل اصلی را در تنظیمات ← بررسی ویرایش‌ها و مدخل‌های حذف‌شده بازگردانید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang sesyong ito ay nasa tinanggal na profile. Pumili ng ibang profile para sa pag-pump upang ilipat ito, o ibalik ang orihinal sa Mga Setting → Tingnan ang mga edit at tinanggal na entries."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session appartient à un profil supprimé. Choisissez un autre profil d'expression de lait maternel pour le déplacer ou restaurez le profil original dans Paramètres → Réviser les modifications et les entrées supprimées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सत्र हटाई गई प्रोफ़ाइल का है। इसे दूसरी दूध निकालने की प्रोफ़ाइल में ले जाएँ, या सेटिंग्स → संपादन और मिटाई गई प्रविष्टियों की समीक्षा करें में मूल प्रोफ़ाइल बहाल करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesyon sa a pou yon pwofil ki efase. Chwazi yon lòt pwofil tire lèt pou deplase l, oswa retabli pwofil orijinal la nan Paramèt → Revize chanjman ak antre efase."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 유축 기록은 삭제된 프로필의 것입니다. 다른 유축 프로필을 선택해 옮기거나 설정 → 편집 및 삭제된 항목 검토에서 원래 프로필을 복원하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sessão pertence a um perfil excluído. Escolha outro perfil de extração para movê-la ou restaure o original em Configurações → Revisar alterações e registros excluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс относится к удалённому профилю. Выберите другой профиль для сцеживания, чтобы перенести сеанс, либо восстановите исходный в разделе «Настройки» → «Просмотр изменений и удалённых записей»."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalfadhigan wuxuu leeyahay astaan la tirtiray. U dooro astaan kale oo lisidda caanaha ah si aad u wareejiso, ama astaantii asalka ahayd ka soo celi Dejinta → Dib u eeg wax-ka-beddellada iyo diiwaannada la tirtiray."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần hút sữa này thuộc hồ sơ đã xóa. Chọn hồ sơ hút sữa khác để chuyển, hoặc khôi phục hồ sơ gốc tại Cài đặt → Xem lại các mục sửa đổi và xoá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此会话属于已删除的配置文件。 选择另一个抽奶配置文件以移动它,或在设置 → 查看编辑和删除条目 中恢复原始配置文件。"
          }
        }
      }
    },
    "This Simulator build saves locally. Sharing becomes available in a signed device build with iCloud configured." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ هذا البناء المحاكي محلياً. يصبح التشارك متاحاً في بناء جهاز موقع مع iCloud تم تشكيله."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión del simulador guarda localmente. Compartir está disponible en una versión firmada para dispositivo con iCloud configurado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این ساخت شبیه‌ساز به‌طور محلی ذخیره می‌شود. اشتراک‌گذاری در یک ساخت دستگاه امضا شده با پیکربندی iCloud در دسترس خواهد بود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang Simulator build na ito ay nagse-save ng lokal. Pagbabahagi ay magagamit sa isang nakarehistrong device build na may iCloud na naka-configure."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version pour simulateur enregistre localement. Le partage est disponible dans une version signée pour appareil avec iCloud configuré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सिमुलेटर बिल्ड स्थानीय रूप से सहेजता है. शेयरिंग एक हस्ताक्षरित उपकरण बिल्ड में उपलब्ध हो जाता है iCloud विन्यस्त के साथ."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulateur sa a enskri lokalman. Partage vin disponib nan yon aparèy ki siyen ak iCloud konfigirasyon."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 시뮬레이터 빌드는 기기에 저장합니다. iCloud가 설정된 서명된 기기용 빌드에서 공유할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão do simulador salva localmente. O compartilhamento está disponível em uma versão assinada para dispositivo com iCloud configurado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сборка симулятора сохраняется локально. Совместное использование становится доступным в подписанной сборке устройства с настроенным iCloud."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tani Simulator dhismaha badbaadin gudaha. Sharing ka heli kartaa qalab la saxiixay dhismaha la iCloud configurated."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dành cho trình mô phỏng này lưu cục bộ. Tính năng chia sẻ có trong bản dành cho thiết bị đã ký và cấu hình iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模拟器构建在本地保存。 在配置了 iCloud 的已签名设备构建中可使用共享功能。"
          }
        }
      }
    },
    "This source and ID already exist for this child. Reimporting does not update an entry; edit the saved entry to make corrections." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا المصدر والمعرّف موجودان مسبقًا لهذا الطفل. لا يحدث الاستيراد السجل الموجود؛ عدّل السجل المحفوظ لإجراء التصحيح."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este source e id ya existen para este bebé. Volver a importar no actualiza un registro; edita el registro guardado para corregirlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این منبع و شناسه از قبل برای این فرزند وجود دارد. واردات مجدد مدخلی را به‌روزرسانی نمی‌کند؛ مدخل ذخیره‌شده را برای انجام تصحیح ویرایش کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pinagmulan at ID na ito ay umiiral na para sa anak na ito. Reimporting hindi i-update ang isang entry; i-edit ang naka-save na entry upang gumawa ng mga pagwawasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette source et cet ID existent déjà pour cet enfant. La réimportation ne met pas à jour une entrée. Modifiez l'entrée enregistrée pour apporter des corrections."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्रोत तथा आईडी इस शाखा के लिए पहले से ही मौजूद है. फिर से आयात करना प्रविष्टि को अद्यतन नहीं करता; सुधार करने के लिए सहेजी गई प्रविष्टि का संपादन करें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijin ak ID sa a deja egziste pou pitit sa a. Re-enpòte pa mete yon entrée ajou; modifye entrée a pou fè koreksyon yo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 아이에게 같은 source와 ID의 기록이 이미 있습니다. 다시 가져와도 기록은 업데이트되지 않습니다. 수정하려면 저장된 기록을 편집하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta origem e ID já existem para este filho.A reimportação não atualiza uma entrada; edite a entrada salva para fazer correções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого ребёнка уже есть запись с такими source и id. Повторный импорт не обновляет запись. Для исправления отредактируйте сохранённую запись."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asalkan iyo ID-ka ayaa horeyba ugu jira ilmahaan. Mar kale soo dejinta ma cusbooneysiinayso gelitaan; hagaaji gelinta la kaydiyey si aad wax uga bedelto."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguồn và ID này đã có cho bé này. Nhập lại không cập nhật bản ghi; hãy sửa bản ghi đã lưu để điều chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个孩子已有相同来源和ID的记录。重新导入不会更新记录，请编辑已保存的记录进行更正。"
          }
        }
      }
    },
    "This source and ID are already imported. Edit the existing session to correct it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبق استيراد هذا المصدر والمعرّف. عدّل الجلسة الموجودة لتصحيحها."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este source e id ya se importaron. Edita la sesión existente para corregirla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این منبع و شناسه از قبل وارد شده‌اند. برای تصحیح آن ، نشست موجود را ویرایش کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pinagmulan at ID ay nai-import na. I-edit ang umiiral na session upang ayusin ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette source et cet ID sont déjà importés. Modifiez la session existante pour corriger cela."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्रोत तथा आईडी पहले से ही आयातित है. इसे ठीक करने के लिए मौज़ूदा सत्र को संपादित करें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous ak ID sa yo deja enpòte. Modifye sesyon ki deja la pou korije li."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 소스와 ID는 이미 가져왔습니다. 기존 세션을 편집하여 수정하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta origem e ID já foram importados. Edite a sessão existente para corrigi-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот источник и идентификатор уже импортированы. Измените существующую сессию, чтобы исправить это."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asalkan iyo ID-ka ayaa horeyba loo soo dejiyey. Edit kulanka hadda jira si aad u saxdo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguồn và ID này đã được nhập. Sửa lần hút sữa hiện có để điều chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此源和 ID 已导入。 编辑现有会话以更正它。"
          }
        }
      }
    },
    "This total is kept separately from milk and formula. Turn off “Split not recorded” to enter the composition." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ هذا الإجمالي منفصلًا عن حليب الأم والحليب الصناعي. أوقف «التقسيم غير المسجل» لإدخال كمية كل منهما."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este total se cuenta por separado de la leche y la fórmula. Desactiva «Desglose no registrado» para introducir la composición."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این مجموع جدا از شیر مادر و شیر خشک ذخیره می‌شود. برای وارد کردن مقدار هرکدام، «تقسیم ضبط نشد» را خاموش کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang kabuuan na ito ay pinananatili nang hiwalay mula sa gatas at formula gatas. I-off ang “Split hindi naitala” upang ipasok ang komposisyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce total est comptabilisé séparément du lait maternel et du lait infantile. Désactivez « Répartition non précisée » pour saisir la composition."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस कुल को दूध और फार्मूला दूध से अलग रखा जाता है. रचना में प्रवेश करने के लिए “विभाजित नहीं दर्ज किया गया” बंद करें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total sa a separe ak total lèt manman ak lèt fòmil. Dezaktive «Repatisyon an pa anrejistre» pou antre konpozisyon an."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 총량은 모유와 분유의 양과 별도로 저장됩니다. 각 양을 입력하려면 “구성별 양 미기록”을 끄세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este total é contabilizado separadamente do leite e da fórmula. Desative “Divisão não registrada” para informar a composição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот объём учитывается отдельно от молока и смеси. Выключите «Состав не записан», чтобы указать компоненты."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirada guud ee waxaa laga ilaaliyaa oo ka duwan caanaha iyo formula caanaha. Ka saaro \"Split aan la diiwaan gelin\" si ay u galaan isku darka."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tổng lượng này được lưu riêng với lượng sữa mẹ và sữa công thức. Tắt “Chưa ghi lượng từng loại” để nhập thành phần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此总量与母乳和配方奶用量分开保存。关闭“未记录各成分用量”即可输入组成。"
          }
        }
      }
    },
    "This updates the shared family log. You can restore it in Settings → Review edits & deleted entries." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يقوم بتحديث سجل الأسرة المشترك. يمكنك استعادته في الإعدادات → مراجعة التحرير والقيود المحذوفة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto actualiza el diario familiar compartido. Puedes restaurarlo en Ajustes → Revisar cambios y registros eliminados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این ، ثبت خانوادگی مشترک را به‌روزرسانی می‌کند. می‌توانید آن را در تنظیمات → بازنگری ویرایشها و مدخلهای حذف‌شده بازگردانید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ito ay nag-a-update ang ibinahaging pamilya log. Maaari mong ibalik ito sa Mga Setting → Suriin edits & tinanggal na mga entry."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action met à jour le journal familial partagé. Vous pouvez restaurer l’entrée dans Réglages → Réviser les modifications et les entrées supprimées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह साझा परिवार लॉग को अद्यतन करता है. आप इसे विन्यास → संपादन और मिटाई गई प्रविष्टियों की समीक्षा में बहाल कर सकते हैं."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa a mete ajou dosye fanmi an pataje. Ou ka refè li nan Paramèt → Gade modifye & efase entrées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 하면 공유 가족 기록이 업데이트됩니다. 설정 → 편집 및 삭제된 항목 검토에서 복원할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação atualiza o diário familiar compartilhado. Você pode restaurar o registro em Configurações → Revisar alterações e registros excluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это обновляет общий семейный журнал. Вы можете восстановить его в Настройки → Просмотр изменений и удаленных записей."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tani waxay cusbooneysiisaa log qoyska wadaagaan. Waxaad dib u soo celin kartaa Settings → Review edits & entries tirtirto."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này cập nhật bản ghi gia đình được chia sẻ. Bạn có thể khôi phục nó trong Thiết lập → Kiểm tra sửa đổi và mục đã xoá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会更新共享的家庭日志,您可以在设置 → 查看编辑和删除条目 中恢复它。"
          }
        }
      }
    },
