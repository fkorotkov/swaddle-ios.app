    "occurredAt needs a full date, time, seconds, and UTC offset, such as 2026-05-10T08:30:00-04:00." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt يحتاج إلى التاريخ الكامل والوقت والثواني والانتقال إلى الوقت العالمي المنسق، مثل 2026-05-10T08:30:00-04:00."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt necesita una fecha completa, hora, segundos y desfase UTC, como 2026-05-10T08:30:00-04:00."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt نیازمند یک تاریخ کامل، زمان، ثانیه و جابجایی ساعت هماهنگ جهانی است، مانند 2026-05-10T08:30:00-04:00."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt pangangailangan ng isang buong petsa, oras, segundo, at UTC offset, tulad ng 2026-05-10T08:30:00-04:00."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt nécessite une date complète, l'heure, les secondes et le décalage UTC, tel que 2026-05-10T08:30:00-04:00."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt को पूर्ण तिथि, समय, सेकण्ड तथा यूटीसी ऑफसेट की आवश्यकता होती है, जैसे कि 2026-05-10T08:30:00-04:00."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt bezwen yon dat konplè, lè, segonn, ak diferans UTC, tankou 2026-05-10T08:30:00-04:00."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt 는 전체 날짜, 시간, 초 및 UTC 오프셋이 필요합니다(예: 2026-05-10T08:30:00-04:00)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt precisa de uma data completa, hora, segundos e deslocamento UTC, como 2026-05-10T08:30:00-04:00."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt требует полную дату, время, секунды и смещение по UTC, например 2026-05-10T08:30:00-04:00."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt u baahan yahay taariikh buuxda, waqti, ilbiriqsi, iyo UTC offset, sida 2026-05-10T08:30:00-04:00."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt cần đầy đủ ngày, giờ, giây và độ lệch UTC, chẳng hạn như 2026-05-10T08:30:00-04:00."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "occurredAt 需要完整的日期、时间、秒数和 UTC 偏移值,例如 2026-05-10T08:30:00-04:00。"
          }
        }
      }
    },
