    "Start a timer or enter a duration." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ توقيتا أو أدخل مدة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia un temporizador o introduce una duración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شروع یک زمان‌سنج یا وارد کردن یک مدت."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magsimula ng isang timer o ipasok ang tagal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrez une minuterie ou entrez une durée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टाइमर प्रारंभ करें या अवधि भरें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kòmanse yon kwonomèt oswa antre yon dire."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머를 시작하거나 기간을 입력합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie um temporizador ou insira uma duração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустить таймер или ввести продолжительность."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilow saacad ama geli muddo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu đồng hồ đếm thời gian hoặc nhập thời gian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动计时器或输入持续时间。"
          }
        }
      }
    },
    "Start on either side. Pause whenever you need. Your timer stays with %@, even when you leave the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بأي جانب وتوقف مؤقتًا عند الحاجة. يبقى المؤقت مرتبطًا بـ%@ حتى عند مغادرة التطبيق."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza por cualquiera de los lados. Pausa cuando lo necesites. El temporizador sigue vinculado a %@, aunque salgas de la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از هر سمتی شروع کنید و هر وقت لازم بود مکث کنید. حتی پس از خروج از برنامه، زمان‌سنج به %@ مربوط می‌ماند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magsimula sa alinmang panig. Mag-pause kapag kailangan. Mananatili ang timer kay %@ kahit umalis ka sa app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par le sein de votre choix. Faites une pause quand vous voulez. Le minuteur reste lié à %@, même si vous quittez l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी तरफ से प्रारंभ करें. जब भी आपकी आवश्यकता हो ठहरें. आपका टाइमर %@ के साथ रहता है, तब भी जब आप अनुप्रयोग छोड़ते हैं."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kòmanse sou nenpòt bò. Mete an pausa lè ou bezwen li. Timè w la rete ak %@, menm si ou kite aplikasyon an."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 쪽에서든 시작하고 필요할 때 일시 정지하세요. 앱을 나가도 타이머는 %@의 기록에 연결되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece de qualquer lado e faça uma pausa sempre que precisar. Seu cronômetro permanece com %@, mesmo quando você sair do aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с любой стороны. Приостанавливайтесь, когда вам нужно. Ваш таймер остается с %@, даже когда вы покидаете приложение."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilow dhinac kasta. Jooji marka aad u baahan tahay. Waqtigaaga wuxuu ku noolaanayaa %@, xitaa marka aad ka tagto app."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu ở bên nào cũng được. Tạm dừng khi cần. Bộ đếm giờ vẫn gắn với %@ ngay cả khi bạn rời ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以从任意一侧开始，随时暂停。即使离开应用，计时器也会继续关联%@。"
          }
        }
      }
    },
