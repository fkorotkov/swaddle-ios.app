    "Read the current saved details of a care record, including its child or caregiver and time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراءة التفاصيل الحالية المسجلة لسجل الرعاية، بما في ذلك الطفل أو مقدم الرعاية والوقت."
