    "Can view all shared activity. Can’t add, change, or delete entries." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنه رؤية جميع الأنشطة المشتركة. لا يمكنه إضافة أو تغيير أو حذف القيود."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede ver toda la actividad compartida. No puede añadir, cambiar ni eliminar registros."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "می‌تواند تمام فعالیت‌های مشترک را ببیند. نمی‌تواند مدخل‌ها را اضافه، تغییر یا حذف کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaaring tingnan ang lahat ng ibinahaging aktibidad. Hindi maaaring magdagdag, baguhin o tanggalin ang mga entry."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut afficher toutes les activités partagées. Ne peut pas ajouter, modifier ou supprimer des entrées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी साझा गतिविधि देख सकता है. प्रविष्टियों को जोड़, बदले या मिटा नहीं सकता है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka wè tout aktivite pataje. Pa ka ajoute, chanje oswa efase entrées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 공유 활동을 볼 수 있습니다. 항목을 추가, 변경 또는 삭제할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode ver todas as atividades compartilhadas. Não pode adicionar, alterar ou excluir entradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно просматривать все общие записи. Добавление, изменение и удаление недоступны."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka arki kartaa dhammaan hawlgalka wadaagaan. Ma kordhin karo, bedeli, ama tirtirto diiwaangelinta."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể xem tất cả các hoạt động chia sẻ. Không thể thêm, thay đổi hay xóa mục nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以查看所有共享活动,但无法添加、更改或删除条目。"
          }
