    "Import pumping separately from feeds. Use type “pump” for every line in this batch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استورد شفط الحليب منفصلًا عن الرضعات. استخدم type «pump» لكل سطر في هذه الدفعة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa las extracciones por separado de las tomas. Usa el tipo «pump» en todas las líneas de este lote."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوشیدن شیر را جدا از تغذیه وارد کنید. در تمام خطوط این دسته، type را «pump» قرار دهید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-import ang pag-pump nang hiwalay sa pagpapakain. Gamitin ang type “pump” sa bawat linya ng batch na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez les tirages séparément des repas. Utilisez le type « pump » sur chaque ligne de ce lot."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूध निकालने के रिकॉर्ड, दूध पिलाने से अलग आयात करें। इस बैच की हर पंक्ति में type “pump” रखें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enpòte sesyon tire lèt separe ak alimantasyon. Itilize type “pump” pou chak liy nan pakèt sa a."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유축과 수유 기록은 따로 가져오세요. 이 묶음의 모든 줄에서 type을 “pump”로 지정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe as extrações separadamente das mamadas. Use o tipo “pump” em todas as linhas deste lote."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте сцеживания отдельно от кормлений. В каждой строке этой партии укажите type «pump»."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisidda caanaha si gooni ah uga soo deji quudinta. Saf kasta oo dufcaddan ah u isticmaal type “pump”."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập hút sữa riêng với cữ bú. Mọi dòng trong đợt này phải có type là “pump”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将泵奶和喂养分开导入。本批次每行的type都应为“pump”。"
          }
        }
      }
    },
