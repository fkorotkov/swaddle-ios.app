    "Select the complete version you want to keep. Amounts won’t be combined." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر النسخة الكاملة التي تريد الاحتفاظ بها. لن تُجمع الكميات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona la versión completa que quieres conservar. Las cantidades no se sumarán."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه کاملی که می‌خواهید نگه دارید را انتخاب کنید. مقادیر ترکیب نمی‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin ang kumpletong bersyon na gusto mong panatilihin. Ang mga halaga ay hindi pinagsama-sama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez la version complète que vous souhaitez conserver. Les montants ne seront pas combinés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूर्ण संस्करण चुनें जिसे आप रखना चाहते हैं. मात्राओं को जोड़ा नहीं जाएगा."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chwazi vèsyon an konplè ou vle kenbe. Montan yo pa pral konbine."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유지할 전체 버전을 선택하세요. 기록된 양은 합산되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione a versão completa que você deseja manter. Os valores não serão combinados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите полную версию, которую нужно сохранить. Объёмы не суммируются."
          }
        },
