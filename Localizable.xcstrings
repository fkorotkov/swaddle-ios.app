    "iCloud couldn’t find a recipient for that address. Check their Apple Account email and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتمكن iCloud من العثور على مستلم لهذا العنوان. تحقق من البريد الإلكتروني لحساب Apple الخاص به وحاول مجددًا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no encontró un destinatario para esa dirección. Revisa el correo de su Cuenta de Apple y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud گیرنده‌ای برای این نشانی پیدا نکرد. ایمیل حساب Apple او را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi natagpuan ng iCloud ang isang tatanggap para sa address na iyon. Tingnan ang kanilang email sa Apple Account at subukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud n’a pas pu trouver de destinataire pour cette adresse. Vérifiez l’e-mail du compte Apple et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud उस पता के लिए कोई प्राप्तकर्ता नहीं पा सका. उनके Apple खाता ईमेल को जाँचें और फिर कोशिश करें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud pa t ka jwenn yon destinataire pou adrès sa a. Tcheke kont imel Apple yo epi eseye ankò."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 그 주소에 대한 수신자를 찾을 수 없습니다. 사용자의 Apple 계정 이메일을 확인하고 다시 시도합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud não conseguiu encontrar um destinatário para esse endereço. Verifique o e-mail da Conta Apple dele e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud не смог найти получателя для этого адреса. Проверьте электронную почту их Apple Account и попробуйте еще раз."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ma heli karo qof loo soo diro ee cinwaanka. Ka hubi emailkooda Apple Account iyo dib u isku day."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud không tìm thấy người nhận cho địa chỉ đó. Kiểm tra email của tài khoản Apple và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 无法找到该地址的收件人。 检查他们的 Apple 帐户电子邮件并重试。"
          }
        }
      }
    },
