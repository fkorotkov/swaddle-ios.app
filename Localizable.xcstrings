          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша учетная запись семьи или iCloud изменилась. Повторно откройте Семейный доступ, чтобы продолжить."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qoyskaaga ama akoonka iCloud ayaa isbeddelay. Mar kale fur Wadaagidda qoyska si aad u sii waddo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản gia đình hoặc iCloud của bạn đã thay đổi. Mở lại chia sẻ gia đình để tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
