        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके परिवार के लॉग को पढ़ने या बदलने से पहले आपका उपकरण सत्यापित होना चाहिए."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparèy ou dwe otorize anvan li ka li oswa chanje dosye fanmi w lan."
