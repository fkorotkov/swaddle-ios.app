        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluído na ingestão total. Nenhuma quantidade de leite ou fórmula é adivinhada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включено в общий объём питания. Объёмы молока и смеси не определяются наугад."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaa lagu daraa wadarta la cabbay. Qaddarka caanaha naaska ama booraha lama qiyaaso."
