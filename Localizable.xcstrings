        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक रिकॉर्ड पढ़ा नहीं जा सका. आपका सहेजा गया डाटा संरक्षित किया गया है."
          }
        },
        "ht" : {
          "stringUnit" : {
