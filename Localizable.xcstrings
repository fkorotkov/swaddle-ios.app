    "More than one caregiver profile is linked to your invitation. Ask the family owner to resolve the profiles; your history is preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان هناك أكثر من ملف رعاية واحد مرتبط بدعوتك، فاطلب من مالك الأسرة حل ملف الرعاية؛ وسوف يتم الحفاظ على تاريخك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay más de un perfil de cuidador vinculado a tu invitación. Pide al propietario de la familia que resuelva los perfiles; tu historial se conserva."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بیش از یک پروفایل مراقب به دعوت‌نامه شما پیوند خورده است. از مالک خانواده بخواهید که پروفایل‌ها را حل کند؛ تاریخچه شما حفظ می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higit sa isang profile ng tagapag-alaga ang naka-link sa iyong imbitasyon. Hilingin sa may-ari ng pamilya na malutas ang mga profile; pinapanatili ang iyong kasaysayan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs profils de soignant sont liés à votre invitation. Demandez au propriétaire de la famille de résoudre les profils. Votre historique est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक से अधिक देखभालकर्ता प्रोफ़ाइल आपके निमंत्रण के साथ जुड़ा है. परिवार मालिक को प्रोफ़ाइलों को हल करने के लिए पूछें; आपका इतिहास संरक्षित है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plis pase yon pwofil moun ki pran swen an se lyen pou envitasyon ou. Mande pwopriyetè fanmi an pou rezoud pwofil yo; istwa w la pral konsève."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초대에 여러 보호자 프로필이 연결되어 있습니다. 가족 소유자에게 프로필을 정리해 달라고 요청하세요. 이력은 보존됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais de um perfil de cuidador está vinculado ao seu convite.Peça ao proprietário da família para resolver os perfis; o seu histórico é preservado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С приглашением связано несколько профилей участников. Попросите владельца семьи разобраться с профилями. История сохранена."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ka badan hal profile daryeel bixiyaha ayaa la xiriira martiqaadkaaga. weydii mulkiilaha qoyska si ay u xalliso profiles; taariikhdaada waa la ilaaliyaa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có nhiều hơn một hồ sơ người chăm sóc được liên kết với lời mời của bạn. Hãy yêu cầu chủ gia đình giải quyết các hồ sơ; lịch sử của bạn sẽ được bảo tồn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与您的邀请关联了多个护理人员资料。 请家庭所有者解决这些资料;您的历史记录将会保留。"
          }
        }
      }
    },
    "More than one family is available. Resolve family membership before recording." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان هناك أكثر من أسرة واحدة متاحة، حدد العضوية قبل التسجيل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay más de una familia disponible. Resuelve la pertenencia a la familia antes de registrar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بیش از یک خانواده در دسترس است. قبل از ضبط، عضویت خانواده را حل کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higit sa isang pamilya ay magagamit. Ayusin ang pagiging kasapi ng pamilya bago mag-record."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs familles sont disponibles. Résolvez l'appartenance à la famille avant d'enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक से अधिक परिवार उपलब्ध है. रिकॉर्ड करने से पहले परिवार सदस्यता को हल करें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plis pase yon fanmi disponib. Rezoud manm fanmi an anvan w enskri."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 가족이 있습니다. 기록하기 전에 가족 소속을 정리하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais de uma família está disponível. Resolva a associação à família antes da gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступно несколько семей. Прежде чем добавлять записи, определите, к какой семье вы относитесь."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mid ka badan hal qoys ayaa jira. Go'aamiya xubinta qoyska ka hor diiwaangelinta."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có nhiều hơn một gia đình. Xác định thành viên trong gia đình trước khi ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多个家庭可用。 在录制之前解决家庭成员资格问题。"
          }
        }
      }
    },
    "More ways to ask" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المزيد من الطرق للسؤال"
          }
        },
        "es" : {
          "stringUnit" : {
