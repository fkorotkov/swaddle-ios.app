    "Supply a positive totalML, or both recorded leftML and rightML amounts. No volume can be inferred when all are unknown." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل totalML موجبًا، أو كميتي leftML وrightML المسجلتين. لا يمكن استنتاج الكمية إذا كانت جميعها مجهولة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proporciona un totalML positivo o ambas cantidades registradas de leftML y rightML. No se puede deducir un volumen si todos son desconocidos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک مقدار totalML مثبت یا هر دو مقدار leftML و rightML ثبت شده را فراهم کنید. هیچ حجمی نمی‌توان در صورتی که همه ناشناخته باشند، استنتاج کرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supply ng isang positibong totalML, o parehong naitala leftML at rightML halaga. Walang dami ay maaaring inferred kapag ang lahat ay hindi kilala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournir un totalML positif, ou les deux quantités leftML et rightML enregistrées.Aucun volume ne peut être déduit lorsque tous sont inconnus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धनात्मक totalML दें, या दर्ज leftML और rightML दोनों दें। सभी अज्ञात हों तो मात्रा का अनुमान नहीं लगाया जा सकता।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bay yon totalML ki pi gran pase zewo, oswa kantite leftML ak rightML ki te anrejistre yo. Si tout kantite yo enkoni, Swaddle pa ka kalkile volim nan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양수인 totalML을 입력하거나 기록된 leftML과 rightML을 모두 입력하세요. 모두 알 수 없으면 용량을 추정할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forneça um totalML positivo, ou as quantidades leftML e rightML registradas Nenhum volume pode ser inferido quando todos são desconhecidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите положительное значение totalML либо оба записанных объёма leftML и rightML. Если все значения неизвестны, объём определить нельзя."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soo bandhigaan totalML wanaagsan, ama labadaba leftML iyo rightML tirada diiwaangashan. Volume aan la soo jeedin karaa marka dhammaantood ma oga."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập totalML lớn hơn 0, hoặc cả leftML và rightML đã ghi nhận. Không thể suy ra thể tích nếu tất cả đều chưa biết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请提供大于零的totalML，或同时提供已记录的leftML和rightML。所有数值都未知时，无法推算奶量。"
          }
        }
      }
    },
    "Supply both leftML and rightML, or leave both null/omitted when the split is unknown." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل leftML وrightML معًا، أو اجعل كليهما null/محذوفًا إذا لم تعرف الكمية لكل جانب."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proporciona leftML y rightML, o deja ambos null/omitidos si no conoces el desglose."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر دو leftML و rightML را فراهم کنید، یا هر دو null/حذف شده بگذارید هنگامی که تقسیم ناشناخته است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suplay ng parehong leftML at rightML, o iwanan ang parehong null / omitted kapag ang split ay hindi kilala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournissez à la fois leftML et rightML, ou laissez les deux null/omis lorsque le fractionnement est inconnu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों leftML और rightML प्रदान करें, या जब विभाजन अज्ञात हो तो दोनों को null/omitted छोड़ दें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fòmilè sa a gen ladan tou de leftML ak rightML, oswa kite yo tou de null/omèt lè patisyon an pa konnen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "leftML과 rightML을 모두 입력하거나, 각 양을 모르면 둘 다 null로 두거나 생략하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe leftML e rightML, ou deixe ambos como null ou omitidos quando a divisão for desconhecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите оба значения leftML и rightML. Если объёмы с каждой груди неизвестны, оба должны быть null или отсутствовать."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siiyaan labada leftML iyo rightML, ama ka tag labaduba null / la joojiyay marka kala qaybinta ma cadda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho cả leftML và rightML, hoặc để lại cả hai null/hoặc bỏ qua khi phân chia không rõ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时提供 leftML 和 rightML,或在分割未知的情况下同时保留 null/省略。"
          }
        }
      }
    },
