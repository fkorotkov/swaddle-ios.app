    },
    "This change is shared with the family. Every previous version is retained." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تقاسم هذا التغيير مع الأسرة، ويتم الاحتفاظ بكل نسخة سابقة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cambio se comparte con la familia. Se conservan todas las versiones anteriores."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این تغییر با خانواده به اشتراک گذاشته می‌شود. هر نسخه قبلی نگه داشته می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibinabahagi ang pagbabagong ito sa pamilya. Pinapanatili ang bawat nakaraang bersyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette modification est partagée avec la famille et toutes les versions précédentes sont conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह परिवर्तन परिवार के साथ साझा किया गया है. प्रत्येक पिछला संस्करण रखा जाता है."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chanjman sa a pataje ak fanmi an. Tout vèsyon anvan yo rete."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
