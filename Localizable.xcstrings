    "%@ is compared with children of the same age and sex in the named reference. The midpoint is not a target." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويقارن %@ مع أطفال من نفس العمر ونفس الجنس في المرجع المذكور، ونقطة الوسط ليست هدفا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se compara %@ con niños de la misma edad y sexo en la referencia indicada. El punto medio no es una meta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ در مقایسه با کودکان هم سن و جنس در مرجع نامگذاری شده است. نقطه وسط هدف نیست."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inihahambing ang %@ sa mga batang kapareho ng edad at kasarian sa tinukoy na pamantayan. Hindi layunin ang gitnang halaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est comparé aux mesures d’enfants du même âge et du même sexe dans la référence indiquée. La médiane n’est pas un objectif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ नामित संदर्भ में उसी आयु और लिंग के बच्चों से तुलना की जाती है. मध्य बिंदु एक लक्ष्य नहीं है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yo konpare ak timoun ki gen menm laj ak sèks nan referans nonmen an. Pozisyon mitan se pa yon objektif."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@를 표시된 기준 집단에서 나이와 성별이 같은 아이들과 비교합니다. 중간값은 목표가 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é comparado às medidas de crianças da mesma idade e sexo na referência indicada. O ponto médio não é uma meta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сопоставляется с детьми того же возраста и пола в указанном справочном источнике. Средняя точка не является целевым показателем."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ waxaa lala barbar dhigaa carruurta ay isku da' iyo jinsi yihiin ee tixraaca la magacaabay. Bartamaha ma aha yool."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ được so sánh với trẻ cùng tuổi và giới tính trong bộ chuẩn được nêu. Giá trị giữa không phải là mục tiêu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将%@与所示参考标准中同龄、同性别的儿童比较。中位数并不是目标。"
          }
        }
      }
    },
