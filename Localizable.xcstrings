        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entèval referans, pa dat limit. Yo separe ak lis laj CDC yo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기준 범위, 마감일이 아닙니다. 이들은 CDC 연령 체크리스트와는 별도입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses são intervalos de referência, não prazos. Eles são separados das listas de verificação de idade do CDC."
