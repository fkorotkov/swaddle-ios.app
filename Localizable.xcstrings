          "stringUnit" : {
            "state" : "translated",
            "value" : "فردی را که شیر دوشیده انتخاب کنید. شیر دوشیده‌شده جدا از شیر مصرف‌شدهٔ هر کودک است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung sino ang nag-pump. Hiwalay ang na-pump na gatas sa nainom ng bawat bata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez qui a tiré son lait. Le lait tiré est comptabilisé séparément du lait consommé par chaque enfant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि दूध किसने निकाला। निकाला गया दूध हर बच्चे के पिए दूध से अलग है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chwazi moun ki tire lèt la. Lèt tire a separe ak kantite chak timoun bwè."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유축한 사람을 선택하세요. 유축량은 각 아이가 먹은 양과 별도로 기록됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quem extraiu o leite. O leite extraído é registrado separadamente do leite consumido por cada criança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, кто сцеживал молоко. Сцеженное молоко учитывается отдельно от питания каждого ребёнка."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dooro qofka caanaha lisay. Caanaha la lisay way ka duwan yihiin waxa ilmo kastaa cabbay."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn người đã hút sữa. Lượng sữa hút được tính riêng với lượng mỗi bé uống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择泵奶的人。泵出的奶与每个孩子喝下的奶分开统计。"
          }
        }
      }
    },
