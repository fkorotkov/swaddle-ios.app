    "An upload confirms receipt by iCloud. Each caregiver’s device downloads changes separately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وتؤكد عملية التحميل استلامها من قبل iCloud، وكل جهاز من أجهزة مقدمي الرعاية يقوم بتنزيل التغييرات بشكل منفصل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una carga confirma que iCloud ha recibido los datos. El dispositivo de cada cuidador descarga los cambios por separado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک بارگذاری دریافت را توسط iCloud تأیید می‌کند. هر دستگاه مراقب تغییرات را جداگانه دانلود می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinukumpirma ng pag-upload ang resibo sa iCloud. Ang bawat device ng tagapag-alaga ay nag-download ng mga pagbabago nang hiwalay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un envoi réussi confirme la réception par iCloud. L’appareil de chaque proche télécharge les changements séparément."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपलोड से iCloud को डेटा मिलने की पुष्टि होती है। हर देखभालकर्ता का डिवाइस बदलाव अलग से डाउनलोड करता है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lè done monte, sa konfime iCloud resevwa yo. Aparèy chak moun k ap bay swen telechaje chanjman yo apa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업로드 완료는 iCloud가 데이터를 받았다는 뜻입니다. 각 보호자의 기기는 변경 사항을 개별적으로 다운로드합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um upload confirma o recebimento pelo iCloud. Cada dispositivo do cuidador baixa as alterações separadamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправка подтверждает получение данных iCloud. Устройство каждого участника загружает изменения отдельно."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirista xogtu waxay xaqiijisaa in iCloud helay. Qalabka daryeele kasta si gaar ah ayuu isbeddellada u soo dejistaa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải lên xác nhận nhận được bởi iCloud. Mỗi thiết bị của người chăm sóc tải các thay đổi riêng biệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上传后,iCloud 会确认收到。 每个护理人员的设备分别下载更改内容。"
          }
        }
      }
    },
