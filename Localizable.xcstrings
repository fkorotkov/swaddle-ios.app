    "Amounts consumed · Milk includes expressed or donor milk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكميات المستهلكة · يشمل حليب الأم الحليب المشفوط أو المتبرع به."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cantidades consumidas · La leche incluye leche extraída o donada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقدار مصرف‌شده · شیر شامل شیر دوشیده‌شده یا اهدایی است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dami ng nainom · Kasama sa gatas ang na-pump o gatas mula sa donor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantités consommées · Le lait comprend le lait tiré ou provenant d’une donneuse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिया गया दूध · दूध में निकाला गया या दान किया गया दूध शामिल है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kantite tibebe a bwè · Lèt gen ladan lèt tire oswa lèt yon donatè bay."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먹은 양 · 모유에는 유축 모유와 기증 모유가 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantidades consumidas · Leite inclui leite extraído ou doado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выпитый объём · Молоко включает сцеженное и донорское."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qaddarka la cabbay · Caanaha waxaa ka mid ah kuwa la lisay ama deeq-bixiye bixiyey."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
