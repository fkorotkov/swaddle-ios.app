    "Family updates may be missing. Totals include the entries currently on this iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديثات الأسرة قد تكون مفقودة. المجموع يشمل القيودات الحالية على هذا iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que falten novedades de la familia. Los totales incluyen los registros disponibles en este iPhone."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ممکن است به‌روزرسانی‌های خانوادگی گم شده باشند. مجموع‌ها شامل مدخل‌هایی هستند که در حال حاضر روی این آی‌فون وجود دارند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaaring nawawala ang mga update ng pamilya. Kasama sa totals ang mga entry na kasalukuyang nasa iPhone na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des mises à jour de la famille peuvent manquer. Les totaux incluent les entrées actuellement présentes sur cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिवार अद्यतन गुम हो सकता है. कुल में इस iPhone पर वर्तमान में प्रविष्टि शामिल हैं."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka gen kèk ajou fanmi ki manke. Total yo gen ladann entrées sou iPhone sa a."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족 업데이트가 없을 수 있습니다. 총계는 현재 이 iPhone에 있는 항목을 포함합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podem faltar atualizações da família. Os totais incluem os registros que estão neste iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновления семьи могут отсутствовать. Итоговые значения включают записи, находящиеся в данный момент на этом iPhone."
          }
        },
        "so" : {
          "stringUnit" : {
