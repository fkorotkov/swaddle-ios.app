    "Get recorded breast milk, formula, total bottle intake, and separate breastfeeding time for a child." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على كميات حليب الأم والحليب الصناعي وإجمالي الرضّاعات المسجلة للطفل، مع مدة الرضاعة الطبيعية منفصلة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta la leche materna, la fórmula, el consumo total de biberón y el tiempo de lactancia de un bebé, contado por separado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقدار ثبت‌شدهٔ شیر مادر، شیر خشک و مجموع شیر شیشه را برای کودک ببینید؛ زمان شیردهی جداگانه نمایش داده می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumuha ng naitala breast milk, formula gatas, kabuuang baby bottle intake, at hiwalay na breastfeeding oras para sa isang bata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez le lait maternel enregistré, le lait de préparation, la consommation totale du biberon et le temps d'allaitement séparé pour un enfant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बच्चे के लिए दर्ज माँ का दूध, फ़ॉर्मूला दूध, बोतल से पिया कुल दूध और अलग स्तनपान का समय देखें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jwenn lèt manman, lèt fòmil, total lèt nan bibwon, ak tan bay tete pou yon timoun. Tan bay tete rete separe."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이의 기록된 모유량, 분유량, 총 젖병 수유량과 별도로 집계한 모유 수유 시간을 가져옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulte o leite materno, a fórmula, o consumo total por mamadeira e o tempo de amamentação de uma criança, contabilizado separadamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получить записанные объёмы грудного молока, смеси и питания из бутылочки, а также отдельно время кормления грудью для ребёнка."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hel caanaha naaska, caanaha booraha, wadarta dhalada iyo waqtiga naasnuujinta ee ilmaha la diiwaangeliyey. Waqtiga naasnuujintu waa gooni."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lấy lượng sữa mẹ, sữa công thức, tổng lượng bú bình đã ghi và thời gian bú mẹ riêng của bé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取孩子已记录的母乳量、配方奶量、瓶喂总量，以及单独统计的母乳喂养时长。"
          }
        }
      }
    },
