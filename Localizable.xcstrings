    "Saved to the pumping caregiver, separate from feeding." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ لصاحبة الرعاية التي تقوم بإخراج لبن الثدي، بمعزل عن التغذية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
