    "For %@ in the last 24 hours: %lld wet and %lld soiled diapers across %lld changes. %@ milk and %@ formula recorded.%@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لـ%@ خلال آخر 24 ساعة: %lld حفاضًا مبللًا و%lld متسخًا ضمن %lld تغييرات. سُجّل %@ من حليب الأم و%@ من الحليب الصناعي.%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For %1$@ in the last 24 hours: %2$lld wet and %3$lld soiled diapers across %4$lld changes. %5$@ milk and %6$@ formula recorded.%7$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para %1$@ en las últimas 24 horas: %2$lld pañales mojados y %3$lld con heces en %4$lld cambios. Se registraron %5$@ de leche y %6$@ de fórmula.%7$@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای %@ در ۲۴ ساعت گذشته: %lld پوشک خیس و %lld پوشک دارای مدفوع در %lld تعویض. %@ شیر مادر و %@ شیر خشک ثبت شده است.%@"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para kay %@ sa nakalipas na 24 oras: %lld basang diaper at %lld may dumi sa %lld pagpapalit. %@ gatas at %@ formula ang naitala.%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour %@ au cours des dernières 24 heures: %lld couches mouillées et %lld couches sales sur %lld changements. %@ lait et %@ lait maternisé enregistrés.%@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के लिए पिछले 24 घंटों में: %lld बार गीला और %lld बार पोटी वाला डायपर, कुल %lld बदलाव। %@ माँ का दूध और %@ फ़ॉर्मूला दूध दर्ज।%@"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pou %@ nan dènye 24 èdtan yo: %lld kouchèt mouye ak %lld kouchèt ki gen poupou sou %lld chanjman. %@ lèt manman ak %@ lèt fòmil anrejistre.%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 지난 24시간: 소변 기저귀 %lld개, 대변 기저귀 %lld개, 총 교체 %lld회. 모유 %@와 분유 %@가 기록되었습니다.%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para %@ nas últimas 24 horas: %lld fraldas molhadas e %lld sujas em %lld trocas. %@ leite e %@ leite de fórmula registrados.%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, за последние 24 часа: мокрых подгузников — %lld, со стулом — %lld, всего смен — %lld. Записано молока: %@, смеси: %@.%@"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 24-kii saac ee u dambeeyey: %lld xafaayadood oo qoyan iyo %lld saxaro leh, guud ahaan %lld beddel. %@ caanaha naaska iyo %@ caanaha booraha ayaa la diiwaangeliyey.%@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ trong 24 giờ qua: %lld tã ướt, %lld tã có phân, tổng %lld lần thay. Đã ghi %@ sữa và %@ sữa công thức.%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@过去24小时的记录：尿湿%lld片，有便便%lld片，共换尿布%lld次。已记录奶量%@，配方奶%@。%@"
          }
        }
      }
    },
    "For %@, %@: " : {
