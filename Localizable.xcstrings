        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a esta familia compartida ha cambiado. Abre de nuevo la invitación o pide a quien creó la familia que revise el acceso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی به این خانوادۀ مشترک تغییر کرده است. دعوت‌نامه را دوباره باز کنید یا از مالک خانواده‌ی مورد نظر بخواهید که دسترسی را بررسی کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang access sa ibinahaging pamilyang ito ay nagbago. I-reopen ang imbitasyon o hilingin sa may-ari ng pamilya na suriin ang access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’accès à cette famille partagée a changé, rouvrez l’invitation ou demandez au propriétaire de la famille de vérifier l’accès."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस साझा परिवार की पहुँच बदल गई है. निमंत्रण को फिर से खोलें या परिवार मालिक से अनुमति जाँचने के लिए पूछें."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses pou fanmi sa a pataje te chanje. Re-ouvri invitation oubyen mande pwopriyetè fanmi an pou tcheke akses la."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 공유 가족에 대한 액세스 권한이 변경되었습니다. 초대장을 다시 엽니 다거나 가족 소유자에게 액세스를 확인해 달라고 요청하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso a esta família compartilhada mudou: reabra o convite ou peça ao proprietário da família para verificar o acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к этой общей семье изменился. Переоткройте приглашение или попросите владельца семьи проверить доступ."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adeegsiga qoyska la wadaago ayaa isbedelay. Dib u fur casuumaadda ama weydii mulkiilaha qoyska inuu hubiyo adeegsiga."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truy cập vào gia đình chia sẻ này đã thay đổi. Mở lại lời mời hoặc yêu cầu chủ gia đình kiểm tra quyền truy cập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此共享家庭的访问权限已更改。 请重新打开邀请或要求家庭所有者检查访问权限。"
          }
        }
      }
    },
