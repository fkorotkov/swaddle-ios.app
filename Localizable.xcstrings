        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lines xiriiriyaan miisaanka diiwaangashan; ma ay qiimeeyaan miisaanka u dhexeeya gelida."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các đường nối trọng lượng ghi lại; chúng không ước tính trọng lượng giữa các mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "线条连接体重记录，不代表对两次记录之间体重的估计。"
