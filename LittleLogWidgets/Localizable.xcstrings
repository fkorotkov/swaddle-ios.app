    "iCloud couldn’t identify this invitation. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن iCloud من تحديد هذه الدعوة. يرجى المحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no pudo identificar esta invitación. Vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud نمی‌تواند این دعوت‌نامه را شناسایی کند. لطفاً دوباره سعی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nakilala ng iCloud ang imbitasyong ito. Subukan mo ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud n’a pas pu identifier cette invitation. Veuillez réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud इस निमंत्रण की पहचान नहीं कर सका. कृपया फिर कोशिश करें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud pa t' kapab idantifye invitations sa a. Tanpri, eseye ankò."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 이 초대장을 확인할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud não conseguiu identificar este convite. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud не смог идентифицировать это приглашение. Попробуйте еще раз."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ma aqoonsan karin martiqaadkan. Fadlan dib u isku day."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud không thể nhận dạng lời mời này. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 无法识别此邀请,请重试。"
          }
        }
      }
