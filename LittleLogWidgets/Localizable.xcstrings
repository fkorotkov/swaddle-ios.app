    "Only the family owner can invite someone to a caregiver profile.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصاحب الأسرة هو وحده الذي يستطيع دعوة شخص ما إلى ملف مقدم الرعاية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el propietario de la familia puede invitar a alguien a un perfil de cuidador."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنها صاحب خانواده می‌تواند کسی را به پروفایل مراقب دعوت کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang may-ari ng pamilya lamang ang maaaring mag-imbita ng isang tao sa profile ng tagapag-alaga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le propriétaire de la famille peut inviter quelqu'un sur un profil d'aidant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल परिवार का मालिक ही किसी को देखभालकर्ता प्रोफ़ाइल में आमंत्रित कर सकता है।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sèlman pwopriyetè fanmi an ki ka envite yon moun nan yon pwofil swenè."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 소유자만 간호사 프로필에 사람을 초대할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o proprietário da família pode convidar alguém para um perfil de cuidador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только владелец семьи может пригласить человека в профиль участника."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Owner qoyska oo keliya ayaa qof ku martiqaadi kara profile daryeelayaasha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ chủ sở hữu gia đình có thể mời ai đó vào hồ sơ người chăm sóc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有家庭所有者才能邀请某人加入照顾者档案。"
          }
        }
      }
    },
