    "Use Merge caregiver profiles to combine profiles.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم دمج ملف مقدم الرعاية للجمع بين الملفات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Combinar perfiles de cuidadores para unir perfiles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ترکیب پروفایل‌ها از «ادغام پروفایل‌های مراقبان» استفاده کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang Isama ang mga profile ng tagapag-alaga upang pagsamahin ang mga profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Fusionner les profils de soignant pour combiner des profils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइलों को जोड़ने के लिए देखभालकर्ता प्रोफाइल मिलाएँ का उपयोग करें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Itilize Fizyone pwofil moun k ap bay swen pou mete pwofil ansanm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간호사 프로필 병합을 사용하여 프로필을 결합합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Mesclar perfis de cuidadores para combinar perfis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Объединить профили участников», чтобы объединить профили."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Isticmaal Isku dar astaamaha daryeelayaasha si aad astaamaha isugu darto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng Hợp nhất hồ sơ người chăm sóc để gộp các hồ sơ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用合并护理人员配置文件 来合并配置文件。"
          }
        }
      }
    },
    "Use ounces": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام الأوقية"
          }
        },
        "es": {
