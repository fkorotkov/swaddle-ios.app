    "Open a bottle with your previous amounts. Review the time and volume, then save.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح زجاجة رضيع مع كمياتك السابقة، استعرض الوقت والحجم، ثم أحفظ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un biberón con las cantidades anteriores. Revisa la hora y el volumen, y guarda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویرایشگر شیشه شیر را با مقادیر قبلی باز کنید. زمان و مقدار را بررسی و سپس ذخیره کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang isang baby bottle na may iyong mga nakaraang halaga. Tingnan ang oras at dami, pagkatapos ay i-save."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un biberon avec vos quantités précédentes, passez en revue le temps et le volume, puis enregistrez-les."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पहले के मात्राओं के साथ एक बच्चे की बोतल खोलें. समय और मात्रा की समीक्षा करें, फिर सहेजें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Louvri yon bibwon ak kantite ou te itilize anvan yo. Verifye lè ak volim nan, epi sove."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 수유량이 입력된 젖병 편집기를 엽니다. 시간과 양을 확인한 후 저장하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um biberão com as quantidades anteriores, reveja o tempo e o volume e salve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть форму бутылочки с предыдущими объёмами. Проверьте время и объём, затем сохраните."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fur dhalo leh qaddarradii hore. Hubi wakhtiga iyo mugga, dabadeed kaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở biểu mẫu bình sữa với lượng lần trước. Kiểm tra thời gian và lượng sữa rồi lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开填有上次奶量的奶瓶编辑页。检查时间和奶量后保存。"
          }
        }
      }
    },
    "Opens Swaddle and removes only the entry just saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Swaddle ويزيل فقط المدخل الذي تم حفظه للتو."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Swaddle y elimina solo el registro recién guardado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle را باز می‌کند و فقط ثبتِ همین الان را حذف می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuksan ang Swaddle at inaalis lang ang talang kaka-save pa lang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Swaddle et supprime uniquement l'entrée qui vient d'être enregistrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोलता है Swaddle और सिर्फ सहेजी गई प्रविष्टि को मिटाता है."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Louvri Swaddle epi retire sèlman antre ki fèk sove a."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle을 열고 방금 저장한 기록만 삭제합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Swaddle e remove apenas a entrada que acabou de salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Swaddle и удаляет только что сохранённую запись."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu furaa Swaddle oo tirtiraa keliya diiwaankii hadda la kaydiyey."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Swaddle và chỉ gỡ bỏ mục vừa được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Swaddle,并仅删除刚才保存的条目。"
          }
        }
      }
    },
    "Opens Swaddle and saves one diaper change now, with Undo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Swaddle و يحفظ تغيير حفاضة واحدة الآن، مع التراجع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Swaddle y guarda un cambio de pañal ahora, con opción de deshacer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle را باز می‌کند و یک تعویض پوشک را برای همین حالا با امکان واگردانی ثبت می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuksan ang Swaddle at sine-save ang isang pagpapalit ng diaper ngayon, na may I-undo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Swaddle et enregistre un changement de couche maintenant, avec Annuler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle खोलता है और अब एक डायपर परिवर्तन को बचाता है, पहले जैसा करने के साथ."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Louvri Swaddle epi sove yon sèl chanjman kouchèt kounye a, ak opsyon Anile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle을 열고 지금 기저귀 교체 한 건을 저장합니다. 실행 취소할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Swaddle e salva uma mudança de fralda agora, com Desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Swaddle и сразу записывает одну смену подгузника с возможностью отмены."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu furaa Swaddle oo hadda kaydiyaa hal beddel xafaayad, oo leh Ka noqo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Swaddle và ghi một lần thay tã ngay, có thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Swaddle,并保存一个尿布更换现在,与撤销."
          }
        }
      }
    },
    "Opens Swaddle and saves one diaper change now. Undo is available in the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Swaddle و يحفظ تغيير حفاضة واحدة الآن، الإلغاء متاح في التطبيق"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Swaddle y guarda un cambio de pañal ahora. Puedes deshacerlo en la app."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle را باز می‌کند و یک تعویض پوشک را برای همین حالا ثبت می‌کند. واگردانی در برنامه در دسترس است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magbubukas Swaddle at nai-save ng isang diaper pagbabago ngayon. Undo ay magagamit sa app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Swaddle et enregistre un changement de couche maintenant. Annuler est disponible dans l'application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle खोलकर अभी का एक डायपर बदलाव सहेजता है। ऐप में पूर्ववत करना उपलब्ध है।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Louvri Swaddle epi sove yon sèl chanjman kouchèt kounye a. Ou ka anile nan aplikasyon an."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle을 열고 현재 시각으로 기저귀 교체 한 건을 저장합니다. 앱에서 실행 취소할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Swaddle e salva uma troca de fralda agora. Desfazer está disponível no aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Swaddle и сразу записывает одну смену подгузника. Отмена доступна в приложении."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu furaa Swaddle oo hadda kaydiyaa hal beddel xafaayad. Ka noqo ayaa ku jira abka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Swaddle và ghi một lần thay tã ngay. Có thể hoàn tác trong ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Swaddle 并保存一次尿布更换。 在应用程序中提供撤销功能。"
          }
        }
      }
    },
    "Opens Swaddle to check setup and family access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Swaddle للتحقق من التثبيت وإمكانية الوصول العائلي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Swaddle para comprobar la configuración y el acceso familiar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "باز کردن Swaddle برای بررسی تنظیمات و دسترسی خانواده."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magbubukas Swaddle upang suriin ang setup at pamilya access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Swaddle pour vérifier la configuration et l'accès familial."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोलता है Swaddle सेटअप और परिवार पहुँच जाँचने के लिए."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Louvri Swaddle pou verifye konfigirasyon ak aksè fanmi an."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle을 열어 설정과 가족 접근 권한을 확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Swaddle para verificar a configuração e o acesso da família."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Swaddle для проверки настройки и доступа к семье."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu furaa Swaddle si loo hubiyo dejinta iyo gelitaanka qoyska."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Swaddle để kiểm tra cài đặt và truy cập gia đình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Swaddle 以检查设置和家庭访问。"
          }
        }
      }
    },
    "Opens the previous amounts for review. Nothing is saved until you tap Save.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الكميات السابقة للمراجعة. لا يُحفظ شيء حتى تضغط على «حفظ»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre las cantidades anteriores para revisarlas. No se guarda nada hasta que toques Guardar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدارهای قبلی را برای بازنگری باز می‌کند. تا زمانی که ذخیره را فشار ندهید ، چیزی ذخیره نمی‌شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magbubukas ang mga nakaraang halaga para sa pagsusuri. Walang nai-save hanggang sa i-tap mo I-save."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les montants précédents pour examen. Rien n'est enregistré tant que vous n'avez pas appuyé sur Enregistrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा के लिए पिछली मात्राएँ खोलता है। सहेजें पर टैप करने तक कुछ भी सहेजा नहीं जाता।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Louvri kantite anvan yo pou revizyon. Anyen pa sove jiskaske ou tape Sove."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 수유량을 확인할 수 있도록 엽니다. 저장을 탭하기 전에는 아무것도 저장되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre os valores anteriores para revisão. Nada é salvo até que você toque em Salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает предыдущие объёмы для проверки. До нажатия «Сохранить» ничего не записывается."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu furaa qaddarradii hore si loo eego. Waxba lama kaydiyo ilaa aad taabato Kaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở các giá trị trước đây để xem xét. Không có gì được lưu cho đến khi bạn nhấn Lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开上次奶量供检查。轻点“保存”前不会保存任何记录。"
          }
        }
      }
    },
    "Opens the previous amounts for review. Tap Save to record the bottle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الكميات السابقة للمراجعة. انقر على حفظ لتسجيل زجاجة الطفل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre las cantidades anteriores para revisarlas. Toca Guardar para registrar el biberón."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدارهای قبلی را برای بازبینی باز می‌کند. برای ضبط بطری نوزاد، روی ذخیره ضربه بزنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magbubukas ng mga nakaraang halaga para sa pagsusuri. I-tap ang I-save upang itala ang baby bottle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les quantités précédentes pour examen. Appuyez sur Enregistrer pour enregistrer le biberon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा के लिए पिछली मात्राओं को खोलता है. बेबी बोतल रिकॉर्ड करने के लिए सहेजें दबाएँ."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Louvri kantite anvan yo pou revizyon. Tape Sove pou anrejistre bibwon an."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토를 위해 이전 양을 엽니다. 저장 을 눌러 아기 젖병을 기록합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre as quantidades anteriores para revisão. Toque em Salvar para gravar o biberão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает предыдущие объёмы для проверки. Нажмите «Сохранить», чтобы записать кормление из бутылочки."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu furaa qaddarradii hore si loo eego. Taabo Kaydi si aad u diiwaangeliso dhalada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở số lượng trước đây để xem lại. Nhấn Lưu để ghi lại chai sữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开以前的数量供查看。 轻按保存 以记录奶瓶。"
          }
        }
      }
    },
