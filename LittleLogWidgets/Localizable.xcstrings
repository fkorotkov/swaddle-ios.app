          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Swaddle et enregistrez une couche humide maintenant, avec Annuler si nécessaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle खोलें और अब एक गीली डायपर को सहेजें, यदि आवश्यक हो तो Undo के साथ."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Louvri Swaddle epi sove yon kouchèt mouye kounye a; ou ka anile si sa nesesè."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle을 열고 소변 기저귀를 지금 기록합니다. 필요하면 실행 취소할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Swaddle e salvar uma fralda molhada agora, com Desfazer se necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть Swaddle и сразу записать мокрый подгузник. При необходимости запись можно отменить."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fur Swaddle oo hadda kaydi xafaayad qoyan; waad ka noqon kartaa haddii loo baahdo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Swaddle và ghi tã ướt ngay. Có thể hoàn tác nếu cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开Swaddle并立即记录尿湿的尿布，需要时可撤销。"
          }
        }
      }
    },
    "Open Swaddle and save one diaper with both pee and poo, with Undo if needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Swaddle وحفظ حفاضة واحدة مع كل من التبول والبراز، مع إلغاء إذا لزم الأمر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Swaddle y guarda un pañal con pipí y caca; puedes deshacerlo si hace falta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle را باز کنید و یک پوشک دارای ادرار و مدفوع را ثبت کنید؛ در صورت نیاز می‌توانید واگردانی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan Swaddle at i-save ang isang diaper na may parehong pee at poo, sa Undo kung kinakailangan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Swaddle et enregistrez une couche avec pipi et caca, avec Annuler si nécessaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle खोलकर पेशाब और पोटी दोनों वाला एक डायपर सहेजें। ज़रूरत हो तो पूर्ववत करें।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Louvri Swaddle epi sove yon sèl kouchèt ki gen pipi ak poupou; ou ka anile si sa nesesè."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle을 열고 소변과 대변이 모두 있는 기저귀 한 개를 기록합니다. 필요하면 실행 취소할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Swaddle e salvar uma fralda com xixi e cocô, com Desfazer se necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть Swaddle и записать один подгузник с мочой и стулом. При необходимости запись можно отменить."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fur Swaddle oo kaydi hal xafaayad oo kaadi iyo saxaro leh; waad ka noqon kartaa haddii loo baahdo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Swaddle và ghi một tã có cả nước tiểu và phân. Có thể hoàn tác nếu cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开Swaddle并记录一片同时有尿尿和便便的尿布，需要时可撤销。"
          }
        }
      }
    },
    "Open Swaddle to check family access": {
