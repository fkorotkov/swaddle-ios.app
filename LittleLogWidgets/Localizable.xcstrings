    "%@ saved for %@. Open Swaddle and undo this entry": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ تم حفظه لـ %@ افتح Swaddle وإلغاء هذا القيد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ saved for %2$@. Open Swaddle and undo this entry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ guardado para %2$@. Abre Swaddle para deshacer este registro"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ برای %@ ذخیره شد. Swaddle را باز کنید و این مدخل را لغو کنید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nai-save para sa %@. Buksan Swaddle at i-undo ang entry na ito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enregistré pour %@. Ouvrez Swaddle et annulez cette entrée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ के लिए %1$@ सहेजा गया। Swaddle खोलकर इस प्रविष्टि को पूर्ववत करें"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sove pou %@. Louvri Swaddle pou anile antre sa a"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 %1$@ 저장됨. Swaddle을 열어 이 기록을 취소하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salvo para %@. Abra Swaddle e desfaça esta entrada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сохранено для %@. Откройте Swaddle и отмените эту запись"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ waa loo kaydiyey %@. Fur Swaddle oo ka noqo diiwaankan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu %@ cho %@. Mở Swaddle để hoàn tác bản ghi này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为%2$@保存%1$@。打开Swaddle并撤销这条记录"
          }
        }
      }
    },
