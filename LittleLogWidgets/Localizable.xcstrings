    "Keep this widget linked to one child in your family.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقي هذا البرنامج مرتبطاً بطفل واحد في أسرتك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén este widget vinculado a un bebé de tu familia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ویجت را به یک فرزند در خانواده‌تان پیوند دهید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Panatilihing naka-link ang widget na ito sa isang bata sa iyong pamilya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez ce widget lié à un enfant de votre famille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस विजेट को अपने परिवार के एक बच्चे से जुड़ा रखें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Mete widget sa a lyen ak yon timoun nan fanmi ou."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위젯을 가족 중 한 명의 자녀와 연결해 두십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha este widget vinculado a uma criança em sua família."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите этот виджет связан с одним ребенком в вашей семье."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget-kan ku hay inuu ku xiran yahay hal ilmo oo qoyskaaga ah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ widget này liên kết với một đứa trẻ trong gia đình bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此小部件关联到您家庭中的一个孩子。"
          }
        }
      }
    },
