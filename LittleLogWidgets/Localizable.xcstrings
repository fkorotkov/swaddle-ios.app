    "This Apple Account already belongs to %@’s profile. Use that profile instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا حساب أبل ينتمي بالفعل إلى ملف %@. استخدم ذلك الملف بدلا من ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Cuenta de Apple ya pertenece al perfil de %@. Usa ese perfil."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این حساب اپل از قبل متعلق به پروفایل %@ است. در عوض از آن پروفایل استفاده کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Apple Account na ito ay nasa profile ng %@. Gamitin ang profileng iyon sa halip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Apple appartient déjà au profil de %@. Utilisez ce profil à la place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Apple खाता पहले से ही %@ के प्रोफ़ाइल में है. बदले में उस प्रोफ़ाइल का उपयोग करें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Kont Apple sa a deja nan pwofil %@. Ou ka itilize li an plase."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정은 이미 %@의 프로필에 속해 있습니다. 대신 해당 프로필을 사용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Conta Apple já pertence ao perfil de %@. Use esse perfil em vez disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта учетная запись Apple уже принадлежит профилю %@. Используйте этот профиль вместо этого."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xisaabtan Apple-ka ah waxaa horey u lahaa %@'s profile. Fadlan isticmaal profilkaas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản Apple này đã thuộc về hồ sơ của %@. Dùng hồ sơ đó thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple账户已关联%@的资料。请使用该资料。"
          }
        }
      }
    },
