    "Open Swaddle and save a soiled diaper now, with Undo if needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Swaddle وحفظ حفاضة قذرة الآن، مع إلغاء إذا لزم الأمر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Swaddle y guarda ahora un pañal con caca; puedes deshacerlo si hace falta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle را باز کنید و یک پوشک دارای مدفوع را برای همین حالا ثبت کنید؛ در صورت نیاز می‌توانید واگردانی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan Swaddle at i-save ang isang marumi diaper ngayon, na may Undo kung kinakailangan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Swaddle et enregistrez une couche sale maintenant, avec Annuler si nécessaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle खोलें और अब एक गंदा डायपर बचाएं, यदि आवश्यक हो तो Undo के साथ."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Louvri Swaddle epi sove yon kouchèt ki gen poupou kounye a; ou ka anile si sa nesesè."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaddle을 열고 대변 기저귀를 지금 기록합니다. 필요하면 실행 취소할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Swaddle e salvar uma fralda suja agora, com Desfazer se necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть Swaddle и сразу записать подгузник со стулом. При необходимости запись можно отменить."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fur Swaddle oo hadda kaydi xafaayad saxaro leh; waad ka noqon kartaa haddii loo baahdo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Swaddle và ghi tã có phân ngay. Có thể hoàn tác nếu cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开Swaddle并立即记录有便便的尿布，需要时可撤销。"
          }
        }
      }
    },
    "Open Swaddle and save a wet diaper now, with Undo if needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Swaddle وحفظ حفاضة رطبة الآن، مع إلغاء إذا لزم الأمر."
