    "The first-noticed date must be between birth and this check-in, for a skill you’ve seen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون أول تاريخ ملحوظ بين الولادة و هذا التحقق من المهارة التي رأيتها"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha en que lo viste por primera vez debe estar entre el nacimiento y este registro, para una habilidad que hayas observado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای مهارتی که دیده‌اید، تاریخ اولین مشاهده باید بین تولد و این بررسی باشد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang unang-napansin petsa ay dapat na sa pagitan ng kapanganakan at ito check-in, para sa isang kasanayan mo nakita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de première observation doit être entre la naissance et cette entrée, pour une compétence que vous avez vue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखे गए कौशल की पहली बार देखने की तारीख जन्म और इस जाँच के बीच होनी चाहिए।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat la premye remake dwe ant nesans ak sa a check-in, pou yon ladrès ou te wè."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 본 기술의 처음 관찰한 날짜는 출생일과 이번 확인일 사이여야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira data observada deve estar entre o nascimento e este check-in, para uma habilidade que você viu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для замеченного навыка дата первого наблюдения должна быть не раньше рождения и не позже этой отметки."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taariikhda ugu horeysay ee la arkay waa in ay u dhexeeyaan dhalashada iyo diiwaangelintan, si aad u aragto xirfad."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với kỹ năng bạn đã thấy, ngày đầu tiên quan sát được phải nằm giữa ngày sinh và lần kiểm tra này."
          }
