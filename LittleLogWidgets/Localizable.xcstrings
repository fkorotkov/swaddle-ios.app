{
  "sourceLanguage": "en",
  "strings": {
    " Also breastfeeding: %@, %@ recorded. Breastfeeding time isn’t converted to volume.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " والرضاعة الطبيعية أيضًا: %@، بإجمالي وقت مسجل قدره %@. لا يُحوَّل وقت الرضاعة الطبيعية إلى حجم حليب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Also breastfeeding: %@, %@ recorded. Breastfeeding time isn’t converted to volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Además, lactancia: %@, con %@ registrados. El tiempo de lactancia no se convierte en volumen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": " همچنین شیردهی: %@، با زمان ثبت‌شدهٔ %@. زمان شیردهی به حجم شیر تبدیل نمی‌شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": " May pagpapasuso rin: %@, na may kabuuang tagal na %@. Hindi ginagawang dami ng gatas ang tagal ng pagpapasuso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Allaitement également : %@, pour une durée de %@. Le temps d’allaitement n’est pas converti en volume."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " स्तनपान भी: %@, कुल समय %@ दर्ज है। स्तनपान के समय को दूध की मात्रा में नहीं बदला जाता।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": " Epitou, bay tete: %@, avèk %@ anrejistre. Yo pa konvèti tan bay tete a an volim lèt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 모유 수유도 기록됨: %@, 총 %@. 모유 수유 시간은 수유량으로 환산하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Também houve amamentação: %@, com duração total de %@. O tempo de amamentação não é convertido em volume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Также кормление грудью: %@, общее время — %@. Время кормления грудью не пересчитывается в объём."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": " Sidoo kale naasnuujin: %@, muddada la diiwaangeliyayna waa %@. Muddada naasnuujinta looma beddelo mugga caanaha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " Ngoài ra còn bú mẹ: %@, với tổng thời gian %@. Thời gian bú mẹ không được quy đổi thành lượng sữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 另有母乳喂养：%@，共%@。母乳喂养时间不会换算成奶量。"
          }
        }
      }
    },
