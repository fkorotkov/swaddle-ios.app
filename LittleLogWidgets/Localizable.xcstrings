            "state": "translated",
            "value": "इस विजेट को सेट करें। विजेट संपादित करें में बच्चा चुनें।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigire widget sa a. Chwazi yon timoun nan Modifye widget."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위젯을 설정하세요. 위젯 편집에서 아이를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure este widget. Escolha um filho em Editar Widget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
