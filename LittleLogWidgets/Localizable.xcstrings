            "value": "Дата рождения не может быть в будущем."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Maalinta dhalashada ma noqon karo mustaqbalka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày sinh không thể là trong tương lai."
          }
        },
        "zh-Hans": {
