    },
    "Enter either the milk/formula amounts or a total with an unknown split.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدرج إما كميات الحليب/الحليب الاصطناعي أو المجموع مع تقسيم غير معروف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce las cantidades de leche y fórmula, o un total sin desglose conocido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار شیر مادر و شیر خشک را وارد کنید، یا اگر سهم هرکدام را نمی‌دانید فقط مجموع را ثبت کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipasok ang alinman sa gatas / formula halaga ng gatas o isang kabuuan na may isang hindi kilalang split."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez les quantités de lait/de lait artificiel ou un total avec une répartition inconnue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माँ के दूध और फ़ॉर्मूला दूध की अलग मात्राएँ भरें, या अलग मात्राएँ अज्ञात हों तो कुल भरें।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Antre kantite lèt manman ak lèt fòmil yo, oswa yon total ak repatisyon enkoni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모유와 분유 각각의 양을 입력하거나, 구분을 모르면 총량을 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira as quantidades de leite/leite de fórmula ou um total com uma divisão desconhecida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите объёмы молока и смеси либо общий объём, если состав неизвестен."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Geli qaddarka caanaha naaska iyo booraha, ama wadar aan kala qaybinteeda la garanayn."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập riêng lượng sữa mẹ và sữa công thức, hoặc nhập tổng lượng nếu không biết lượng từng loại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入母乳和配方奶各自的量；若组成未知，则填写总量。"
          }
        }
      }
    },
    "Enter gestational age at birth as 1–45 weeks and 0–6 days.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدرج سن الحمل عند الولادة على النحو التالي: 1–45 أسابيع و 0–6 أيام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la edad gestacional al nacer: entre 1 y 45 semanas y entre 0 y 6 días."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سن بارداری هنگام تولد را بین ۱ تا ۴۵ هفته و ۰ تا ۶ روز وارد کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipasok ang edad ng pagbubuntis sa kapanganakan bilang 1–45 linggo at 0–6 na araw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez l'âge gestationnel à la naissance comme 1-45 semaines et 0-6 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्म के समय गर्भावस्था की आयु को 1-45 सप्ताह और 0-6 दिनों के रूप में दर्ज करें।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Enskri laj gestasyonèl nan nati kòm 1-45 semèn ak 0-6 jou."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출생 시 임신 기간을 1~45주, 0~6일로 입력합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira a idade gestacional no nascimento como 1–45 semanas e 0–6 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите гестационный возраст при рождении как 1-45 недель и 0-6 дней."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku dar da'da uurka marka la dhasho sida 1-45 toddobaad iyo 0-6 maalmood."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tuổi thai khi sinh là 1–45 tuần và 0–6 ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入出生时的孕周：1至45周，再加0至6天。"
          }
        }
      }
    },
    "Enter the email address they use with their Apple Account.": {
      "localizations": {
