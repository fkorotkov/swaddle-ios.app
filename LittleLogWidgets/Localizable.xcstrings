    "Set up this widget. Choose a child in Edit Widget.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط هذا الودجت. اختر طفلًا في «تحرير الودجت»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura este widget. Elige un bebé en Editar widget."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیکربندی این Widget. یک فرزند را در ویرایش Widget برگزینید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-set up ang widget na ito. Pumili ng isang anak sa I-edit Widget."
          }
        },
        "fr": {
