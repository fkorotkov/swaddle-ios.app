    "Check the feeding session’s start and end times.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من أوقات بداية ونهاية دورة التغذية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba las horas de inicio y fin de la sesión de lactancia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان شروع و پایان نشست تغذیه را بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingnan ang pagsisimula at pagtatapos ng feed session."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les heures de début et de fin de la séance d’alimentation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फीडिंग सत्र के प्रारंभ तथा अंत समय जाँचें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Tcheke tan kòmanse ak fen manje a."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수유 시작 시간과 종료 시간을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique os horários de início e fim da sessão de alimentação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте время начала и окончания кормления."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka hubi bilowga iyo dhamaadka waqtiyada kulan ee cuntada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra thời gian bắt đầu và kết thúc cữ bú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查喂食的开始和结束时间。"
          }
        }
      }
    },
    "Check the observation date and keep the note under 2,000 characters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من تاريخ الملاحظة واجعل الملاحظة أقصر من 2,000 حرف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la fecha de la observación y usa menos de 2.000 caracteres en la nota."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ مشاهده را بررسی کنید و یادداشت را زیر ۲٬۰۰۰ نویسه نگه دارید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingnan ang petsa ng obserbasyon at panatilihin ang tala sa ilalim ng 2,000 mga character."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la date d’observation et limitez la note à moins de 2 000 caractères."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अवलोकन की तारीख को जाँचें और नोट 2,000 अक्षरों के नीचे रखें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifye dat obsèvasyon an epi kenbe nòt la anba 2,000 karaktè."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관측 날짜를 확인하고 노트를 2,000자 이하로 유지하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira a data da observação e use menos de 2.000 caracteres na nota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте дату наблюдения. Длина заметки должна быть меньше 2 000 символов."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka hubi taariikhda daawashada iyo haystaa qoraalka hoos 2,000 xaraf."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra ngày quan sát và giữ ghi chú dưới 2.000 ký tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查观察日期，并将备注控制在2,000个字符以内。"
          }
        }
      }
    },
