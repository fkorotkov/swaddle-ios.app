    "Last 24 hours of bottles, family pumping, and diapers, with Pee, Poo, Both, and Bottle actions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرضّاعات وشفط الحليب للعائلة والحفاضات خلال آخر 24 ساعة، مع إجراءات البول والبراز وكليهما والرضّاعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last 24 hours of bottles, family pumping, and diapers, with Pee, Poo, Both, and Bottle actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Biberones, extracción familiar y pañales de las últimas 24 horas, con acciones de Pipí, Caca, Ambos y Biberón."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شیشه‌شیر، دوشیدن شیر در خانواده و پوشک‌های ۲۴ ساعت گذشته، با میان‌برهای ادرار، مدفوع، هر دو و شیشه‌شیر."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga bote, gatas na na-pump ng pamilya, at diaper sa nakaraang 24 na oras, na may mga aksyong Ihi, Dumi, Pareho, at Bote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biberons, lait tiré dans la famille et couches des dernières 24 heures, avec les actions Pipi, Caca, Les deux et Biberon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले 24 घंटों की बोतल फ़ीड, परिवार में निकाला गया दूध और डायपर; पेशाब, मल, दोनों और बोतल के त्वरित विकल्प।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Biberon, lèt fanmi an tire ak kouch nan dènye 24 èdtan yo, ak aksyon Pipi, Kaka, Toude ak Biberon."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 24시간의 젖병 수유, 가족 유축, 기저귀 요약과 소변, 대변, 둘 다, 젖병 기록 바로가기."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mamadeiras, extração de leite da família e fraldas nas últimas 24 horas, com ações de Xixi, Cocô, Ambos e Mamadeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бутылочки, сцеживания в семье и подгузники за последние 24 часа, с действиями «Пописал», «Покакал», «Оба» и «Бутылочка»."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Dhalooyinka, caanaha qoyska laga lisay iyo xafaayadaha 24-kii saac ee la soo dhaafay, iyo falalka Kaadi, Saxaro, Labadaba iyo Dhalo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bình sữa, sữa hút trong gia đình và tã trong 24 giờ qua, cùng các thao tác Tiểu, Đại tiện, Cả hai và Bình sữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去24小时的奶瓶喂养、家庭吸奶和尿布概览，以及小便、大便、两者和奶瓶快捷操作。"
          }
        }
      }
    },
