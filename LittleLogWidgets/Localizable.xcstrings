    "Select pee, poo, or both.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر التبول أو البراز أو كليهما"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona pipí, caca o ambos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنيد ادرار، مدفوع يا هر دو"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng ihi, dumi, o pareho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez pipi, caca ou les deux."
          }
        },
