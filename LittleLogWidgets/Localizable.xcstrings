            "value": "शून्य से बड़ा एक आयतन भरें. मात्रा ऋणात्मक नहीं हो सकती है."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre yon volim pi gwo pase zewo. Montan yo pa ka negatif."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양은 0보다 큰 값으로 입력해 주세요. 음수는 입력할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um volume maior que zero. Os valores não podem ser negativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите объём больше нуля. Значения не могут быть отрицательными."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Geli mug ka weyn eber. Qaddarradu ma noqon karaan tirooyin taban."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập thể tích lớn hơn không. Các lượng không được âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入大于零的体积。 数额不能为负值。"
          }
        }
      }
    },
    "Enter a weight greater than zero.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل وزناً أكبر من صفر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un peso mayor que cero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وارد کردن یک وزن بزرگتر از صفر."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipasok ang isang timbang na mas malaki kaysa sa zero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez un poids supérieur à zéro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शून्य से बड़ा वजन भरें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre yon pwa pi gwo ke zèro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중은 0보다 큰 값으로 입력해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um peso maior que zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите вес больше нуля."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Geli miisaan ka weyn eber."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập cân nặng lớn hơn không."
          }
        },
