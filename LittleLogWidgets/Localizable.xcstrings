    "Include a birth date to calculate gestational age.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدرج تاريخ الميلاد لحساب عمر الحمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye la fecha de nacimiento para calcular la edad gestacional."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ تولد را برای محاسبهٔ سن بارداری در نظر بگیرید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasama ang isang petsa ng kapanganakan upang makalkula ang gestational edad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure une date de naissance pour calculer l'âge gestationnel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्भावस्था की आयु गणना करने के लिए जन्म तिथि शामिल करें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Enkli yon dat nesans pou kalkile laj gestasyonèl."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임신 연령을 계산하기 위해 출생일을 포함합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua uma data de nascimento para calcular a idade gestacional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите дату рождения для расчета гестационного возраста."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku dar taariikhda dhalashada si aad u xisaabiso da'da uurka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng với ngày sinh để tính tuổi thai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括出生日期以计算妊娠年龄。"
          }
        }
      }
    },
