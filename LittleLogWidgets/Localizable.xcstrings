    "Your family is still loading. Open Swaddle and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت بيانات عائلتك قيد التحميل. افتح Swaddle وحاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu familia aún se está cargando. Abre Swaddle y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات خانوادهٔ شما هنوز در حال بارگیری است. Swaddle را باز کنید و دوباره تلاش کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong pamilya ay pa rin ang pag-load. Buksan Swaddle at subukan muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre famille est toujours en cours de chargement. Ouvrez Swaddle et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवार का डेटा अभी लोड हो रहा है। Swaddle खोलें और फिर कोशिश करें।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanmi w la toujou ap chaje. Ouvèti Swaddle epi eseye ankò."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 데이터를 불러오는 중입니다. Swaddle을 열고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua família ainda está carregando. Abra o Swaddle e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша семья все еще загружается. Откройте Swaddle и попробуйте снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "qoyskaagu weli wuu buuxsamayaa. Fur Swaddle oo dib u isku day."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gia đình anh vẫn đang tải, mở Swaddle và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的家庭仍在加载中,请打开 Swaddle 并重试。"
          }
        }
      }
    },
    "Your family is still loading. Please open the widget again shortly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عائلتكِ لا تزال تُحمَّل، رجاءً افتح الواجهة مجدداً قريباً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu familia aún se está cargando. Abre el widget de nuevo en un momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خانواده شما هنوز در حال بارگذاری است. لطفاً به زودی مجدداً ویجت را باز کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong pamilya ay pa rin loading. Mangyaring buksan ang widget muli sa lalong madaling panahon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre famille est toujours en cours de chargement. Veuillez rouvrir le widget sous peu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका परिवार अभी भी लोड हो रहा है. कृपया विजेट को जल्द ही फिर से खोलें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanmi w lan toujou ap chaje. Tanpri, louvri widget la ankò byento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 가족이 아직도 로드 중입니다. 위젯을 다시 열어 주십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua família ainda está carregando. Por favor, abra o widget novamente em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша семья все еще загружается. Пожалуйста, откройте виджет в ближайшее время."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xogta qoyska weli waa la soo gelinayaa. Fadlan widget-ka mar kale fur wax yar kadib."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gia đình của bạn vẫn đang được tải. Hãy mở widget lại sớm nhé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的家庭仍在加载中,请稍后再次打开小部件。"
          }
        }
      }
    },
