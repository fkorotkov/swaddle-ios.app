    "Resolve this caregiver’s conflicting edits before inviting them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حل التحرير المتعارض لهذا مقدم الرعاية قبل دعوتهم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve los cambios en conflicto de este cuidador antes de invitarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از دعوت کردن آن‌ها، ویرایش‌های متناقض این مراقب را حل کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayusin ang mga magkakasalungat na pag-edit ng tagapag-alaga bago ka mag-imbita sa kanila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez les modifications conflictuelles de ce soignant avant de l'inviter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्हें आमंत्रित करने से पहले इस देखभालकर्ता के परस्पर विरोधी संपादनों को हल करें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezoud chanjman ki an konfli pou moun sa a anvan ou envite li."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 간호사를 초대하기 전에 그의 충돌하는 수정 사항을 해결하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva as edições conflitantes desse cuidador antes de convidá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед приглашением устраните конфликтующие изменения профиля участника."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xalin edits is khilaafsan ee this daryeel bixiyaha ka hor intaan u yeedhi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xử lý các sửa đổi mâu thuẫn của người chăm sóc này trước khi mời họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在邀请他们之前解决这位护理者的冲突编辑。"
          }
        }
      }
    },
    "Resolve this caregiver’s conflicting edits before linking the Apple Account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حل التحرير المتضارب لهذا مقدم الرعاية قبل ربط حساب Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve los cambios en conflicto de este cuidador antes de vincular la Cuenta de Apple."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حل تغییرات متناقض این مراقب قبل از پیوند دادن حساب اپل."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayusin ang mga magkakasalungat na pag-edit ng tagapag-alaga bago ikonekta ang Apple Account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez les modifications conflictuelles de ce soignant avant d’associer le compte Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple खाता को जोड़ने से पहले इस देखभालकर्ता के परस्पर विरोधी संपादनों को हल करें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezoud chanjman ki an konfli pou moun sa a anvan ou lye kont Apple la."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정을 연결하기 전에 이 보호자의 충돌하는 편집 내용을 해결하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva as edições conflitantes desse cuidador antes de vincular a Conta Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед привязкой Аккаунта Apple устраните конфликтующие изменения профиля участника."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xalin edits khilaafsan ee this daryeel bixiyaha ka hor xidhiidhka xisaabta Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xử lý các sửa đổi mâu thuẫn của người chăm sóc trước khi liên kết tài khoản Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在关联 Apple 帐户之前,解决此护理人员的冲突编辑。"
          }
        }
      }
    },
