        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con, người chăm sóc hoặc nguồn của quan sát này không có sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此观察的儿童、照顾者或来源不可用。"
          }
        }
      }
    },
    "This profile already has an invitation for someone else. Remove that invitation in Family sharing first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا الملف الشخصي بالفعل على دعوة لشخص آخر. قم بإزالة تلك الدعوة في التشارك العائلي أولا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil ya tiene una invitación para otra persona. Elimínala primero en Compartir en familia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پروفایل از قبل دعوت‌نامه‌ای برای شخص دیگری دارد. ابتدا آن دعوت‌نامه را در اشتراک‌گذاری خانوادگی حذف کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayroon nang imbitasyon ang profile na ito para sa ibang tao. Una, tanggalin ang imbitasyong iyon sa Family sharing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil contient déjà une invitation pour quelqu’un d’autre, supprimez-la d’abord dans le partage familial."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोफ़ाइल में पहले से ही किसी अन्य के लिए एक निमंत्रण है. परिवार साझेदारी में उस निमंत्रण को पहले मिटाएँ."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Pwofil sa a deja gen yon envitasyon pou yon lòt moun. Retire envitasyon sa a nan Pataj fanmi an dabò."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필에는 다른 사람을 위한 초대장이 이미 있습니다. 가족 공유에서 해당 초대장을 먼저 제거하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil já tem um convite para outra pessoa, remova esse convite no Compartilhamento Familiar primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом профиле уже есть приглашение для другого пользователя. Сначала удалите это приглашение в Семейном доступе."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Astaantan hore waxay u leedahay casuumaad qof kale. Marka hore ka saar casuumaadda Wadaagidda qoyska."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ này đã có một lời mời cho người khác. Lấy lời mời đó ra khỏi Gia đình trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置文件已有其他人的邀请。 首先在\"家人共享\"中移除该邀请。"
          }
        }
      }
    },
    "This profile is already linked to another Apple Account. Manage its access in Family sharing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف الشخصي مرتبط بالفعل بحساب آخر من حسابات آبل. قم بإدارة إمكانية وصوله في التشارك العائلي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil ya está vinculado a otra Cuenta de Apple. Gestiona su acceso en Compartir en familia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پروفایل از قبل به یک حساب اپل دیگر مرتبط است. دسترسی آن را در اشتراک‌گذاری خانوادگی مدیریت کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang profile na ito ay naka-link na sa ibang Apple Account. Pamahalaan ang access nito sa Family Sharing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil est déjà associé à un autre compte Apple. Gérez son accès dans le partage familial."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रोफ़ाइल पहले से ही अन्य Apple खाता से जुड़ा है. इसकी पहुँच का प्रबंधन परिवार साझा में करें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Pwofil sa a deja lye ak yon lòt Kont Apple. Manaje aksè li nan Partage Famille."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필은 이미 다른 Apple 계정에 연결되어 있습니다. 가족 공유에서 액세스를 관리할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil já está associado a outra Conta Apple. Gerencie o acesso dele no Compartilhamento Familiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот профиль уже связан с другой учетной записью Apple. Управляйте его доступом в семейном общем доступе."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile this ayaa horeyba loo xiray xisaab kale Apple. Maareeyaha helitaanka ee Family sharing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ này đã được kết nối với một Tài khoản Apple khác. Quản lý quyền truy cập của nó trong chia sẻ gia đình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此个人资料已关联到另一个 Apple 帐户。 在\"家人共享\"中管理其访问权限。"
          }
        }
      }
    },
    "This record belongs to a different family.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا السجل ينتمي إلى عائلة مختلفة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro pertenece a otra familia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این رکورد متعلق به یک خانواده دیگر است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang rekord na ito ay pag-aari ng isang iba't ibang pamilya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement appartient à une autre famille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक अलग परिवार से संबंधित है।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa a se yon dosye ki soti nan yon fanmi diferan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기록은 다른 가족에 속합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro pertence a uma família diferente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта запись относится к другой семье."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekorkan waxaa iska leh qoyska kale."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi này thuộc gia đình khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个记录属于另一个家族。"
          }
        }
      }
    },
    "This widget needs to refresh. Return to your widget and tap it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج هذا الودجت إلى تحديث. عُد إليه واضغط عليه مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este widget necesita actualizarse. Vuelve al widget y tócalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این Widget نیاز به بازآرایی دارد. به Widget خود برگردید و دوباره آن را فشار دهید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangang mag-refresh ang widget na ito. Bumalik sa iyong widget at i-tap muli ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce widget doit être actualisé. Revenez à votre widget et appuyez dessus à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस विजेट को ताज़ा करने की आवश्यकता है. अपने विजेट पर वापस जाएँ और इसे फिर से टैप करें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget sa a bezwen pou li refreche. Retounen nan widjet ou epi klike sou li ankò."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위젯은 새로 고침이 필요합니다. 위젯으로 돌아가서 다시 살짝 누르십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este widget precisa ser atualizado. Retorne ao seu widget e toque nele novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот виджет необходимо обновить. Вернитесь к своему виджету и нажмите его снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget-kan waa in la cusbooneysiiyaa. Ku noqo widget-kaaga oo ku taabso mar kale."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiện ích này cần làm mới. Quay lại tiện ích và chạm lần nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此小部件需要刷新。 返回到您的小部件并再次轻点它。"
          }
        }
      }
    },
    "This widget’s family is no longer available. Choose a child in Edit Widget.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عائلة هذا الودجت لم تعد متاحة. اختر طفلًا في «تحرير الودجت»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La familia de este widget ya no está disponible. Elige un bebé en Editar widget."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خانواده این Widget دیگر در دسترس نیست. یک فرزند را در ویرایش Widget انتخاب کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pamilya ng widget na ito ay hindi na magagamit. Pumili ng isang anak sa I-edit ang Widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La famille de ce widget n’est plus disponible. Choisissez un enfant dans Modifier le widget."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस विजेट का परिवार अब उपलब्ध नहीं है। विजेट संपादित करें में बच्चा चुनें।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanmi widget sa a pa disponib ankò. Chwazi yon pitit nan Edit Widget."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위젯의 가족을 더 이상 사용할 수 없습니다. 위젯 편집에서 아이를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A família deste widget não está mais disponível. Escolha um filho em Editar Widget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семья этого виджета больше недоступна. Выберите ребёнка в настройках виджета."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "qoyska Widget this waa ka dibna aan la heli karin. Dooro ilmo in Edit Widget."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gia đình liên kết với tiện ích này không còn khả dụng. Chọn một bé trong Sửa tiện ích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此小组件关联的家庭已不可用。请在“编辑小组件”中选择孩子。"
          }
        }
      }
    },
