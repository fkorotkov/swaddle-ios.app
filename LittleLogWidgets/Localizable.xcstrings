    },
    "A child’s last 24 hours. Tap volume to switch mL and ounces.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر 24 ساعة للطفل. اضغط على الكمية للتبديل بين mL والأونصات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las últimas 24 horas de tu bebé. Toca el volumen para cambiar entre mL y onzas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۲۴ ساعت گذشتهٔ کودک. برای تغییر بین mL و اونس، روی مقدار بزنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang huling 24 na oras ng isang bata. I-tap ang dami upang baguhin mL at ounces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dernières 24 heures d’un enfant. Touchez le volume pour changer de mL et d’onces."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बच्चे के पिछले 24 घंटे। mL और औंस बदलने के लिए मात्रा पर टैप करें।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "24 èdtan dènye yon timoun. Tap volim pou chanje mL ak ounces."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이의 지난 24시간 기록입니다. 수유량을 탭해 mL와 온스를 전환하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As últimas 24 horas de uma criança. Toque em volume para alternar entre ml e onças."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние 24 часа ребёнка. Нажмите на объём, чтобы переключиться между мл и унциями."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "24 saacadood ee ugu dambeeyay ee ilmaha. Taabo tirada si aad u beddesho ml iyo oz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "24 giờ qua của bé. Chạm vào lượng sữa để đổi giữa mL và ounce."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子过去24小时的记录。轻点奶量即可切换毫升和盎司。"
          }
        }
      }
    },
