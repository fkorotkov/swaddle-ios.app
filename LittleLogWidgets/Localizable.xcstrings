    "Left and right volumes must add up to the total.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ويجب أن تضاف الأحجام اليسرى واليمنى إلى المجموع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los volúmenes de ambos lados deben sumar el total."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموع مقدار چپ و راست باید برابر مقدار کل باشد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaliwa at kanang volume ay dapat magdagdag ng hanggang sa kabuuan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les volumes gauche et droit doivent s'ajouter au total."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाईं और दाईं मात्रा का जोड़ कुल मात्रा के बराबर होना चाहिए।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Volim gòch ak dwat dwe ajoute a total."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌우 유축량의 합은 총량과 같아야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os volumes esquerdo e direito devem somar-se ao total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма объёмов слева и справа должна совпадать с общим объёмом."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wadarta mugga bidix iyo midig waa inay la mid noqotaa wadarta guud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượng sữa bên trái và phải cộng lại phải bằng tổng lượng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右奶量相加必须等于总量。"
          }
        }
      }
    },
