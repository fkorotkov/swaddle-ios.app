    "Which child would you like to record this for?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي طفل تريد أن تسجل هذا له؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Para qué bebé quieres registrarlo?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این مورد را برای کدام کودک ثبت می‌کنید؟"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aling anak nais mong i-record ito para sa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour quel enfant aimeriez-vous enregistrer ceci ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किस बच्चे के लिए आप यह रिकॉर्ड करना चाहते हैं?"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Pou ki timoun ou vle enskri sa a?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 아이의 기록으로 저장할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para qual criança você gostaria de gravar isso?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для какого ребёнка вы бы хотели записать это?"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Maxay tahay carruurta aad rabto in aad u diiwaan gashan?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn lưu bản ghi này cho bé nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您想为哪个孩子保存这条记录？"
          }
        }
      }
    },
