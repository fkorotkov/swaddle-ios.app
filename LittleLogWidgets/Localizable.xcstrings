    "A birth date can’t be in the future.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تاريخ الميلاد لا يمكن أن يكون في المستقبل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de nacimiento no puede estar en el futuro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ تولد نمی‌تواند در آینده باشد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsa ng kapanganakan ay hindi maaaring sa hinaharap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une date de naissance ne peut pas être dans le futur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक जन्म तिथि भविष्य में नहीं हो सकती है।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Yon dat nesans pa ka nan tan kap vini an."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
