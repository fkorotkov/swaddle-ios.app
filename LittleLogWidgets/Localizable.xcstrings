            "value": "귀하의 가족이 아직도 로드 중입니다. 곧 다시 시도해 주십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua família ainda está carregando. Tente novamente em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша семья все еще загружается. Пожалуйста, попробуйте снова через несколько минут."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xogta qoyska weli waa la soo gelinayaa. Fadlan wax yar kadib isku day."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gia đình của bạn vẫn đang được tải. Xin hãy thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的家庭仍在加载中,请稍后再试。"
          }
        }
      }
    },
