    "Add a mother’s profile in Settings to log pumping.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ملفًا للأم في الإعدادات لتسجيل شفط الحليب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un perfil de extracción en Ajustes para registrar sesiones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ثبت دوشیدن شیر، پروفایل مادر را در تنظیمات اضافه کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng profile ng ina sa Mga Setting para magtala ng pag-pump."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un profil de mère dans Paramètres pour enregistrer l'expression du lait maternel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूध निकालना दर्ज करने के लिए सेटिंग्स में माँ की प्रोफ़ाइल जोड़ें।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute yon pwofil manman nan Paramèt pou anrejistre tire lèt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유축을 기록하려면 설정에서 엄마의 프로필을 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um perfil de mãe em Configurações para registrar a extração do leite materno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте профиль для сцеживаний в настройках."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejinta ku dar astaanta hooyada si aad u diiwaangeliso lisidda caanaha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm hồ sơ của mẹ trong Cài đặt để ghi lại việc hút sữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在\"设置\"中添加母亲的个人资料,以记录抽取母乳。"
          }
        }
      }
    },
