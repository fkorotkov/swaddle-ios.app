          "stringUnit": {
            "state": "translated",
            "value": "یک فرزند را در ویرایش Widget انتخاب کنید. اگر خانواده شما تغییر کرده باشد، برنامه را باز کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng isang bata sa I-edit ang Widget. Buksan ang app kung nagbago ang iyong pamilya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un enfant dans Modifier le widget. Ouvrez l’app si votre famille a changé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विजेट्स संपादित करने में एक बच्चे को चुनें. यदि आपका परिवार बदल गया है तो अनुप्रयोग खोलें."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Chwazi yon timoun nan Edit Widget. Ou ka louvri aplikasyon an si fanmi ou te chanje."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 편집에서 자녀를 선택합니다. 가족이 변경된 경우 앱을 여십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma criança em Editar Widget. Abra o aplicativo se sua família tiver mudado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите ребёнка в настройках виджета. Если состав семьи изменился, откройте приложение."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Dooro ilmo Edit Widget. Fur app haddii qoyskaagu uu isbedelay."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một đứa con trong Sửa Widget. Mở ứng dụng nếu gia đình của bạn đã thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在\"编辑小部件\"中选择一个孩子。 如果您的家庭发生了变化,请打开应用程序。"
          }
        }
      }
    },
    "Choose a feeding caregiver.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختار مقدم رعاية للتغذية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige quién dio la toma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "يه مراقب تغذيه انتخاب کن"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng isang tagapag-alaga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un soignant pour l'alimentation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूध पिलाने वाला देखभालकर्ता चुनें।"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Chwazi yon moun k ap bay tibebe a manje."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수유한 보호자를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um cuidador de alimentação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите участника, который кормил ребёнка."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Dooro daryeelaha quudinaya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn người đã cho bé bú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个喂养护理人员。"
          }
        }
      }
    },
    "Choose a time in the past or now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إختار وقتاً في الماضي أو الآن"
